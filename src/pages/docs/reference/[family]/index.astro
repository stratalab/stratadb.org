---
// A family as one page: every command stacked, with a rail to jump between
// them. Modelled on the Databricks utilities reference, which fits 40-odd
// commands on one page by keeping each entry light: a signature, a sentence and
// an example.
//
// Weight is the whole trick. Our per-command pages carry a parameters table, a
// return shape and up to a dozen error codes; stacking those would run 20
// screens for key-value and 45 for graph. So each entry here is the light form
// and links to its own page for the exhaustive detail. You get one page to scan
// and search across, without losing the deep pages an agent or a search result
// lands on.
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import CommandEntry from '../../../../components/docs/CommandEntry.astro';
import {
  FAMILY_TITLES,
  PUBLISHED_FAMILIES,
  commandsInFamily,
  groupTitle,
} from '../../../../lib/publishedCommands';
import index from '../../../../data/command-index.json';
import examples from '../../../../data/command-examples.json';
import bindings from '../../../../data/python-bindings.json';

export function getStaticPaths() {
  return PUBLISHED_FAMILIES.map((family) => ({ params: { family }, props: { family } }));
}

const { family } = Astro.props;
const title = FAMILY_TITLES[family] ?? family;
const commands = commandsInFamily(family);

const detail = new Map(index.commands.map((c) => [c.id, c]));
const example = examples as Record<string, { cli?: string }>;
const python = bindings as Record<string, { call: string; signature: string; example?: string[] }>;

// Group the same way the sidebar does, so the middle levels survive.
const direct = commands.filter((c) => c.segments.length === 1);
const grouped = new Map<string, typeof commands>();
for (const command of commands.filter((c) => c.segments.length > 1)) {
  grouped.set(command.segments[0], [...(grouped.get(command.segments[0]) ?? []), command]);
}

// The anchor is the command as the sidebar and the URL spell it, so
// /docs/reference/kv#batch_delete reads as the command it lands on. Segments
// are unique within a family, which is the only scope an anchor needs.
const anchor = (segments: string[]) => segments.join('-');

// Absent for a command the catalog ships no CLI path for; the band then offers
// Python only, or names the wire type if it has neither.
const cliPath = (id: string) => {
  const path = detail.get(id)?.cli?.path;
  return path?.length ? `strata ${path.join(' ')}` : undefined;
};

// The rail: groups at depth 2, commands at depth 3, exactly like the page.
const toc = [
  ...direct.map((c) => ({ depth: 2, slug: anchor(c.segments), text: c.op })),
  ...[...grouped.entries()].flatMap(([key, items]) => [
    { depth: 2, slug: `group-${key}`, text: groupTitle(key) },
    ...items.map((c) => ({ depth: 3, slug: anchor(c.segments), text: c.segments.join(' ') })),
  ]),
];
---

<DocsLayout
  title={`${title} commands`}
  description={`Every ${title} command in StrataDB, with its invocation and an example.`}
  section="Reference"
  wide
  toc={toc}
>
  <h1>{title} commands</h1>
  <p>
    {commands.length} commands. Each entry gives the invocation and an example, in the interface you pick;
    open the details for parameters, return shape and error codes.
  </p>

  {
    direct.map((command) => (
      <CommandEntry
        id={anchor(command.segments)}
        name={command.op}
        summary={command.summary}
        description={detail.get(command.id)?.description?.split('\n\n')[0]}
        href={command.docs}
        cli={cliPath(command.id)}
        wire={detail.get(command.id)?.wire}
        cliExample={example[command.id]?.cli}
        python={python[command.id]}
      />
    ))
  }

  {
    [...grouped.entries()].map(([key, items]) => (
      <div>
        <h2 id={`group-${key}`} class="not-prose mt-14 scroll-mt-24 text-heading text-ink-hi">
          {groupTitle(key)}
        </h2>
        {items.map((command) => (
          <CommandEntry
            id={anchor(command.segments)}
            name={command.segments.join(' ')}
            level={3}
            summary={command.summary}
            description={detail.get(command.id)?.description?.split('\n\n')[0]}
            href={command.docs}
            cli={cliPath(command.id)}
            wire={detail.get(command.id)?.wire}
            cliExample={example[command.id]?.cli}
            python={python[command.id]}
          />
        ))}
      </div>
    ))
  }
</DocsLayout>

<script>
  // One choice drives every command on the page, and it is the same key the
  // per-command pages use, so picking Python once holds across the reference.
  //
  // Each band resolves the choice for itself: a handful of commands have no
  // Python binding, and those fall back to the CLI rather than hiding
  // everything they have.
  const KEY = 'strata.docs.interface';
  const entries = [...document.querySelectorAll<HTMLElement>('[data-command-entry]')];

  function apply(iface: string) {
    for (const entry of entries) {
      const tabs = [...entry.querySelectorAll<HTMLButtonElement>('[data-iface-tab]')];
      const panels = [...entry.querySelectorAll<HTMLElement>('[data-iface-panel]')];
      // Fall back to whatever this band does have, not to the CLI: a command
      // the catalog ships no CLI path for offers Python only.
      const fallback = panels[0]?.dataset.ifacePanel;
      const shown = panels.some((p) => p.dataset.ifacePanel === iface) ? iface : fallback;
      for (const tab of tabs) {
        const on = tab.dataset.ifaceTab === shown;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      for (const panel of panels) panel.hidden = panel.dataset.ifacePanel !== shown;
    }
  }

  function choose(iface: string) {
    apply(iface);
    try {
      localStorage.setItem(KEY, iface);
    } catch {
      /* private browsing */
    }
  }

  for (const entry of entries) {
    const tabs = [...entry.querySelectorAll<HTMLButtonElement>('[data-iface-tab]')];
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => choose(tab.dataset.ifaceTab ?? 'cli'));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        next.focus();
        choose(next.dataset.ifaceTab ?? 'cli');
      });
    });
  }

  try {
    const saved = localStorage.getItem(KEY);
    if (saved === 'python' || saved === 'cli') apply(saved);
  } catch {
    /* private browsing */
  }
</script>
