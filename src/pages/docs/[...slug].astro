---
// Prose pages, rendered from the docs collection.
//
// `/docs` itself is the designed landing at pages/docs/index.astro, and the
// generated reference has its own routes under pages/docs/reference. This
// handles everything written by hand.
//
// Section comes from frontmatter so the sidebar opens where the reader landed,
// and the rail is built from the page's own headings rather than a list kept
// beside it.
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\/index$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id.replace(/\/index$/, '');
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  mdHref={`/docs/${slug}.md`}
  toc={headings.filter((h) => h.depth === 2 || h.depth === 3)}
>
  {
    /* The generated reference pages have always titled themselves; these
      hand-written ones did not, so the prose section was the only part of the
      docs whose heading hierarchy started at h2. The markdown twin emitted
      `# Title` the whole time, which meant agents got a title and readers did
      not. Bare h1, styled by prose-docs, exactly as the reference pages do. */
  }
  <h1>{entry.data.title}</h1>
  <Content />
</DocsLayout>
