---
// ALTERNATIVE: the docs landing as the industry leaders build it.
//
// Modelled on what DuckDB, ClickHouse, Snowflake, Databricks and MongoDB
// actually do, rather than on our own editorial instinct:
//
//   1. Search dominates the hero. Nothing competes with it.
//   2. A shared "Get started" row comes first, never per-interface. Five of the
//      six sites lead with it.
//   3. The rest mirrors the eventual sidebar as one uniform card grid, on the
//      spine those sites converge on: Get started, Learn, Guides, Develop,
//      Reference, Release notes.
//   4. Interface lives inside Develop as one section, the way Snowflake's
//      "Developer" and Databricks' "Develop" hold every programmatic surface.
//   5. Generated reference stays one tree. No site forks it per interface.
//
// Dropped on purpose, so the comparison is honest: the hero artifact, the
// standalone install band, the standalone interfaces band. Not shown because we
// lack the feature: the AI ask box five of the six now put beside search.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSearch from '../../components/chrome/DocsSearch.astro';
import TryItOut from '../../components/docs/TryItOut.astro';
import InstallBand from '../../components/docs/InstallBand.astro';
import HeroArtifact from '../../components/docs/HeroArtifact.astro';

interface Item {
  label: string;
  href: string;
  ready?: boolean;
  external?: boolean;
}

const startHere = [
  {
    title: 'Install',
    desc: 'One binary, Homebrew, or the Python package.',
    href: '/docs/get-started/installation',
  },
  {
    title: 'Quickstart',
    desc: 'Write, fork, compare and merge in about five minutes.',
    href: '/docs/get-started/quickstart',
  },
  {
    title: 'Run it in your browser',
    desc: 'A real database, with nothing to install.',
    href: '/playground',
    ready: true,
  },
];

const sections: { title: string; desc: string; items: Item[] }[] = [
  {
    title: 'Learn',
    desc: 'The model underneath, and why it is shaped this way.',
    items: [
      { label: 'Branches', href: '/docs/learn/how-it-works/branches' },
      { label: 'Working with data', href: '/docs/learn/data' },
      { label: 'Time travel', href: '/docs/learn/how-it-works/time-travel' },
      { label: 'Inference', href: '/docs/learn/inference' },
    ],
  },
  {
    title: 'Guides',
    desc: 'Task-shaped, from a goal to a working result.',
    items: [
      { label: 'Agent applications', href: '/docs/guides/agents' },
      { label: 'Semantic search', href: '/docs/guides/ai-retrieval/build-semantic-search' },
      { label: 'Retrieval augmented generation', href: '/docs/guides/ai-retrieval/build-rag' },
      { label: 'Local models', href: '/docs/guides/ai-retrieval/use-local-models' },
    ],
  },
  {
    title: 'Develop',
    desc: 'Build against the interface you actually use.',
    items: [
      { label: 'Python', href: '/docs/sdks/python' },
      { label: 'CLI', href: '/docs/sdks/cli' },
      { label: 'AI agents', href: '/docs/sdks/agents' },
      { label: 'MCP', href: '/docs/sdks/mcp' },
    ],
  },
  {
    title: 'Reference',
    desc: 'Exact syntax, parameters, returns and failures.',
    items: [
      { label: 'Commands', href: '/docs/reference' },
      { label: 'Error codes', href: '/e/', ready: true },
      { label: 'Configuration', href: '/docs/reference/configuration' },
      { label: 'Data types', href: '/docs/reference/data-types' },
    ],
  },
];
---

<BaseLayout
  title="Documentation | StrataDB"
  description="StrataDB documentation: get started, learn the branching model, follow task guides, pick your interface, and look up exact command behavior."
>
  <div class="relative">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[34rem]"
      style="background: radial-gradient(52% 44% at 50% 0%, rgb(var(--rgb-terracotta-500) / 0.10), transparent 72%);"
    >
    </div>

    <div class="relative mx-auto w-full max-w-[70rem] px-6 py-16 max-[480px]:px-4">
      <!-- Search-dominant hero. Nothing competes with the field. -->
      <header class="mx-auto max-w-[44rem] text-center">
        <h1 class="text-title font-semibold text-ink-hi">Documentation</h1>
        <p class="mt-4 text-heading font-normal text-ink-hi">
          Explore our guides and examples to build with Strata.
        </p>
        <button
          type="button"
          class="docs-search-trigger mt-8 flex w-full items-center gap-3 rounded-(--radius-card) border border-line-hover bg-elevated px-5 py-4 text-left text-body-lg text-ink-hi transition-colors duration-200 hover:border-terracotta-500 focus-visible:border-terracotta-500 focus-visible:outline-none"
          aria-label="Search the documentation"
        >
          <svg
            class="h-5 w-5 shrink-0 text-terracotta-500"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" d="M21 21l-4.3-4.3"></path>
          </svg>
          <span>Search the docs</span>
          <kbd
            class="ml-auto rounded border border-line-hover px-2 py-0.5 font-mono text-mono-body text-ink-hi"
            >/</kbd
          >
        </button>
      </header>

      <!-- The product in one picture, before the reader has to choose anything -->
      <div class="mt-12">
        <HeroArtifact />
      </div>

      <!-- Get started: shared, first, never per-interface -->
      <section class="mt-14" aria-label="Get started">
        <h2 class="text-small font-medium uppercase text-ink-mid">Get started</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {
            startHere.map((card) =>
              card.ready ? (
                <a
                  href={card.href}
                  class="rounded-(--radius-card) border border-line bg-raised p-6 transition-colors duration-200 hover:border-terracotta-500 hover:bg-elevated"
                >
                  <h3 class="text-heading text-ink-hi">{card.title}</h3>
                  <p class="mt-2 text-body text-ink-mid">{card.desc}</p>
                </a>
              ) : (
                <div class="rounded-(--radius-card) border border-line bg-raised p-6">
                  <h3 class="text-heading text-ink-mid">{card.title}</h3>
                  <p class="mt-2 text-body text-ink-mid">{card.desc}</p>
                </div>
              ),
            )
          }
        </div>
      </section>

      <InstallBand />

      <!-- Show it working before asking the reader to browse -->
      <TryItOut />

      <!-- The sidebar, mirrored as cards -->
      <section class="mt-14" aria-label="Browse the documentation">
        <h2 class="text-small font-medium uppercase text-ink-mid">Browse the documentation</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {
            sections.map((section) => (
              <div class="rounded-(--radius-card) border border-line bg-raised p-6 transition-colors duration-200 hover:border-line-hover hover:bg-elevated">
                <h3 class="text-heading text-ink-hi">{section.title}</h3>
                <p class="mt-2 text-body text-ink-mid">{section.desc}</p>
                <ul class="mt-4 space-y-2.5">
                  {section.items.map((item) => (
                    <li>
                      {item.ready ? (
                        <a
                          href={item.href}
                          target={item.external ? '_blank' : undefined}
                          rel={item.external ? 'noopener noreferrer' : undefined}
                          class="text-body text-ink-hi underline decoration-line underline-offset-4 transition-colors duration-200 hover:decoration-terracotta-500"
                        >
                          {item.label}
                        </a>
                      ) : (
                        <span class="text-body text-ink-mid">{item.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-14 border-t border-line pt-6" aria-label="For machines">
        <p class="font-mono text-mono-body text-ink-mid">
          agents: <a href="/llms.txt" class="text-ink-hi hover:text-terracotta-400">llms.txt</a>
          · <a href="/llms-full.txt" class="text-ink-hi hover:text-terracotta-400">llms-full.txt</a>
          · <a href="/e/" class="text-ink-hi hover:text-terracotta-400">error registry</a>
          · <span class="text-ink-hi">strata agents commands --json</span>
        </p>
      </section>
    </div>
  </div>
  <DocsSearch />
</BaseLayout>
