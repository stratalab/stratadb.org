---
// The docs front door: task paths first, generated reference close behind.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSearch from '../../components/chrome/DocsSearch.astro';

const start = [
  {
    title: 'Install',
    desc: 'Get the `strata` binary and check it with one command.',
    href: '/docs/getting-started/installation',
    cta: 'strata --cache ping',
  },
  {
    title: 'First database',
    desc: 'Write data, fork a branch, merge it, and read the past.',
    href: '/docs/getting-started/first-database',
    cta: 'strata ./mydb kv put portfolio.value 98400',
  },
  {
    title: 'Agent setup',
    desc: 'Use the self-describing binary or the built-in MCP server.',
    href: '/docs/agents',
    cta: 'strata ./mydb mcp serve',
  },
];

const primitives = [
  {
    title: 'Key-value',
    desc: 'Opaque values by key, versioned.',
    href: '/docs/data/key-value',
    hue: 'var(--color-strata-kv)',
  },
  {
    title: 'JSON documents',
    desc: 'Read and write inside documents by path.',
    href: '/docs/data/json',
    hue: 'var(--color-strata-json)',
  },
  {
    title: 'Events',
    desc: 'Append-only, hash-chained history.',
    href: '/docs/data/events',
    hue: 'var(--color-strata-event)',
  },
  {
    title: 'Vectors',
    desc: 'Similarity search with metadata filters.',
    href: '/docs/data/vectors',
    hue: 'var(--color-strata-vector)',
  },
  {
    title: 'Graph',
    desc: 'Nodes, edges, analytics, and an ontology.',
    href: '/docs/data/graph',
    hue: 'var(--color-strata-graph)',
  },
  {
    title: 'Combining primitives',
    desc: 'Use several shapes against one commit clock.',
    href: '/docs/data/combining-primitives',
    hue: 'var(--color-terracotta-500)',
  },
];

const sections = [
  { title: 'Why Strata', desc: 'Fit, boundaries, and comparisons.', href: '/docs/why-strata' },
  {
    title: 'Concepts',
    desc: 'Branches, commits, time travel, durability.',
    href: '/docs/concepts',
  },
  {
    title: 'Working with Data',
    desc: 'Choose KV, JSON, events, vectors, graph, or a combination.',
    href: '/docs/data',
  },
  {
    title: 'Inference',
    desc: 'Generation, embedding, ranking, and tokenization.',
    href: '/docs/inference',
  },
  { title: 'Guides', desc: 'Cross-cutting workflows and operating tasks.', href: '/docs/guides' },
  { title: 'Python SDK', desc: 'Open StrataDB inside a Python process.', href: '/docs/python' },
  {
    title: 'Reference',
    desc: 'Generated command facts, errors, values, and CLI rules.',
    href: '/docs/reference',
  },
  {
    title: 'Architecture',
    desc: 'The internals: layers, storage, durability, and capabilities.',
    href: '/architecture',
  },
  {
    title: 'Troubleshooting',
    desc: 'Failure modes and the codes they carry.',
    href: '/docs/troubleshooting',
  },
];

const transcript = [
  {
    cmd: 'strata ./demo kv put portfolio.value 98400',
    out: ['created portfolio.value applied=true'],
  },
  {
    cmd: 'strata ./demo branch fork default risky',
    out: ['{ "name": "risky", "parent": { "name": "default" }, "...": "receipt abridged" }'],
  },
  {
    cmd: 'strata ./demo --branch risky kv put portfolio.value 111080',
    out: ['updated portfolio.value applied=true'],
  },
  { cmd: 'strata ./demo --branch default kv get portfolio.value', out: ['98400'] },
  {
    cmd: 'strata ./demo branch preview risky default',
    out: ['{ "conflicts": [], "strategy": "strict", "...": "receipt abridged" }'],
  },
];
---

<BaseLayout
  title="Documentation — StrataDB"
  description="StrataDB documentation: install the embedded database, fork branches, use five data shapes, and look up generated command reference."
>
  <div class="mx-auto w-full max-w-[70rem] px-6 py-16 max-[480px]:px-4">
    <!-- Hero: title, claim, search as the front door -->
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="text-title font-semibold text-ink-hi">Build with a database you can fork.</h1>
      <p class="mt-4 text-body-lg text-ink-mid">
        Install the binary, write a value, fork the database, and keep the exact command reference
        close by. Narrative pages explain the model; generated pages own exhaustive syntax.
      </p>
      <button
        type="button"
        class="docs-search-trigger mt-8 flex w-full items-center gap-3 rounded-(--radius-card) border border-line bg-panel px-5 py-3.5 text-left text-body text-ink-low transition-colors duration-200 hover:border-line-hover hover:text-ink-mid"
        aria-label="Search docs"
      >
        <svg
          class="h-4 w-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path stroke-linecap="round" d="M21 21l-4.3-4.3"></path>
        </svg>
        <span>Search the docs…</span>
        <kbd class="ml-auto rounded border border-line px-2 py-0.5 font-mono text-mono-sm">/</kbd>
      </button>
    </header>

    <!-- Start here: the do row -->
    <section class="mt-16" aria-label="Start here">
      <div class="grid gap-4 md:grid-cols-3">
        {
          start.map((card) => (
            <a
              href={card.href}
              class="group min-w-0 overflow-hidden rounded-(--radius-card) border border-line bg-panel p-6 transition-colors duration-200 hover:border-line-hover"
            >
              <h2 class="text-body font-semibold text-ink-hi">{card.title}</h2>
              <p class="mt-2 text-small text-ink-mid">{card.desc}</p>
              <p class="mt-4 truncate font-mono text-mono-sm text-ink-low transition-colors duration-200 group-hover:text-terracotta-500">
                {card.cta}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- The proof strip: a concise fork path, aligned with the homepage gate. -->
    <section class="mt-16" aria-label="Try it">
      <div
        class="grid overflow-hidden rounded-(--radius-frame) border border-line lg:grid-cols-[1fr_16rem]"
      >
        <div class="bg-inset p-6 font-mono text-mono-sm leading-relaxed">
          {
            transcript.map((step) => (
              <div class="mb-1.5">
                <p class="text-ink-mid">
                  <span class="select-none text-ink-low">$ </span>
                  {step.cmd.includes('risky') ? (
                    <Fragment>
                      {step.cmd.split('risky').map((part, i, arr) => (
                        <Fragment>
                          {part}
                          {i < arr.length - 1 && <span class="text-terracotta-500">risky</span>}
                        </Fragment>
                      ))}
                    </Fragment>
                  ) : (
                    step.cmd
                  )}
                </p>
                {step.out.map((line) => (
                  <p class="text-ink-low">{line}</p>
                ))}
              </div>
            ))
          }
        </div>
        <div
          class="flex flex-col justify-center gap-3 border-t border-line bg-panel p-6 lg:border-l lg:border-t-0"
        >
          <h2 class="text-body font-semibold text-ink-hi">Forks are ordinary workflow</h2>
          <p class="text-small text-ink-mid">
            The homepage transcript gate replays this path against the shipped CLI. Long receipts
            are abridged here; the browser playground lets you try the same model without installing
            first.
          </p>
          <a
            href="/playground"
            class="mt-1 font-mono text-mono-sm text-terracotta-500 transition-colors duration-200 hover:text-terracotta-400"
          >
            Run it in your browser →
          </a>
        </div>
      </div>
    </section>

    <!-- Working with data: the primitives, wearing their hues -->
    <section class="mt-16" aria-label="Working with data">
      <h2 class="text-eyebrow font-medium uppercase text-ink-low">Working with data</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          primitives.map((card) => (
            <a
              href={card.href}
              class="group rounded-(--radius-card) border border-line bg-panel p-5 transition-colors duration-200 hover:border-line-hover"
              style={`border-left: 2px solid ${card.hue}`}
            >
              <h3 class="text-body font-semibold text-ink-hi">{card.title}</h3>
              <p class="mt-1.5 text-small text-ink-mid">{card.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Everything else -->
    <section class="mt-16" aria-label="All sections">
      <h2 class="text-eyebrow font-medium uppercase text-ink-low">Browse the docs</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          sections.map((card) => (
            <a
              href={card.href}
              class="group rounded-(--radius-card) border border-line p-5 transition-colors duration-200 hover:border-line-hover hover:bg-panel"
            >
              <h3 class="text-body font-semibold text-ink-hi">{card.title}</h3>
              <p class="mt-1.5 text-small text-ink-mid">{card.desc}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- The machine surface, quiet and mono -->
    <section
      class="mt-16 rounded-(--radius-card) border border-line bg-panel px-6 py-5"
      aria-label="For machines"
    >
      <p class="font-mono text-mono-sm text-ink-low">
        agents: <a href="/llms.txt" class="text-ink-mid hover:text-ink-hi">llms.txt</a>
        · <a href="/llms-full.txt" class="text-ink-mid hover:text-ink-hi">llms-full.txt</a>
        · append <span class="text-ink-mid">.md</span> to any docs URL for CommonMark · <a
          href="/e/"
          class="text-ink-mid hover:text-ink-hi">/e/ error registry</a
        >
        · <a href="/docs/agents" class="text-ink-mid hover:text-ink-hi">the full agent surface →</a>
      </p>
    </section>
  </div>
  <DocsSearch />
</BaseLayout>
