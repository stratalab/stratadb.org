---
import ResourcesLayout from '../../layouts/ResourcesLayout.astro';

const live = [
  {
    type: 'Interactive',
    title: 'Strata Colonies',
    copy: 'Change a cell, revisit a colony’s past, and fork another future. A real StrataDB database runs in your browser.',
    href: '/demos/colonies/',
  },
  {
    type: 'Interactive',
    title: 'Strata KSP',
    copy: 'Build a rocket, fly it, and try again. Every attempt is kept and reverting costs nothing, because each one is a branch of a real database running in the tab.',
    href: '/demos/ksp/',
  },
  {
    type: 'Interactive',
    title: 'Browser playground',
    copy: 'Use StrataDB in the browser and run the branch workflow immediately.',
    href: '/playground',
  },
  {
    type: 'Datasets',
    title: 'Strata Hub',
    copy: 'Browse prepared databases and clone datasets for experiments.',
    href: '/hub',
  },
  {
    type: 'Install',
    title: 'Local setup',
    copy: 'Install Strata and run the same workflows against a local directory.',
    href: '/#install',
  },
];

// Apps you clone and run, because they need something a page cannot give
// them. KSP used to be here: strata-core issue 3536 was what stopped a Rust
// app on the typed API reaching the browser, and 1.2.4 fixed it, so KSP now
// compiles to WebAssembly and is listed above. Island stays because it is
// pre-populated with a dataset rather than blocked on the engine.
const source = [
  {
    type: 'Rust app',
    title: 'Strata Island',
    copy: 'A Manhattan drive map. Close a street on a branch, then compare the route the city still takes against the one you forced.',
    href: 'https://github.com/stratalab/strata-apps/tree/main/strata-island',
  },
];

const videos = [
  {
    title: 'Branching a database',
    copy: 'Fork, write, diff, preview, and merge without copying the database directory.',
  },
  {
    title: 'Cloning from Hub',
    copy: 'Pick a prepared dataset, run strata clone, and start querying the local database.',
  },
  {
    title: 'Agent setup',
    copy: 'Expose StrataDB through MCP and inspect the generated command catalog.',
  },
];
---

<ResourcesLayout
  title="Demos"
  description="Interactive demos are live today. Video walkthroughs will be linked here when they are published on YouTube."
  activeSlug="demos"
>
  <section class="resource-section" aria-labelledby="demos-live">
    <h2 id="demos-live">Live demos</h2>
    <div class="resource-list">
      {
        live.map((item) => (
          <a href={item.href} class="resource-row">
            <span class="resource-type">{item.type}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
            <strong aria-hidden="true">&rarr;</strong>
          </a>
        ))
      }
    </div>
  </section>

  <section class="resource-section" aria-labelledby="demos-source">
    <h2 id="demos-source">Run it yourself</h2>
    <p>
      This one drives a real database from a Rust process and serves its own interface, so you clone
      and run it rather than opening a page. It builds against the published engine tag with nothing
      else on disk.
    </p>
    <div class="resource-list">
      {
        source.map((item) => (
          <a href={item.href} class="resource-row" target="_blank" rel="noopener noreferrer">
            <span class="resource-type">{item.type}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
            <strong aria-hidden="true">&rarr;</strong>
          </a>
        ))
      }
    </div>
  </section>

  <section class="resource-section" aria-labelledby="video-library">
    <h2 id="video-library">Video library</h2>
    <p>No public videos are linked yet. YouTube embeds will live here once they ship.</p>
    <div class="resource-grid">
      {
        videos.map((item) => (
          <article class="resource-note">
            <span>Planned</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))
      }
    </div>
  </section>
</ResourcesLayout>
