---
// The landing page, v2 (Doc 04). Sections arrive by build phase:
// Phase 2: hero · Phase 3: branching, primitives, time travel · Phase 4: the rest.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Branching from '../components/sections/Branching.astro';
import StrataColumn from '../components/sections/StrataColumn.astro';
import TimeTravel from '../components/sections/TimeTravel.astro';
import Inference from '../components/sections/Inference.astro';
import Hub from '../components/sections/Hub.astro';
import InstallClose from '../components/sections/InstallClose.astro';
import release from '../data/release.json';
// Platforms come from the release assets, never from a literal: this line read
// 'macOS, Linux, Windows' while the release shipped no Windows binary.
import { operatingSystems } from '../lib/platforms';
import { softwareApplication, ORG_ATTRIBUTION } from '../lib/organization';
---

<BaseLayout
  title="StrataDB: an embedded database with git semantics"
  description={`StrataDB is an embedded database with git-style semantics: zero-copy branches, merge preview, versioned reads, five data models, built-in inference, and one-command dataset clones from Strata Hub. ${ORG_ATTRIBUTION}`}
>
  <Hero />
  <Branching />
  <StrataColumn />
  <TimeTravel />
  <Inference />
  <Hub />
  <InstallClose />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      ...softwareApplication({
        description:
          'An embedded database with git-style semantics: five data models, branch diff, merge preview, time-travel reads, built-in inference, and prepared dataset clones through Strata Hub.',
        operatingSystem: operatingSystems()
          .map((os) => os.label)
          .join(', '),
        license: 'https://www.apache.org/licenses/LICENSE-2.0',
        softwareVersion: release.version,
      }),
    })}
  />
</BaseLayout>
