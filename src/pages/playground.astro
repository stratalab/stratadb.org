---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Strata Playground"
  description="A real Strata database, running in your browser."
>
  <section class="pg-root">
    <header class="pg-head">
      <h1>Playground</h1>
      <p>A real Strata database, running in your browser.</p>
    </header>

    <div class="pg-term">
      <div class="pg-log" id="pg-log"><div id="pg-boot">Loading the Strata engine…</div></div>
      <form class="pg-prompt" id="pg-form" hidden>
        <span class="pg-caret" id="pg-caret">strata&nbsp;›</span>
        <input
          id="pg-input"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="Strata command"
        />
      </form>
    </div>

    <div class="pg-chips" id="pg-chips" hidden>
      <span class="pg-try">try</span>
      <button type="button" data-fill="kv put greeting hello">kv put</button>
      <button type="button" data-fill="branch fork default experiment">branch fork</button>
      <button type="button" data-fill="use experiment">use experiment</button>
      <button type="button" data-fill="branch merge experiment default">branch merge</button>
      <button type="button" data-fill="help">help</button>
      <button type="button" class="pg-reset" id="pg-reset">reset</button>
    </div>

    <p class="pg-foot">
      Close the tab and it's gone. <a href="/docs/getting-started">Install Strata</a> to keep your data.
    </p>
  </section>

  <script type="module" is:inline>
    const PKG = '/playground/pkg/strata_wasm.js';
    const log = document.getElementById('pg-log');
    const caret = document.getElementById('pg-caret');
    let session;
    let engineVersion;
    let StrataSession;
    let curBranch = 'default';
    let curSpace = 'default';
    const history = [];
    let historyAt = -1;

    // The sticky prompt: `strata:<branch>/<space> ›`, like the real CLI REPL.
    function promptText() {
      return `strata:${curBranch}/${curSpace} ›`;
    }
    function syncScope() {
      curBranch = session.branch;
      curSpace = session.space;
      caret.textContent = promptText();
    }

    function el(tag, cls, text) {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined) node.textContent = text;
      return node;
    }
    function scroll() {
      log.scrollTop = log.scrollHeight;
    }
    // A muted line of prose (welcome / notes).
    function note(text) {
      log.appendChild(el('div', 'pg-note', text));
      scroll();
    }
    // Echo the typed command, then its output (or error text), as a shell transcript.
    // Echo the typed line under the prompt it ran at.
    function echoLine(line) {
      const entry = el('div', 'pg-entry');
      const echo = el('div', 'pg-echo');
      echo.appendChild(el('span', 'pg-echo-caret', promptText() + ' '));
      echo.appendChild(el('span', 'pg-echo-cmd', line));
      entry.appendChild(echo);
      return entry;
    }
    function appendOut(entry, text, isError) {
      const trimmed = text.replace(/\s+$/, '');
      if (trimmed.length > 0) {
        entry.appendChild(el('pre', isError ? 'pg-out pg-out-err' : 'pg-out', trimmed));
      }
      log.appendChild(entry);
      scroll();
    }

    // `use <branch> [<space>]` is a REPL meta-command (not part of the one-shot
    // CLI): it switches the sticky branch/space, mirrored in the prompt.
    function handleUse(entry, args) {
      if (args.length === 0) {
        appendOut(entry, `on ${curBranch}`, false);
        return;
      }
      try {
        session.setBranch(args[0]);
        if (args[1]) session.setSpace(args[1]);
        syncScope();
        appendOut(entry, `now on ${curBranch}`, false);
      } catch (error) {
        appendOut(entry, String(error?.message ?? error), true);
      }
    }

    function handleLine(line) {
      const entry = echoLine(line);
      const parts = line.split(/\s+/);
      if (parts[0] === 'use') {
        handleUse(entry, parts.slice(1));
        return;
      }
      if (parts[0] === 'clear') {
        log.textContent = '';
        return;
      }
      let output = '';
      try {
        output = session.executeCli(line);
      } catch (error) {
        output = String(error?.message ?? error);
      }
      const looksError = /^error[: ]|is not available|needs a host|could not parse/i.test(output.trim());
      appendOut(entry, output, looksError);
      // A command may have created/switched context indirectly; keep the prompt honest.
      syncScope();
    }

    function openSession() {
      session = new StrataSession();
      syncScope();
    }

    async function boot() {
      let mod;
      try {
        mod = await import(PKG);
        await mod.default();
      } catch (error) {
        document.getElementById('pg-boot').textContent =
          'Could not load the Strata engine: ' + (error?.message ?? error);
        return;
      }
      StrataSession = mod.StrataSession;
      engineVersion = mod.engineVersion;
      openSession();
      document.getElementById('pg-boot').remove();
      document.getElementById('pg-form').hidden = false;
      document.getElementById('pg-chips').hidden = false;

      note(`Strata ${engineVersion()}. Type a command, or pick one below.`);

      const input = document.getElementById('pg-input');
      const focusInput = () => input.focus();

      document.getElementById('pg-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const line = input.value.trim();
        if (!line) return;
        history.push(line);
        historyAt = history.length;
        input.value = '';
        handleLine(line);
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowUp' && historyAt > 0) {
          historyAt--;
          input.value = history[historyAt];
          event.preventDefault();
        } else if (event.key === 'ArrowDown') {
          if (historyAt < history.length - 1) {
            historyAt++;
            input.value = history[historyAt];
          } else {
            historyAt = history.length;
            input.value = '';
          }
          event.preventDefault();
        }
      });

      document.getElementById('pg-chips').addEventListener('click', (event) => {
        const button = event.target.closest('button');
        if (!button) return;
        if (button.id === 'pg-reset') {
          try { session.close(); } catch { /* already closed */ }
          session.free?.();
          openSession();
          log.textContent = '';
          note(`Fresh session. The previous database is gone.`);
          focusInput();
          return;
        }
        input.value = button.dataset.fill;
        focusInput();
      });

      // Clicking anywhere in the transcript focuses the prompt, like a terminal.
      document.querySelector('.pg-term').addEventListener('click', focusInput);
      focusInput();
    }

    boot();
  </script>

  <style is:global>
    .pg-root { max-width: 52rem; margin: 0 auto; padding: 3.5rem 1.25rem 4rem; }
    .pg-head { text-align: center; margin-bottom: 1.75rem; }
    .pg-head h1 { font-size: 2.25rem; font-weight: 700; margin: 0 0 0.75rem; color: var(--color-ink-hi, #f4f2ee); }
    .pg-head p { color: var(--color-ink-mid, #b9b4ab); line-height: 1.65; margin: 0 auto; max-width: 40rem; }
    .pg-head code { font-family: var(--font-mono, ui-monospace, monospace); color: var(--color-terracotta-400, #e07a5f); font-size: 0.92em; }

    /* One calm terminal. */
    .pg-term {
      border: 1px solid var(--color-line, #2a2724);
      border-radius: 12px;
      background: var(--color-panel, #14110f);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 60vh;
      min-height: 24rem;
      max-height: 40rem;
    }
    .pg-log { flex: 1; overflow-y: auto; padding: 1.1rem 1.25rem; font-size: 0.85rem; line-height: 1.5; }
    #pg-boot { color: var(--color-ink-low, #857f76); padding: 1.5rem 0; }
    .pg-note { color: var(--color-ink-low, #857f76); margin-bottom: 0.9rem; }
    .pg-note code { font-family: var(--font-mono, ui-monospace, monospace); color: var(--color-ink-mid, #b9b4ab); }
    .pg-entry { margin-bottom: 0.85rem; }
    .pg-echo { font-family: var(--font-mono, ui-monospace, monospace); }
    .pg-echo-caret { color: var(--color-terracotta-400, #e07a5f); }
    .pg-echo-cmd { color: var(--color-ink-hi, #f4f2ee); }
    .pg-out {
      margin: 0.3rem 0 0;
      font-family: var(--font-mono, ui-monospace, monospace);
      color: var(--color-ink-mid, #b9b4ab);
      white-space: pre-wrap;
      word-break: break-word;
      overflow-x: auto;
    }
    .pg-out-err { color: #fca5a5; }

    .pg-prompt {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.25rem;
      border-top: 1px solid var(--color-line, #2a2724);
      background: color-mix(in srgb, var(--color-panel, #14110f) 92%, #fff 8%);
    }
    .pg-caret { font-family: var(--font-mono, ui-monospace, monospace); color: var(--color-terracotta-400, #e07a5f); white-space: nowrap; }
    .pg-prompt input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-ink-hi, #f4f2ee);
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.88rem;
    }

    .pg-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem; }
    .pg-try { color: var(--color-ink-low, #857f76); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-right: 0.15rem; }
    .pg-chips button {
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.8rem;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--color-line, #2a2724);
      background: var(--color-raised, #1a1714);
      color: var(--color-ink-mid, #b9b4ab);
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .pg-chips button:hover { border-color: var(--color-terracotta-400, #e07a5f); color: var(--color-ink-hi, #f4f2ee); }
    .pg-chips .pg-reset { margin-left: auto; }
    .pg-chips .pg-reset:hover { border-color: #f87171; color: #fca5a5; }

    .pg-foot { text-align: center; margin-top: 1.5rem; color: var(--color-ink-low, #857f76); font-size: 0.85rem; }
    .pg-foot a { color: var(--color-terracotta-400, #e07a5f); text-decoration: none; }
    .pg-foot a:hover { text-decoration: underline; }

    @media (max-width: 640px) {
      .pg-term { height: 66vh; }
    }
  </style>
</BaseLayout>
