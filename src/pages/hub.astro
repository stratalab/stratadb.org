---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/foundation/Eyebrow.astro';
import Heading from '../components/foundation/Heading.astro';
import CopyChip from '../components/foundation/CopyChip.astro';
import catalog from '../data/hub-catalog.json';

interface HubDataset {
  slug: string;
  title: string;
  description: string;
  tasks: string[];
  tags: string[];
  license: string;
  size_category: string;
  size_bytes?: number;
  downloads?: number;
  last_updated?: string;
  primitives: string[];
  branches: string[];
  includes: { primitive: string; detail: string }[];
  quickstart: string[];
}

const datasets = catalog.datasets as HubDataset[];
if (!datasets.length) throw new Error('Hub catalog is empty.');

const hubHost = catalog.hub.replace(/^https?:\/\//, '').replace(/\/$/, '');
const featuredDataset = datasets.find((d) => d.slug === 'movielens-100k') ?? datasets[0];
const primitiveOrder = ['kv', 'json', 'events', 'vectors', 'graph'];
const primitiveLabels: Record<string, string> = {
  kv: 'KV',
  json: 'JSON',
  events: 'Events',
  vectors: 'Vectors',
  graph: 'Graph',
};
const shortDescriptions: Record<string, string> = {
  titanic: 'Passenger records with raw and cleaned branches for classification demos.',
  'ab-test-results': 'A deterministic A/B test with each experiment arm on its own branch.',
  'iana-http-reference': 'HTTP status codes, methods, and headers as local lookup data.',
  'agent-memory-with-experiments': 'Synthetic agent memory with retention-policy branches.',
  'github-events': 'Developer activity stored as append-only event streams.',
  iris: 'Fisher iris measurements with curation history included.',
  'iso-reference': 'Country, currency, and language codes for local lookups.',
  'movielens-100k': 'Movie records, catalog stats, and genre vectors for recommendation tests.',
  stackoverflow: 'Python Q&A threads as JSON documents with comments inline.',
  'strata-bench-results': 'Benchmark runs stored as an event log.',
  wikipedia: 'Article metadata with a title-to-slug index.',
  'world-bank-indicators': 'Country-level population, GDP, and inflation records.',
};

const formatLabel = (value: string) => value.replaceAll('-', ' ');
const formatInt = (n: number) => new Intl.NumberFormat('en-US').format(n);
const formatDate = (value?: string) => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;

  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
};
const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
const quickstartHtml = (d: HubDataset) => `<code>${escapeHtml(d.quickstart.join('\n'))}</code>`;
const cloneCommand = (d: HubDataset) => d.quickstart[0] ?? `strata clone ${d.slug} ./${d.slug}`;
const commandDest = (command: string) => command.split(/\s+/)[3] ?? './database';
const featuredClone = cloneCommand(featuredDataset);
const featuredDest = commandDest(featuredClone);
const shortDescription = (d: HubDataset) =>
  shortDescriptions[d.slug] ?? d.description.split(/[.!?]\s/)[0] ?? d.description;
const primaryUse = (d: HubDataset) => formatLabel(d.tasks[0] ?? 'dataset work');
const formatBytes = (n?: number) => {
  if (typeof n !== 'number') return null;
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)} GB`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)} MB`;
  return `${Math.max(1, Math.round(n / 1e3))} KB`;
};

const countBy = (values: string[]) => {
  const counts = new Map<string, number>();
  for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
  return counts;
};
const primitiveFacets = primitiveOrder
  .map((id) => ({ id, n: datasets.filter((d) => d.primitives.includes(id)).length }))
  .filter((f) => f.n > 0);
const taskFacets = [...countBy(datasets.flatMap((d) => d.tasks)).entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8)
  .map(([id, n]) => ({ id, n }));
const licenseFacets = [...countBy(datasets.map((d) => d.license)).entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([id, n]) => ({ id, n }));
const allTasks = new Set(datasets.flatMap((d) => d.tasks));
const multiBranchCount = datasets.filter((d) => d.branches.length > 1).length;
const quickFilters = [
  { label: 'RAG', query: 'retrieval' },
  { label: 'Agent memory', query: 'agent-memory' },
  { label: 'Events', query: 'event' },
  { label: 'Benchmarks', query: 'benchmark' },
];
const heroStats = [
  { value: formatInt(datasets.length), label: 'datasets today' },
  { value: formatInt(allTasks.size), label: 'task areas' },
  { value: formatInt(multiBranchCount), label: 'branch examples' },
];
const heroFacts = [
  { label: 'JSON', body: 'movie records keyed as movie:<id>' },
  { label: 'KV', body: 'catalog counts and source metadata under meta:' },
  { label: 'Vectors', body: 'genre vectors for nearest-neighbor queries' },
  { label: 'Branch', body: 'a sample branch for fast local runs' },
];
---

<BaseLayout
  title="Strata Hub | datasets you can clone"
  description="Strata Hub is a catalog of Strata databases you can clone locally for retrieval, agent memory, benchmarks, event streams, reference data, and small experiments."
>
  <div class="hub-page">
    <section class="hub-hero mx-auto grid w-full max-w-[80rem] px-6 max-[480px]:px-4">
      <div class="hub-hero-copy reveal">
        <Eyebrow class="mb-3 font-mono !font-normal !text-terracotta-400">Strata Hub</Eyebrow>
        <Heading level={1} size="title" class="hub-title max-w-[46rem]">
          Start with a working database.
        </Heading>
        <p class="hub-intro mt-5 max-w-[43rem] text-body text-ink-mid">
          Find the right dataset for your project, clone it, and start building.
        </p>

        <div class="hub-clone-command">
          <span>Try one</span>
          <CopyChip value={featuredClone} label={featuredClone} class="hub-hero-copy-chip" />
          <p>
            Then open it with <code>strata {featuredDest}</code>.
          </p>
        </div>

        <div class="hub-actions" aria-label="Hub page actions">
          <a class="hub-primary-action" href="#catalog">Browse datasets</a>
        </div>
      </div>

      <aside class="hub-hero-panel reveal" aria-label="Example Hub clone workflow">
        <div class="hub-panel-top">
          <span>{hubHost}</span>
          <span>example clone</span>
        </div>
        <div class="hub-terminal">
          <p><span>$</span> {featuredClone}</p>
          <p class="hub-terminal-muted">resolved {hubHost}/{featuredDataset.slug}</p>
          <p class="hub-terminal-muted">wrote {featuredDest}</p>
          <p><span>$</span> strata {featuredDest}</p>
          <p class="hub-terminal-output">opened local database</p>
        </div>
        <div class="hub-featured">
          <div>
            <span>Featured dataset</span>
            <strong>{featuredDataset.title}</strong>
          </div>
        </div>
        <ul class="hub-preview-list">
          {
            heroFacts.map((item) => (
              <li>
                <span>{item.label}</span>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="hub-hero-stats" aria-label="Hub catalog summary">
          {
            heroStats.map((stat) => (
              <span>
                <strong>{stat.value}</strong>
                <small>{stat.label}</small>
              </span>
            ))
          }
        </div>
      </aside>
    </section>

    <section id="catalog" class="hub-catalog mx-auto w-full max-w-[80rem] px-6 max-[480px]:px-4">
      <header class="hub-catalog-head reveal">
        <div>
          <Heading level={2} size="heading" class="max-w-[38rem]">
            Strata Hub Dataset Catalog
          </Heading>
        </div>
        <div class="hub-source">
          <span>Hub</span>
          <strong>{hubHost}</strong>
        </div>
      </header>

      <div class="hub-toolbar reveal" aria-label="Dataset search and filters">
        <label class="hub-search-wrap" for="hub-search">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
          <input
            id="hub-search"
            type="search"
            placeholder="Search movies, events, agents, vectors..."
            autocomplete="off"
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="hub-quick-filters" aria-label="Suggested searches">
          {
            quickFilters.map((filter) => (
              <button type="button" data-query={filter.query}>
                {filter.label}
              </button>
            ))
          }
        </div>

        <div class="hub-toolbar-end">
          <details class="hub-filter-menu">
            <summary>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <line x1="4" y1="21" x2="4" y2="14"></line>
                <line x1="4" y1="10" x2="4" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12" y2="3"></line>
                <line x1="20" y1="21" x2="20" y2="16"></line>
                <line x1="20" y1="12" x2="20" y2="3"></line>
                <line x1="1" y1="14" x2="7" y2="14"></line>
                <line x1="9" y1="8" x2="15" y2="8"></line>
                <line x1="17" y1="16" x2="23" y2="16"></line>
              </svg>
              Filters
            </summary>
            <div class="hub-filter-panel">
              <section>
                <h3>Contains</h3>
                <div class="hub-facet-list">
                  {
                    primitiveFacets.map((facet) => (
                      <button
                        type="button"
                        data-facet-group="primitive"
                        data-facet-value={facet.id}
                        aria-pressed="false"
                      >
                        <span>{primitiveLabels[facet.id] ?? formatLabel(facet.id)}</span>
                        <small>{facet.n}</small>
                      </button>
                    ))
                  }
                </div>
              </section>

              <section>
                <h3>Good for</h3>
                <div class="hub-facet-list">
                  {
                    taskFacets.map((facet) => (
                      <button
                        type="button"
                        data-facet-group="task"
                        data-facet-value={facet.id}
                        aria-pressed="false"
                      >
                        <span>{formatLabel(facet.id)}</span>
                        <small>{facet.n}</small>
                      </button>
                    ))
                  }
                </div>
              </section>

              <section>
                <h3>License</h3>
                <div class="hub-facet-list">
                  {
                    licenseFacets.map((facet) => (
                      <button
                        type="button"
                        data-facet-group="license"
                        data-facet-value={facet.id}
                        aria-pressed="false"
                      >
                        <span>{facet.id}</span>
                        <small>{facet.n}</small>
                      </button>
                    ))
                  }
                </div>
              </section>

              <section>
                <h3>Branches</h3>
                <div class="hub-facet-list">
                  <button
                    type="button"
                    data-facet-group="branches"
                    data-facet-value="multi"
                    aria-pressed="false"
                  >
                    <span>Multiple branches</span>
                    <small>{multiBranchCount}</small>
                  </button>
                </div>
              </section>

              <button type="button" class="hub-clear-filters" data-clear-filters>
                Clear filters
              </button>
            </div>
          </details>

          <label class="hub-sort">
            <span>Sort</span>
            <select id="hub-sort">
              <option value="featured">Featured</option>
              <option value="name">Name</option>
              <option value="branches">Branches</option>
            </select>
          </label>
        </div>
      </div>

      <div class="hub-results-meta reveal" aria-live="polite">
        <span data-result-count>{datasets.length}</span>
        <span>datasets</span>
      </div>

      <div class="hub-table reveal" role="table" aria-label="Strata Hub datasets">
        <div class="hub-table-head" role="row">
          <span role="columnheader">Dataset</span>
          <span role="columnheader">Good for</span>
          <span role="columnheader">Contains</span>
          <span role="columnheader">Branches</span>
          <span role="columnheader">Open</span>
        </div>

        {
          datasets.map((d, index) => {
            const clone = cloneCommand(d);
            const size = formatBytes(d.size_bytes) ?? formatLabel(d.size_category);
            const rowDescription = shortDescription(d);
            const updated = formatDate(d.last_updated);
            const downloads = typeof d.downloads === 'number' ? formatInt(d.downloads) : null;
            const search = [
              d.slug,
              d.title,
              rowDescription,
              d.description,
              d.license,
              d.size_category,
              ...d.tasks,
              ...d.tags,
              ...d.primitives,
              ...d.branches,
              ...d.includes.map((item) => item.detail),
            ]
              .join(' ')
              .toLowerCase();

            return (
              <details
                class="hub-dataset"
                role="rowgroup"
                data-index={index}
                data-slug={d.slug}
                data-search={search}
                data-title={d.title.toLowerCase()}
                data-primitives={d.primitives.join(' ')}
                data-tasks={d.tasks.join(' ')}
                data-license={d.license}
                data-branch-count={d.branches.length}
              >
                <summary class="hub-row" role="row">
                  <span class="hub-row-main" role="cell">
                    <span class="hub-row-title">{d.title}</span>
                    <span class="hub-row-slug">{d.slug}</span>
                    <span class="hub-row-desc">{rowDescription}</span>
                  </span>
                  <span class="hub-row-use" role="cell">
                    {primaryUse(d)}
                  </span>
                  <span class="hub-row-shape" role="cell">
                    {d.primitives.map((primitive) => (
                      <span data-primitive={primitive}>
                        {primitiveLabels[primitive] ?? formatLabel(primitive)}
                      </span>
                    ))}
                  </span>
                  <span class="hub-row-branches" role="cell">
                    {d.branches.length}
                    <small>{d.branches.length === 1 ? 'branch' : 'branches'}</small>
                  </span>
                  <span class="hub-row-detail" role="cell">
                    <span>Open</span>
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </span>
                </summary>

                <div class="hub-detail">
                  <div class="hub-detail-grid">
                    <section class="hub-detail-story">
                      <span class="hub-detail-kicker">Dataset notes</span>
                      <p>{d.description}</p>
                    </section>

                    <aside class="hub-detail-actions">
                      <div class="hub-clone-box">
                        <span>Clone</span>
                        <CopyChip value={clone} label={clone} class="hub-row-copy-chip" />
                      </div>

                      <div class="hub-quickstart">
                        <span>Try first</span>
                        <pre set:html={quickstartHtml(d)} />
                      </div>
                    </aside>
                  </div>

                  <div class="hub-detail-lower">
                    <section class="hub-detail-block">
                      <h3>Inside the database</h3>
                      {d.includes.length ? (
                        <ul>
                          {d.includes.map((item) => (
                            <li>
                              <span>
                                {primitiveLabels[item.primitive] ?? formatLabel(item.primitive)}
                              </span>
                              <p>{item.detail}</p>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="hub-empty-note">
                          A detailed manifest has not been published for this dataset yet.
                        </p>
                      )}
                    </section>

                    <dl class="hub-detail-meta">
                      <div>
                        <dt>License</dt>
                        <dd>{d.license}</dd>
                      </div>
                      <div>
                        <dt>Size</dt>
                        <dd>{size}</dd>
                      </div>
                      <div>
                        <dt>Branches</dt>
                        <dd>{d.branches.join(', ')}</dd>
                      </div>
                      {updated && (
                        <div>
                          <dt>Updated</dt>
                          <dd>{updated}</dd>
                        </div>
                      )}
                      {downloads && (
                        <div>
                          <dt>Downloads</dt>
                          <dd>{downloads}</dd>
                        </div>
                      )}
                      <div>
                        <dt>Origin</dt>
                        <dd>
                          {hubHost}/{d.slug}
                        </dd>
                      </div>
                    </dl>
                  </div>
                </div>
              </details>
            );
          })
        }

        <div class="hub-empty" data-empty hidden>
          <strong>No matching datasets.</strong>
          <span>Clear the filters or search for a broader task.</span>
        </div>
      </div>
    </section>
  </div>

  <script>
    const search = document.querySelector<HTMLInputElement>('#hub-search');
    const sort = document.querySelector<HTMLSelectElement>('#hub-sort');
    const rows = Array.from(document.querySelectorAll<HTMLDetailsElement>('.hub-dataset'));
    const count = document.querySelector<HTMLElement>('[data-result-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const facetButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-facet-group][data-facet-value]'),
    );
    const clearFilters = document.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const queryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-query]'));
    const facets: Record<string, string> = {};
    let initialLoad = true;

    const normalize = (value: string | null | undefined) => (value ?? '').trim().toLowerCase();

    const setFacet = (group: string, value: string) => {
      if (facets[group] === value) delete facets[group];
      else facets[group] = value;
    };

    const syncFacetButtons = () => {
      for (const button of facetButtons) {
        const group = button.dataset.facetGroup ?? '';
        const value = button.dataset.facetValue ?? '';
        const active = facets[group] === value;
        button.setAttribute('aria-pressed', String(active));
      }
    };

    const rowMatches = (row: HTMLDetailsElement) => {
      const q = normalize(search?.value);
      if (q && !normalize(row.dataset.search).includes(q)) return false;

      if (
        facets.primitive &&
        !normalize(row.dataset.primitives).split(/\s+/).includes(facets.primitive)
      )
        return false;
      if (facets.task && !normalize(row.dataset.tasks).split(/\s+/).includes(facets.task))
        return false;
      if (facets.license && row.dataset.license !== facets.license) return false;
      if (facets.branches === 'multi' && Number(row.dataset.branchCount ?? '1') < 2) return false;

      return true;
    };

    const sortRows = (visibleRows: HTMLDetailsElement[]) => {
      const mode = sort?.value ?? 'featured';
      const sorted = visibleRows.slice().sort((a, b) => {
        if (mode === 'name') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        if (mode === 'branches') {
          return (
            Number(b.dataset.branchCount ?? '0') - Number(a.dataset.branchCount ?? '0') ||
            (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '')
          );
        }
        return Number(a.dataset.index ?? '0') - Number(b.dataset.index ?? '0');
      });

      sorted.forEach((row, i) => {
        row.style.order = String(i + 1);
      });
      if (empty) empty.style.order = String(sorted.length + 2);
    };

    const writeUrlState = () => {
      if (initialLoad) return;
      const params = new URLSearchParams();
      const q = search?.value.trim();
      if (q) params.set('q', q);
      if (sort?.value && sort.value !== 'featured') params.set('sort', sort.value);
      for (const [group, value] of Object.entries(facets)) params.set(group, value);
      const query = params.toString();
      history.replaceState(
        null,
        '',
        `${location.pathname}${query ? `?${query}` : ''}${location.hash}`,
      );
    };

    const apply = () => {
      const visibleRows: HTMLDetailsElement[] = [];
      for (const row of rows) {
        const visible = rowMatches(row);
        row.hidden = !visible;
        if (!visible) row.open = false;
        else visibleRows.push(row);
      }
      sortRows(visibleRows);
      if (count) count.textContent = String(visibleRows.length);
      if (empty) empty.hidden = visibleRows.length > 0;
      syncFacetButtons();
      writeUrlState();
    };

    const readUrlState = () => {
      const params = new URLSearchParams(location.search);
      if (search && params.has('q')) search.value = params.get('q') ?? '';
      if (sort && params.has('sort')) sort.value = params.get('sort') ?? 'featured';
      for (const group of ['primitive', 'task', 'license', 'branches']) {
        const value = params.get(group);
        if (value) facets[group] = value;
      }
    };

    search?.addEventListener('input', apply);
    sort?.addEventListener('change', apply);

    for (const button of facetButtons) {
      button.addEventListener('click', () => {
        const group = button.dataset.facetGroup;
        const value = button.dataset.facetValue;
        if (!group || !value) return;
        setFacet(group, value);
        apply();
      });
    }

    clearFilters?.addEventListener('click', () => {
      for (const key of Object.keys(facets)) delete facets[key];
      if (search) search.value = '';
      apply();
    });

    for (const button of queryButtons) {
      button.addEventListener('click', () => {
        if (!search) return;
        search.value = button.dataset.query ?? '';
        search.focus();
        apply();
      });
    }

    for (const row of rows) {
      row.addEventListener('toggle', () => {
        if (!row.open) return;
        for (const other of rows) {
          if (other !== row) other.open = false;
        }
        if (row.dataset.slug) {
          history.replaceState(
            null,
            '',
            `${location.pathname}${location.search}#${row.dataset.slug}`,
          );
        }
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement;
      if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
      event.preventDefault();
      search?.focus();
    });

    readUrlState();
    apply();
    initialLoad = false;

    const slug = decodeURIComponent(location.hash.slice(1));
    if (slug) {
      const row = rows.find((item) => item.dataset.slug === slug);
      if (row) {
        row.open = true;
        requestAnimationFrame(() => row.scrollIntoView({ block: 'center' }));
      }
    }
  </script>

  <style>
    .hub-page {
      overflow: clip;
      background:
        linear-gradient(rgba(var(--rgb-white) / 0.024) 1px, transparent 1px),
        linear-gradient(90deg, rgba(var(--rgb-white) / 0.024) 1px, transparent 1px),
        var(--color-void);
      background-size:
        48px 48px,
        48px 48px,
        auto;
    }

    .hub-hero {
      min-height: calc(100svh - 4.5rem);
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.78fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
      padding-top: clamp(4rem, 10vh, 7rem);
      padding-bottom: clamp(3.5rem, 8vh, 6rem);
    }

    .hub-intro code,
    .hub-intro-note code,
    .hub-clone-command code,
    .hub-catalog-head code {
