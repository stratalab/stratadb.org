---
// Strata Hub: the registry. Built for a catalog that grows to thousands of
// datasets - search is the primary surface (sticky command bar, `/` to focus),
// facets mirror the hub API's real query params (primitive / task / license),
// and results render as a dense ledger of rows. A row opens the dataset's
// manifest drawer: the full card plus its quickstart, so clone instructions
// live at the moment of intent. "How cloning works" is one click away in the
// header, not a section at the page bottom.
//
// Data: refreshed from the live hub API at build time (fetch-hub-catalog.mjs);
// the committed JSON is the offline floor; client fetch overlays live stats.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/foundation/Eyebrow.astro';
import Heading from '../components/foundation/Heading.astro';
import CopyChip from '../components/foundation/CopyChip.astro';
import catalog from '../data/hub-catalog.json';

interface HubDataset {
  slug: string;
  title: string;
  description: string;
  tasks: string[];
  tags: string[];
  license: string;
  size_category: string;
  size_bytes?: number;
  downloads?: number;
  last_updated?: string;
  primitives: string[];
  branches: string[];
  includes: { primitive: string; detail: string }[];
  quickstart: string[];
}
const datasets = catalog.datasets as HubDataset[];
const hubHost = catalog.hub.replace(/^https?:\/\//, '');

// Facet counts, computed from the catalog itself so the rail never lies.
const primitiveOrder = ['kv', 'json', 'events', 'vectors'];
const primitiveFacets = primitiveOrder
  .map((p) => ({ id: p, n: datasets.filter((d) => d.primitives.includes(p)).length }))
  .filter((f) => f.n > 0);
const countBy = (values: string[]) => {
  const m = new Map<string, number>();
  for (const v of values) m.set(v, (m.get(v) ?? 0) + 1);
  return m;
};
const taskFacets = [...countBy(datasets.flatMap((d) => d.tasks)).entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8)
  .map(([id, n]) => ({ id, n }));
const licenseFacets = [...countBy(datasets.map((d) => d.license)).entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([id, n]) => ({ id, n }));
const multiBranchCount = datasets.filter((d) => d.branches.length > 1).length;

const formatBytes = (n: number) =>
  n >= 1e9
    ? `${(n / 1e9).toFixed(1)} GB`
    : n >= 1e6
      ? `${(n / 1e6).toFixed(1)} MB`
      : `${Math.max(1, Math.round(n / 1e3))} KB`;

// The walkthrough terminal cycles datasets whose facts are real catalog facts.
const demoData = ['movielens-100k', 'titanic', 'agent-memory-with-experiments'].map((slug) => {
  const d = datasets.find((entry) => entry.slug === slug);
  if (!d) throw new Error(`hub demo dataset missing from catalog: ${slug}`);
  const clone = d.quickstart[0];
  const dest = clone.split(' ')[3] ?? `./${d.slug}.strata`;
  return { slug: d.slug, clone, dest, branches: d.branches.length };
});
---

<BaseLayout
  title="Strata Hub - clone-ready datasets"
  description="The Strata Hub registry: prepared Strata databases for RAG, agents, benchmarks, events, and reference data. Search, filter, and clone one with schema, examples, branches, and history."
>
  <div class="reg mx-auto w-full max-w-[80rem] px-6 pb-24 pt-12 max-[480px]:px-4">
    <!-- ===== header ===== -->
    <header class="reg-head">
      <div class="min-w-0">
        <Eyebrow class="mb-3 font-mono !font-normal !text-terracotta-400">Strata Hub</Eyebrow>
        <Heading size="title">The dataset registry.</Heading>
        <p class="mt-4 max-w-[40rem] text-body text-ink-mid">
          Prepared Strata databases. Clone one and it opens, branches, and time-travels like any
          local database.
        </p>
      </div>
      <div class="reg-head-actions">
        <span class="reg-status" data-hub-status data-state="snapshot">
          <i class="reg-status-dot" aria-hidden="true"></i>
          <span data-hub-status-label>catalog snapshot</span>
        </span>
        <button type="button" class="reg-how-btn" data-open-how aria-haspopup="dialog">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          How cloning works
        </button>
      </div>
    </header>

    <!-- ===== command bar ===== -->
    <div class="reg-bar">
      <div class="reg-search-wrap">
        <svg
          class="reg-search-icon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          id="reg-search"
          class="reg-search"
          type="search"
          placeholder="Search datasets"
          aria-label="Search datasets by name, task, or tag"
          autocomplete="off"
        />
        <kbd class="reg-kbd" aria-hidden="true">/</kbd>
      </div>
      <button
        type="button"
        class="reg-filter-btn"
        data-toggle-rail
        aria-expanded="false"
        aria-controls="reg-rail"
      >
        filters
      </button>
      <label class="reg-sort">
        <span>sort</span>
        <select id="reg-sort" aria-label="Sort datasets">
          <option value="featured" selected>featured</option>
          <option value="name">name</option>
          <option value="branches">branches</option>
          <option value="downloads" disabled data-live-sort>downloads</option>
        </select>
      </label>
      <p class="reg-count" data-count aria-live="polite">{datasets.length} datasets</p>
    </div>

    <!-- ===== rail + ledger ===== -->
    <div class="reg-main">
      <aside class="reg-rail" id="reg-rail" aria-label="Filter datasets">
        <div class="reg-facet-group">
          <p class="reg-facet-h">primitive</p>
          {
            primitiveFacets.map((f) => (
              <button
                type="button"
                class="reg-facet"
                data-facet="primitive"
                data-value={f.id}
                aria-pressed="false"
              >
                <i class:list={['reg-dot', `dot-${f.id}`]} aria-hidden="true" />
                <span class="reg-facet-label">{f.id}</span>
                <span class="reg-facet-n">{f.n}</span>
              </button>
            ))
          }
        </div>
        <div class="reg-facet-group">
          <p class="reg-facet-h">branches</p>
          <button
            type="button"
            class="reg-facet"
            data-facet="branches"
            data-value="multi"
            aria-pressed="false"
          >
            <i class="reg-dot dot-branches" aria-hidden="true"></i>
            <span class="reg-facet-label">multi-branch</span>
            <span class="reg-facet-n">{multiBranchCount}</span>
          </button>
        </div>
        <div class="reg-facet-group">
          <p class="reg-facet-h">task</p>
          {
            taskFacets.map((f) => (
              <button
                type="button"
                class="reg-facet"
                data-facet="task"
                data-value={f.id}
                aria-pressed="false"
              >
                <span class="reg-facet-label">{f.id}</span>
                <span class="reg-facet-n">{f.n}</span>
              </button>
            ))
          }
        </div>
        <div class="reg-facet-group">
          <p class="reg-facet-h">license</p>
          {
            licenseFacets.map((f) => (
              <button
                type="button"
                class="reg-facet"
                data-facet="license"
                data-value={f.id}
                aria-pressed="false"
              >
                <span class="reg-facet-label">{f.id}</span>
                <span class="reg-facet-n">{f.n}</span>
              </button>
            ))
          }
        </div>
        <button type="button" class="reg-clear" data-clear hidden>clear filters</button>
      </aside>

      <div class="reg-ledger" data-ledger>
        {
          datasets.map((d, index) => (
            <article
              class="reg-rowwrap"
              data-slug={d.slug}
              data-index={index}
              data-primitives={d.primitives.join(' ')}
              data-tasks={d.tasks.join(' ')}
              data-license={d.license}
              data-branch-count={d.branches.length}
              data-search={[d.slug, d.title, d.description, ...d.tasks, ...d.tags, ...d.primitives]
                .join(' ')
                .toLowerCase()}
            >
              <button type="button" class="reg-row" data-open-card={d.slug} aria-haspopup="dialog">
                <span class="reg-row-main">
                  <span class="reg-row-name">{d.slug}</span>
                  <span class="reg-row-desc">{d.description}</span>
                </span>
                <span class="reg-row-side">
                  <span class="reg-bar-mini" aria-hidden="true">
                    {d.primitives.map((p) => (
                      <i class:list={['reg-seg', `seg-${p}`]} />
                    ))}
                  </span>
                  <span class="reg-row-meta">
                    <span>{d.primitives.join(' · ')}</span>
                    {d.branches.length > 1 && <span>{d.branches.length} branches</span>}
                    <span class="reg-row-dl" data-row-dl hidden />
                  </span>
                </span>
                <span class="reg-row-chev" aria-hidden="true">
                  ›
                </span>
              </button>
              <button
                type="button"
                class="copy-chip reg-copy"
                data-copy={d.quickstart[0]}
                aria-label={`Copy: ${d.quickstart[0]}`}
              >
                <span class="copy-chip-icon" aria-hidden="true">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                </span>
                <span class="copy-chip-done hidden" aria-hidden="true">
                  ✓
                </span>
                clone
              </button>
            </article>
          ))
        }
        <div class="reg-empty" data-empty hidden>
          <p class="reg-empty-t">No dataset matches.</p>
          <p>Clear the search or filters - or tell us what's missing.</p>
          <button type="button" class="reg-clear !mt-4 !inline-flex" data-clear>
            clear filters
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== manifest drawer ===== -->
  <dialog class="reg-drawer" id="reg-drawer" aria-label="Dataset card">
    <div class="reg-drawer-top">
      <span class="font-mono text-mono-sm text-ink-low">{hubHost}</span>
      <button type="button" class="reg-close" data-close-drawer aria-label="Close dataset card">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    {
      datasets.map((d) => (
        <article class="reg-card" data-card={d.slug} hidden>
          <div class="reg-card-scroll">
            <header class="reg-card-head">
              <h2 class="reg-card-name">{d.slug}</h2>
              <p class="reg-card-title">
                {d.title}
                <span class="reg-badge">official</span>
              </p>
            </header>

            <div class="reg-bar-big" aria-hidden="true">
              {d.primitives.map((p) => (
                <i class:list={['reg-seg', `seg-${p}`]} />
              ))}
            </div>
            <p class="reg-legend" aria-label="Primitives in this dataset">
              {d.primitives.map((p) => (
                <span>
                  <i class:list={['reg-dot', `dot-${p}`]} aria-hidden="true" />
                  {p}
                </span>
              ))}
            </p>

            <p class="reg-card-desc">{d.description}</p>

            <dl class="reg-stats">
              <div>
                <dt>license</dt>
                <dd>{d.license}</dd>
              </div>
              <div>
                <dt>size</dt>
                <dd data-stat-size>
                  {typeof d.size_bytes === 'number' ? formatBytes(d.size_bytes) : d.size_category}
                </dd>
              </div>
              <div>
                <dt>branches</dt>
                <dd>{d.branches.length}</dd>
              </div>
              <div>
                <dt>clones</dt>
                <dd data-stat-dl>{typeof d.downloads === 'number' ? d.downloads : '-'}</dd>
              </div>
            </dl>

            {d.includes.length > 0 && (
              <>
                <p class="reg-card-h">in the clone</p>
                <ul class="reg-includes">
                  {d.includes.map((entry) => (
                    <li>
                      <i class:list={['reg-dot', `dot-${entry.primitive}`]} aria-hidden="true" />
                      <span>{entry.detail}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            <p class="reg-card-h">branches</p>
            <p class="reg-branches">
              {d.branches.map((b) => (
                <code>{b}</code>
              ))}
            </p>

            <div class="reg-card-h reg-quick-h">
              <span>quickstart</span>
              <CopyChip
                value={d.quickstart.join('\n')}
                label="copy all"
                class="!gap-2 !border-0 !bg-transparent !px-2 !py-1"
              />
            </div>
            <pre class="reg-quick" set:text={d.quickstart.join('\n')} />

            <p class="reg-provenance">
              A clone remembers its origin - <code>strata remote</code> reports{' '}
              <code>
                {hubHost}/{d.slug}
              </code>
              .
            </p>
          </div>
          <footer class="reg-card-foot">
            <CopyChip
              value={d.quickstart[0]}
              class="w-full justify-between !border-terracotta-500/40 !bg-inset [&_.copy-chip-label]:!text-ink-hi"
            />
          </footer>
        </article>
      ))
    }
  </dialog>

  <!-- ===== how cloning works ===== -->
  <dialog class="reg-howdlg" id="reg-how" aria-labelledby="reg-how-title">
    <div class="reg-howdlg-head">
      <h2 id="reg-how-title" class="text-heading text-ink-hi">How cloning works</h2>
      <button type="button" class="reg-close" data-close-how aria-label="Close">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="reg-howdlg-grid">
      <div>
        <ul class="reg-steps">
          <li>
            <p class="reg-step-t">Pick a dataset</p>
            <p>Each card lists what the clone contains and the first commands to run.</p>
          </li>
          <li>
            <p class="reg-step-t">Clone it</p>
            <p>
              <code>strata clone &lt;slug&gt; [dest]</code> resolves the hub, verifies the manifest, and
              writes a new local database.
            </p>
          </li>
          <li>
            <p class="reg-step-t">Use it locally</p>
            <p>
              Open, query, fork branches, read past versions. <code>strata remote</code> remembers where
              it came from. The hub is not in your read path.
            </p>
          </li>
        </ul>
        <p class="reg-how-note">
          Cloning uses the built-in hub by default. Point it elsewhere with the{' '}
          <code>--hub</code> flag, <code>STRATA_HUB_URL</code>, or{' '}
          <code>config set hub.url</code>.
        </p>
        <p class="reg-how-links">
          <a href="/docs/guides/cloning-datasets">Cloning datasets guide</a>
          <a href="/docs/concepts/hub-and-clone">Hub &amp; clone concept</a>
          <a href="/docs/reference/command-reference">Command reference</a>
        </p>
      </div>
      <div class="reg-term" data-clone-demo>
        <div class="reg-term-bar">
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-terracotta-500/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-low/35"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-low/35"></span>
            <span class="min-w-0 truncate font-mono text-mono-sm text-ink-mid">strata clone</span>
          </div>
          <span class="shrink-0 font-mono text-mono-sm text-ink-low">demo</span>
        </div>
        <div class="reg-term-body" data-clone-log aria-label="Clone walkthrough transcript">
          <div class="ht-entry">
            <p class="ht-cmd"><span class="ht-caret">$</span> strata clone movielens-100k ./ml</p>
            <p class="ht-out ht-dim">resolving hub … {hubHost}</p>
            <p class="ht-out ht-dim">manifest verified · 2 branches</p>
            <p class="ht-out ht-dim">objects ▰▰▰▰▰▰▰▰▰▰▰▰ complete</p>
            <p class="ht-out ht-ok">cloned into ./ml - an ordinary local database</p>
          </div>
          <div class="ht-entry">
            <p class="ht-cmd"><span class="ht-caret">$</span> strata ./ml remote</p>
            <p class="ht-out">origin: {hubHost}/movielens-100k</p>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <script
    is:inline
    type="application/json"
    id="hub-demo-data"
    set:html={JSON.stringify(demoData)}
  /><script
    is:inline
    type="application/json"
    id="hub-live-config"
    set:html={JSON.stringify({ hub: catalog.hub })}
  />

  <script>
    // ---- state: search + facets + sort, mirrored into the URL --------------
    const searchInput = document.getElementById('reg-search') as HTMLInputElement;
    const sortSelect = document.getElementById('reg-sort') as HTMLSelectElement;
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
    const facetButtons = [...document.querySelectorAll<HTMLButtonElement>('.reg-facet')];
    const clearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-clear]')];
    const rows = [...document.querySelectorAll<HTMLElement>('.reg-rowwrap')];

    const facets: Record<string, string | null> = {
      primitive: null,
      branches: null,
      task: null,
      license: null,
    };

    function rowMatches(row: HTMLElement, query: string) {
      if (query && !(row.dataset.search ?? '').includes(query)) return false;
      if (facets.primitive && !(row.dataset.primitives ?? '').split(' ').includes(facets.primitive))
        return false;
      if (facets.branches === 'multi' && Number(row.dataset.branchCount ?? '1') < 2) return false;
      if (facets.task && !(row.dataset.tasks ?? '').split(' ').includes(facets.task)) return false;
      if (facets.license && row.dataset.license !== facets.license) return false;
      return true;
    }

    function sortKey(row: HTMLElement): number {
      const mode = sortSelect.value;
      if (mode === 'branches') return -Number(row.dataset.branchCount ?? '0');
      if (mode === 'downloads') return -Number(row.dataset.downloads ?? '-1');
      return Number(row.dataset.index ?? '0');
    }

    function apply() {
      const query = searchInput.value.trim().toLowerCase();
      const mode = sortSelect.value;
      let order: HTMLElement[];
      if (mode === 'name') {
        order = [...rows].sort((a, b) =>
          (a.dataset.slug ?? '').localeCompare(b.dataset.slug ?? ''),
        );
      } else {
        order = [...rows].sort(
          (a, b) => sortKey(a) - sortKey(b) || Number(a.dataset.index) - Number(b.dataset.index),
        );
      }
      order.forEach((row, i) => {
        row.style.order = String(i);
      });

      let shown = 0;
      for (const row of rows) {
        const visible = rowMatches(row, query);
        row.hidden = !visible;
        if (visible) shown++;
      }
      if (countEl)
        countEl.textContent =
          shown === rows.length ? `${rows.length} datasets` : `${shown} of ${rows.length}`;
      if (emptyEl) emptyEl.hidden = shown > 0;

      const anyFacet = Object.values(facets).some(Boolean);
      for (const btn of clearButtons) btn.hidden = !anyFacet && !query;

      // Shareable state: /hub?q=…&primitive=…&sort=…
      const params = new URLSearchParams();
      if (query) params.set('q', query);
      for (const [group, value] of Object.entries(facets)) if (value) params.set(group, value);
      if (mode !== 'featured') params.set('sort', mode);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname + location.hash);
    }

    function syncFacetButtons() {
      for (const btn of facetButtons) {
        const active = facets[btn.dataset.facet ?? ''] === btn.dataset.value;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      }
    }

    searchInput.addEventListener('input', apply);
    sortSelect.addEventListener('change', apply);
    for (const btn of facetButtons) {
      btn.addEventListener('click', () => {
        const group = btn.dataset.facet ?? '';
        facets[group] = facets[group] === btn.dataset.value ? null : (btn.dataset.value ?? null);
        syncFacetButtons();
        apply();
      });
    }
    for (const btn of clearButtons) {
      btn.addEventListener('click', () => {
        searchInput.value = '';
        for (const group of Object.keys(facets)) facets[group] = null;
        syncFacetButtons();
        apply();
      });
    }

    // Mobile filters disclosure.
    const rail = document.getElementById('reg-rail');
    const railToggle = document.querySelector<HTMLButtonElement>('[data-toggle-rail]');
    railToggle?.addEventListener('click', () => {
      const open = rail?.classList.toggle('is-open') ?? false;
      railToggle.setAttribute('aria-expanded', String(open));
    });

    // `/` focuses search, registry style.
    document.addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement;
      if (target.closest('input, textarea, select, [contenteditable]')) return;
      if (document.querySelector('dialog[open]')) return;
      event.preventDefault();
      searchInput.focus();
    });

    // Restore state from the URL.
    {
      const params = new URLSearchParams(location.search);
      searchInput.value = params.get('q') ?? '';
      for (const group of Object.keys(facets)) {
        const value = params.get(group);
        if (
          value &&
          facetButtons.some((b) => b.dataset.facet === group && b.dataset.value === value)
        )
          facets[group] = value;
      }
      const sort = params.get('sort');
      if (sort && [...sortSelect.options].some((o) => o.value === sort && !o.disabled))
        sortSelect.value = sort;
      syncFacetButtons();
      apply();
    }

    // ---- manifest drawer --------------------------------------------------
    const drawer = document.getElementById('reg-drawer') as HTMLDialogElement;
    const cardEls = [...drawer.querySelectorAll<HTMLElement>('[data-card]')];
    let drawerOpener: HTMLElement | null = null;

    function openCard(slug: string, opener: HTMLElement | null) {
      const card = cardEls.find((el) => el.dataset.card === slug);
      if (!card) return;
      for (const el of cardEls) el.hidden = el !== card;
      drawerOpener = opener;
      if (!drawer.open) drawer.showModal();
      card.querySelector('.reg-card-scroll')?.scrollTo({ top: 0 });
      history.replaceState(null, '', `${location.pathname}${location.search}#${slug}`);
    }

    drawer.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
      drawerOpener?.focus();
      drawerOpener = null;
    });
    // Click on the backdrop closes.
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });
    document.querySelector('[data-close-drawer]')?.addEventListener('click', () => drawer.close());

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-open-card]')) {
      btn.addEventListener('click', () => openCard(btn.dataset.openCard ?? '', btn));
    }

    // Deep link: /hub#<slug> opens that dataset's card.
    const initial = decodeURIComponent(location.hash.slice(1));
    if (initial && cardEls.some((el) => el.dataset.card === initial)) openCard(initial, null);

    // ---- live hydration ---------------------------------------------------
    // The seed catalog owns the content; a reachable hub adds live numbers.
    const liveConfig = JSON.parse(
      document.getElementById('hub-live-config')?.textContent ?? '{}',
    ) as { hub?: string };

    function formatBytesJs(n: number) {
      if (n >= 1e9) return `${(n / 1e9).toFixed(1)} GB`;
      if (n >= 1e6) return `${(n / 1e6).toFixed(1)} MB`;
      return `${Math.max(1, Math.round(n / 1e3))} KB`;
    }
    function formatCount(n: number) {
      return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
    }

    async function hydrateLive() {
      if (!liveConfig.hub) return;
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 5000);
      try {
        const res = await fetch(`${liveConfig.hub}/v1/datasets?limit=200`, {
          signal: controller.signal,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) return;
        const body = (await res.json()) as {
          items?: { name: string; size_bytes?: number; downloads?: number }[];
        };
        if (!Array.isArray(body.items)) return;
        const byName = new Map(body.items.map((item) => [item.name, item]));
        let anyDownloads = false;
        for (const row of rows) {
          const live = byName.get(row.dataset.slug ?? '');
          if (!live) continue;
          if (typeof live.downloads === 'number') {
            anyDownloads = true;
            row.dataset.downloads = String(live.downloads);
            const dl = row.querySelector<HTMLElement>('[data-row-dl]');
            if (dl) {
              dl.textContent = `${formatCount(live.downloads)} clones`;
              dl.hidden = false;
            }
          }
          const card = cardEls.find((el) => el.dataset.card === row.dataset.slug);
          if (card) {
            const size = card.querySelector<HTMLElement>('[data-stat-size]');
            if (size && typeof live.size_bytes === 'number')
              size.textContent = formatBytesJs(live.size_bytes);
            const dl = card.querySelector<HTMLElement>('[data-stat-dl]');
            if (dl && typeof live.downloads === 'number')
              dl.textContent = formatCount(live.downloads);
          }
        }
        if (anyDownloads) {
          const option = sortSelect.querySelector<HTMLOptionElement>('[data-live-sort]');
          if (option) option.disabled = false;
        }
        const status = document.querySelector<HTMLElement>('[data-hub-status]');
        const label = document.querySelector<HTMLElement>('[data-hub-status-label]');
        if (status && label) {
          status.dataset.state = 'live';
          label.textContent = `live catalog · ${body.items.length} datasets`;
        }
      } catch {
        /* hub unreachable - the snapshot stands on its own */
      } finally {
        clearTimeout(timer);
      }
    }
    hydrateLive();

    // ---- how-cloning-works dialog + terminal loop -------------------------
    const howDialog = document.getElementById('reg-how') as HTMLDialogElement;
    document.querySelector('[data-open-how]')?.addEventListener('click', () => {
      howDialog.showModal();
      startDemo();
    });
    document.querySelector('[data-close-how]')?.addEventListener('click', () => howDialog.close());
    howDialog.addEventListener('click', (event) => {
      if (event.target === howDialog) howDialog.close();
    });

    // Terminal-typing tier of the motion system: jittered keystrokes, 300ms
    // beats. The server-rendered transcript is the reduced-motion and no-JS
    // rendering; the loop only runs while the dialog is open.
    const demoLog = document.querySelector<HTMLElement>('[data-clone-log]');
    const demoSets = JSON.parse(document.getElementById('hub-demo-data')?.textContent ?? '[]') as {
      slug: string;
      clone: string;
      dest: string;
      branches: number;
    }[];
    const reducedMotion = document.documentElement.dataset.motion === 'reduced';
    let demoRunning = false;

    function startDemo() {
      if (demoRunning || reducedMotion || !demoLog || demoSets.length === 0) return;
      demoRunning = true;
      runDemo().finally(() => {
        demoRunning = false;
      });
    }

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const demoActive = () => howDialog.open && !document.hidden;

    function demoLine(cls: string) {
      const p = document.createElement('p');
      p.className = cls;
      demoLog!.appendChild(p);
      return p;
    }

    async function typeCommand(text: string) {
      const p = demoLine('ht-cmd');
      const caret = document.createElement('span');
      caret.className = 'ht-caret';
      caret.textContent = '$';
      const body = document.createElement('span');
      const cursor = document.createElement('span');
      cursor.className = 'ht-cursor';
      p.append(caret, ' ', body, cursor);
      for (const char of text) {
        if (!demoActive()) break;
        body.textContent += char;
        await wait(24 + Math.random() * 16);
      }
      body.textContent = text;
      await wait(300);
      cursor.remove();
    }

    async function progressLine() {
      const BAR = 12;
      const p = demoLine('ht-out ht-dim');
      for (let i = 0; i <= BAR; i++) {
        if (!demoActive()) {
          i = BAR;
        }
        p.textContent = `objects ${'▰'.repeat(i)}${'▱'.repeat(BAR - i)}${i === BAR ? ' complete' : ''}`;
        await wait(70);
      }
    }

    async function outLine(cls: string, text: string) {
      if (demoActive()) await wait(300);
      demoLine(cls).textContent = text;
    }

    async function runDemo() {
      const host = new URL(liveConfig.hub ?? 'https://stratahub.io').host;
      for (let i = 0; howDialog.open; i = (i + 1) % demoSets.length) {
        const demo = demoSets[i];
        demoLog!.textContent = '';
        await typeCommand(demo.clone);
        await outLine('ht-out ht-dim', `resolving hub … ${host}`);
        await outLine(
          'ht-out ht-dim',
          `manifest verified · ${demo.branches} ${demo.branches === 1 ? 'branch' : 'branches'}`,
        );
        await progressLine();
        await outLine('ht-out ht-ok', `cloned into ${demo.dest} - an ordinary local database`);
        await wait(900);
        await typeCommand(`strata ${demo.dest} remote`);
        await outLine('ht-out', `origin: ${host}/${demo.slug}`);
        for (let hold = 0; hold < 42 && howDialog.open; hold++) await wait(100);
      }
    }
  </script>

