    "example": [
      "_ = db.json.set_many([{\"key\": \"a\", \"path\": \"$\", \"value\": {\"v\": 1}}, {\"key\": \"b\", \"path\": \"$\", \"value\": {\"v\": 2}}])",
      "db.json.get_many([{\"key\": \"a\", \"path\": \"$\"}, {\"key\": \"b\", \"path\": \"$\"}])"
    ]
  },
  "json.count": {
    "call": "db.json.count",
    "signature": "(prefix: 'Optional[str]' = None, *, as_of: 'Optional[int]' = None) -> 'int'",
    "summary": "Number of documents, optionally under an id prefix.",
    "example": [
      "_ = db.json.set(\"a\", \"$\", {\"v\": 1})",
      "_ = db.json.set(\"b\", \"$\", {\"v\": 2})",
      "db.json.count()"
    ]
  },
  "json.delete": {
    "call": "db.json.delete",
    "signature": "(key: 'str', path: 'str' = '$') -> 'Any'",
    "summary": "Deletes ``path`` in document ``key`` (whole document by default).",
