      "_ = db.json.set_many([{\"key\": \"a\", \"path\": \"$\", \"value\": {\"v\": 1}}, {\"key\": \"b\", \"path\": \"$\", \"value\": {\"v\": 2}}, {\"key\": \"c\", \"path\": \"$\", \"value\": {\"v\": 3}}])",
