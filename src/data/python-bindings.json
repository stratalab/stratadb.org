{
  "arrow.export": {
    "call": "db.arrow.export",
    "signature": "(primitive: 'str', path: 'str', *, format: 'str' = 'parquet', collection: 'Optional[str]' = None, event_type: 'Optional[str]' = None, graph: 'Optional[str]' = None, limit: 'Optional[int]' = None, prefix: 'Optional[str]' = None) -> 'Any'",
    "summary": "Exports a primitive's rows to ``path`` (Parquet by default).",
    "example": [
      "_ = db.kv.put(\"greeting\", \"hello\")",
      "_ = db.arrow.export(\"kv\", tmp_dir + \"/kv.parquet\", format=\"parquet\")  # One file per primitive; Parquet by default.",
      "_ = db.kv.delete(\"greeting\")",
      "_ = db.arrow.import_(\"kv\", tmp_dir + \"/kv.parquet\")",
      "db.kv.get(\"greeting\")"
    ]
  },
  "arrow.import": {
    "call": "db.arrow.import_",
    "signature": "(target: 'str', path: 'str', *, format: 'Optional[str]' = None, collection: 'Optional[str]' = None, graph: 'Optional[str]' = None, key_column: 'Optional[str]' = None, value_column: 'Optional[str]' = None) -> 'Any'",
    "summary": "Imports rows from ``path`` into ``target``.",
    "example": [
      "_ = db.kv.put(\"greeting\", \"hello\")",
      "_ = db.arrow.export(\"kv\", tmp_dir + \"/kv.parquet\", format=\"parquet\")",
      "_ = db.kv.delete(\"greeting\")",
      "_ = db.arrow.import_(\"kv\", tmp_dir + \"/kv.parquet\")  # Rows are keyed by their source column; kv restores greeting=hello.",
      "db.kv.get(\"greeting\")"
    ]
  },
  "branch.create": {
    "call": "db.branches.create",
    "signature": "(name: 'str') -> 'Any'",
    "summary": "Creates an empty branch rooted at an empty state.",
    "example": [
      "_ = db.branches.create(\"feature\")",
      "sorted(b.name for b in db.branches.list())"
    ]
  },
  "branch.delete": {
    "call": "db.branches.delete",
    "signature": "(name: 'str') -> 'Any'",
    "summary": "Deletes a branch.",
    "example": [
      "_ = db.branches.create(\"temp\")",
      "_ = db.branches.delete(\"temp\")",
      "sorted(b.name for b in db.branches.list())"
    ]
  },
  "branch.diff": {
    "call": "db.branches.diff",
    "signature": "(branch_a: 'str', branch_b: 'str', *, as_of: 'Optional[int]' = None) -> 'Any'",
    "summary": "Compares two branches and reports what differs, across every primitive.",
    "example": [
      "_ = db.vectors.create_collection(\"notes\", 2, metric=\"cosine\")",
      "_ = db.kv.put(\"config\", \"base\")",
      "_ = db.branches.fork(\"default\", \"experiment\")",
      "_ = db.at(branch=\"experiment\").kv.put(\"config\", \"tuned\")  # diverge the key-value entry on the fork",
      "_ = db.at(branch=\"experiment\").vectors.upsert(\"notes\", \"n1\", [0.1, 0.2])  # add a vector on the fork",
      "_ = db.branches.diff(\"default\", \"experiment\")  # reports the key-value change and the new vector, grouped by capability"
    ]
  },
  "branch.fork_at_version": {
    "call": "db.branches.fork",
    "signature": "(source: 'str', name: 'str', *, version: 'Optional[int]' = None, timestamp: 'Optional[int]' = None) -> 'Any'",
    "summary": "Forks ``name`` from ``source`` - at its current head, a version, or a timestamp.",
    "example": [
      "_ = db.branches.fork(\"default\", \"experiment\")",
      "sorted(b.name for b in db.branches.list())"
    ]
  },
  "branch.get": {
    "call": "db.branches.get",
    "signature": "(name: 'str') -> 'Any'",
    "summary": "Returns a branch's info, or ``None`` if it does not exist.",
    "example": [
      "_ = db.branches.create(\"feature\")",
      "db.branches.get(\"feature\").name"
    ]
  },
  "branch.list": {
    "call": "db.branches.list",
    "signature": "() -> 'list'",
    "summary": "Lists the branches.",
    "example": [
      "_ = db.branches.create(\"feature\")",
      "sorted(b.name for b in db.branches.list())"
    ]
  },
  "branch.merge": {
    "call": "db.branches.merge",
    "signature": "(source: 'str', target: 'str', *, strategy: 'Any' = 'strict') -> 'Any'",
    "summary": "Promotes ``source``'s changes into ``target`` as one atomic commit.",
    "example": [
      "_ = db.kv.put(\"config\", \"base\")",
      "_ = db.branches.fork(\"default\", \"experiment\")",
      "_ = db.at(branch=\"experiment\").kv.put(\"config\", \"tuned\")  # change on the fork",
      "_ = db.branches.merge(\"experiment\", \"default\", strategy=\"strict\")  # applies the fork's change onto default"
    ]
  },
  "branch.preview": {
    "call": "db.branches.preview",
    "signature": "(source: 'str', target: 'str', *, strategy: 'Any' = 'strict') -> 'Any'",
    "summary": "Previews promoting ``source`` into ``target`` without mutating either.",
    "example": [
      "_ = db.kv.put(\"config\", \"base\")",
      "_ = db.branches.fork(\"default\", \"experiment\")",
      "_ = db.at(branch=\"experiment\").kv.put(\"config\", \"tuned\")  # change on the fork",
      "_ = db.branches.preview(\"experiment\", \"default\", strategy=\"strict\")  # a clean preview - no conflicting changes on default"
    ]
  },
  "event.append": {
    "call": "db.events.append",
    "signature": "(event_type: 'str', payload: 'Any') -> 'Any'",
    "summary": "Appends one event; returns its sequence + commit receipt.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "db.events.len()"
    ]
  },
  "event.batch_append": {
    "call": "db.events.append_many",
    "signature": "(entries: 'Any') -> 'BatchResult'",
    "summary": "Appends many events in one commit. Each entry is (event_type, payload) or a dict.",
    "example": [
      "_ = db.events.append_many([{\"event_type\": \"user.created\", \"payload\": {\"id\": 1}}, {\"event_type\": \"user.updated\", \"payload\": {\"id\": 2}}])",
      "db.events.len()"
    ]
  },
  "event.count": {
    "call": "db.events.len",
    "signature": "(*, as_of: 'Optional[int]' = None) -> 'int'",
    "summary": "Number of events in the log.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "_ = db.events.append(\"user.updated\", {\"id\": 2})",
      "db.events.len()"
    ]
  },
  "event.exists": {
    "call": "db.events.exists",
    "signature": "(sequence: 'int') -> 'bool'",
    "summary": "Whether an event exists at ``sequence``.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "db.events.exists(0)",
      "db.events.exists(999)"
    ]
  },
  "event.get": {
    "call": "db.events.get",
    "signature": "(sequence: 'int', *, as_of: 'Optional[int]' = None) -> 'Any'",
    "summary": "Returns the event at ``sequence``, or ``None`` if out of range.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "db.events.get(0).event.payload",
      "db.events.get(999) is None"
    ]
  },
  "event.list": {
    "call": "db.events.list",
    "signature": "(event_type: 'Optional[str]' = None, *, limit: 'Optional[int]' = None, after_sequence: 'Optional[int]' = None, as_of: 'Optional[int]' = None) -> 'Page'",
    "summary": "A page of events, optionally filtered by type / after a sequence.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "_ = db.events.append(\"user.updated\", {\"id\": 2})",
      "[e.event.payload for e in db.events.list()]"
    ]
  },
  "event.range": {
    "call": "db.events.range",
    "signature": "(start: 'int', *, end: 'Optional[int]' = None, limit: 'Optional[int]' = None, reverse: 'bool' = False, event_type: 'Optional[str]' = None) -> 'Page'",
    "summary": "A page of events by sequence, from ``start`` (to ``end`` if given).",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "_ = db.events.append(\"user.updated\", {\"id\": 2})",
      "[e.event.payload for e in db.events.range(0)]"
    ]
  },
  "event.verify_chain": {
    "call": "db.events.verify_chain",
    "signature": "() -> 'Any'",
    "summary": "Verifies the hash chain; returns its length, validity, and first invalid link.",
    "example": [
      "_ = db.events.append(\"user.created\", {\"id\": 1})",
      "db.events.verify_chain().valid"
    ]
  },
  "graph.apply_delete_policy": {
    "call": "db.graphs.apply_delete_policy",
    "signature": "(primitive: 'str', key: 'str', policy: 'str', *, space: 'Optional[str]' = None) -> 'Any'",
    "summary": "Apply a delete policy to the graph facts bound to a product entity.",
    "example": [
      "_ = db.graphs.create(\"kb\")",
      "_ = db.graphs.add_node(\"kb\", \"ada\", binding={\"target\": {\"primitive\": \"kv\", \"space\": \"default\", \"key\": \"user:1\"}})",
      "_ = db.graphs.apply_delete_policy(\"kv\", \"user:1\", \"cascade\")  # cascade removes the bound node and its incident edges.",
      "db.graphs.get_node(\"kb\", \"ada\") is None"
    ]
  },
  "graph.batch_write": {
    "call": "db.graphs.batch_write",
    "signature": "(graph: 'str', operations: 'list') -> 'Any'",
    "summary": "Applies a batch of node/edge operations atomically.",
    "example": [
      "_ = db.graphs.create(\"g\")",
      "_ = db.graphs.batch_write(\"g\", [{\"type\": \"upsert_node\", \"node_id\": \"a\", \"data\": {\"object_type\": \"person\"}}, {\"type\": \"upsert_node\", \"node_id\": \"b\", \"data\": {\"object_type\": \"person\"}}, {\"type\": \"upsert_edge\", \"src\": \"a\", \"edge_type\": \"knows\", \"dst\": \"b\", \"data\": {}}])  # All operations land in one engine commit, or none do.",
      "db.graphs.meta(\"g\").node_count"
    ]
  },
  "graph.bulk_insert": {
    "call": "db.graphs.bulk_insert",
    "signature": "(graph: 'str', *, nodes: 'Optional[list]' = None, edges: 'Optional[list]' = None, chunk_size: 'Optional[int]' = None) -> 'Any'",
    "summary": "Insert many nodes and edges in one commit.",
    "example": [
      "_ = db.graphs.create(\"g\")",
      "_ = db.graphs.bulk_insert(\"g\", nodes=[{\"node_id\": \"a\", \"object_type\": \"person\"}, {\"node_id\": \"b\", \"object_type\": \"person\"}], edges=[{\"src\": \"a\", \"edge_type\": \"knows\", \"dst\": \"b\"}])",
      "db.graphs.meta(\"g\").node_count"
    ]
  },
  "graph.create": {
    "call": "db.graphs.create",
    "signature": "(name: 'str') -> 'Any'",
    "summary": "Creates an empty graph.",
    "example": [
      "_ = db.graphs.create(\"social\")",
      "db.graphs.list()"
    ]
  },
  "graph.delete": {
    "call": "db.graphs.delete",
    "signature": "(name: 'str') -> 'Any'",
    "summary": "Deletes a graph and all its nodes and edges.",
    "example": [
      "_ = db.graphs.create(\"temp\")",
      "_ = db.graphs.delete(\"temp\")",
      "db.graphs.list()"
    ]
  },
  "graph.list": {
    "call": "db.graphs.list",
    "signature": "() -> 'list'",
    "summary": "Lists the graphs (with node/edge counts).",
    "example": [
      "_ = db.graphs.create(\"social\")",
      "db.graphs.list()"
    ]
  },
  "graph.neighbors": {
    "call": "db.graphs.neighbors",
    "signature": "(graph: 'str', node_id: 'str', *, direction: 'str' = 'outgoing', edge_type: 'Optional[str]' = None, limit: 'Optional[int]' = None, cursor: 'Optional[Any]' = None, as_of: 'Optional[int]' = None) -> 'Page'",
    "summary": "A page of a node's neighbors (``direction`` is outgoing/incoming/both).",
    "example": [
      "_ = db.graphs.create(\"social\")",
      "_ = db.graphs.add_node(\"social\", \"alice\")",
      "_ = db.graphs.add_node(\"social\", \"bob\")",
      "_ = db.graphs.add_edge(\"social\", \"alice\", \"knows\", \"bob\")",
      "[n.node_id for n in db.graphs.neighbors(\"social\", \"alice\", direction=\"outgoing\")]"
    ]
  },
  "graph.nodes_by_type": {
    "call": "db.graphs.nodes_by_type",
    "signature": "(graph: 'str', object_type: 'str', *, limit: 'Optional[int]' = None, cursor: 'Optional[Any]' = None, as_of: 'Optional[int]' = None) -> 'Page'",
    "summary": "A page of nodes of a given object type.",
    "example": [
      "_ = db.graphs.create(\"g\")",
      "_ = db.graphs.add_node(\"g\", \"a\", object_type=\"person\")",
      "_ = db.graphs.add_node(\"g\", \"b\", object_type=\"person\")",
      "[n.node_id for n in db.graphs.nodes_by_type(\"g\", \"person\")]"
    ]
  },
  "graph.sample": {
    "call": "db.graphs.sample",
    "signature": "(graph: 'str', *, count: 'Optional[int]' = None) -> 'Sample'",
    "summary": "A representative sample of nodes plus the total count.",
    "example": [
      "_ = db.graphs.create(\"g\")",
      "_ = db.graphs.add_node(\"g\", \"a\")",
      "_ = db.graphs.add_node(\"g\", \"b\")",
      "db.graphs.sample(\"g\").total_count"
    ]
  },
