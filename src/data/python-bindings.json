      "db.hub.info().hash_algorithm                # doctest: +SKIP"
    ]
  },
  "hub.list_datasets": {
    "call": "db.hub.list_datasets",
    "signature": "(*, tasks: 'Union[str, Iterable[str], None]' = None, tags: 'Union[str, Iterable[str], None]' = None, primitives: 'Union[str, Iterable[str], None]' = None, license: 'Optional[str]' = None, size_min_bytes: 'Optional[int]' = None, size_max_bytes: 'Optional[int]' = None, sort: 'Any' = None, limit: 'Optional[int]' = None, offset: 'Optional[int]' = None, hub_url: 'Optional[str]' = None) -> 'Any'",
    "summary": "Lists the hub's datasets, filtered and sorted (``GET /v1/datasets``).",
    "example": [
      "page = db.hub.list_datasets(tasks=\"classification\", sort=\"downloads\", limit=5)  # doctest: +SKIP",
      "[dataset.name for dataset in page.items]                                        # doctest: +SKIP"
    ]
  },
  "hub.list_refs": {
    "call": "db.hub.list_refs",
    "signature": "(dataset: 'str', *, hub_url: 'Optional[str]' = None) -> 'Any'",
    "summary": "A dataset's live, cloneable refs (``GET /v1/datasets/{name}/refs``).",
    "example": [
      "[ref.branch for ref in db.hub.list_refs(\"titanic\").refs]   # doctest: +SKIP"
    ]
  },
  "hub.list_yanked": {
    "call": "db.hub.list_yanked",
    "signature": "(*, since: 'Union[str, datetime, None]' = None, hub_url: 'Optional[str]' = None) -> 'Any'",
    "summary": "The hub's yank deny-list - refs taken down (``GET /v1/yanked``).",
    "example": [
      "db.hub.list_yanked(since=\"2026-09-01T00:00:00Z\").total   # doctest: +SKIP"
    ]
  },
  "json.batch_delete": {
