---
// The documentation sidebar.
//
// One tree, every top-level section always visible, only the active branch
// expanded. That is what all six reference sites do, and at this size a single
// tree is well inside what they carry: Kubernetes renders 871 links in one and
// DuckDB 428. Scoping behind a section switcher, as Snowflake and ClickHouse
// do, only starts paying at their scale; Snowflake's Reference alone is 3022
// nodes. The tree comes from a manifest, so if our generated Reference ever
// outruns this, scoping becomes a rendering change rather than an IA change.
//
// No counts and no badges: none of the six carry them.
import { docsTree } from '../../lib/docsTree';
import DocsSidebarNode from './DocsSidebarNode.astro';

interface Props {
  /** Section to open on load. Everything else stays collapsed. */
  open?: string;
}
const { open } = Astro.props;
---

<nav class="hidden w-80 shrink-0 border-r border-line lg:block" aria-label="Documentation">
  <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pl-6 pr-4">
    <button
      type="button"
      class="docs-search-trigger mb-5 flex w-full items-center gap-2 rounded-(--radius-control) border border-line-hover bg-raised px-3 py-2 text-small text-ink-mid transition-colors duration-200 hover:border-terracotta-500 hover:text-ink-hi"
      aria-label="Search the documentation"
    >
      <svg
        class="h-3.5 w-3.5 shrink-0 text-terracotta-500"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path stroke-linecap="round" d="M21 21l-4.3-4.3"></path>
      </svg>
      <span>Search docs</span>
      <kbd class="ml-auto rounded border border-line px-1.5 font-mono text-mono-sm">/</kbd>
    </button>

    {
      docsTree.map((section) => (
        <details open={section.label === open} class="tree-section mb-1">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-(--radius-control) px-1 py-2 text-small font-semibold uppercase tracking-wide text-ink-hi transition-colors duration-200 hover:text-terracotta-400">
            <span class="tree-chev w-3 shrink-0 text-center text-ink-low">›</span>
            {section.href ? (
              <a
                href={section.href}
                data-section-link
                class="min-w-0 flex-1 truncate hover:text-terracotta-400"
              >
                {section.label}
              </a>
            ) : (
              <span class="min-w-0 flex-1 truncate">{section.label}</span>
            )}
          </summary>
          <ul class="mt-0.5 ml-2.5 space-y-px border-l border-line pb-3">
            {section.children?.map((child) => (
              <li>
                <DocsSidebarNode node={child} depth={1} />
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</nav>

<script>
  // A section header that is both a link and a toggle: clicking the label
  // navigates, clicking anywhere else in the summary folds the section. Without
  // stopping the event here, <summary> swallows the click and toggles instead.
  for (const link of document.querySelectorAll('[data-section-link]')) {
    link.addEventListener('click', (event) => event.stopPropagation());
  }
</script>

<style>
  .tree-chev {
    display: inline-block;
    transition: transform var(--dur-2) var(--ease-out);
  }

  details.tree-section[open] > summary > .tree-chev {
    transform: rotate(90deg);
  }
</style>
