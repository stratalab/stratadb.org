---
// One node of the documentation tree, rendered recursively.
//
// A node with children is a collapsible group; a leaf is a link once its page
// exists and plain text until then, so the sidebar can never invent a link.
//
// An unwritten leaf says so. It used to be dimmer text and nothing else, which
// is a distinction carried entirely by colour and, as it turned out, invisible:
// the sidebar read as finished documentation for a section that is 1 of 32
// written. The marker is the honest signal, not a decoration.
//
// Only leaves are marked. A group without an href is a category, not a missing
// page, so "How Strata works" is not waiting to be written.
//
// Depth reads structurally, not by indentation alone: every level of children
// hangs off its own vertical rule, so opening Reference draws one rule and
// opening Commands inside it draws a second. At four levels deep that is the
// only thing telling you where you are.
//
// Groups and leaves share a fixed-width chevron slot, so a group's label lines
// up with the labels of the leaves beside it and the chevron hangs in the
// gutter rather than pushing the text along.
import type { TreeNode } from '../../lib/docsTree';
import Self from './DocsSidebarNode.astro';

interface Props {
  node: TreeNode;
  depth: number;
  open?: boolean;
}
const { node, depth, open = false } = Astro.props;
const hasChildren = Boolean(node.children?.length);

// The page being read, so the tree can say where you are. Trailing slashes vary
// by host, so compare without one.
const here = Astro.url.pathname.replace(/\/$/, '');
const pathOf = (href: string) => href.split('#')[0].replace(/\/$/, '');

// Commands link to an anchor on their family page, and the server cannot know
// which anchor the reader is at. So a node that carries a fragment is never
// marked here; the script in DocsSidebar marks it from location.hash instead.
const isCurrent = Boolean(node.href) && !node.href!.includes('#') && pathOf(node.href!) === here;

// A group stays open when it holds the current page, so a deep link arrives
// with its ancestors already unfolded. Fragments count for opening, since every
// command on a family page is on the page being read.
const holdsCurrent = (n: TreeNode): boolean =>
  (n.href !== undefined && pathOf(n.href) === here) || (n.children?.some(holdsCurrent) ?? false);
const shouldOpen = open || (hasChildren && node.children!.some(holdsCurrent));
---

{
  hasChildren ? (
    <details open={shouldOpen} class="tree-node">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-(--radius-control) py-1.5 pl-1 pr-2 text-body text-ink-hi transition-colors duration-200 hover:text-terracotta-400">
        <span class="tree-chev w-3 shrink-0 text-center text-ink-low">›</span>
        {node.href ? (
          <a
            href={node.href}
            data-section-link
            aria-current={isCurrent ? 'page' : undefined}
            class:list={[
              'min-w-0 flex-1 truncate hover:text-terracotta-400',
              isCurrent && 'text-terracotta-500',
            ]}
          >
            {node.label}
          </a>
        ) : (
          <span class="min-w-0 flex-1 truncate">{node.label}</span>
        )}
      </summary>
      <ul class="ml-2.5 space-y-px border-l border-line">
        {node.children!.map((child) => (
          <li>
            <Self node={child} depth={depth + 1} />
          </li>
        ))}
      </ul>
    </details>
  ) : node.href ? (
    <a
      href={node.href}
      data-tree-leaf={node.href.includes('#') ? node.href : undefined}
      aria-current={isCurrent ? 'page' : undefined}
      class:list={[
        '-ml-px flex items-center gap-1.5 border-l-2 py-1.5 pl-1 pr-2 transition-colors duration-200',
        node.generated ? 'font-mono text-mono-body' : 'text-body',
        isCurrent
          ? 'border-terracotta-500 text-ink-hi'
          : 'border-transparent text-ink-mid hover:border-line-hover hover:text-ink-hi',
      ]}
    >
      <span class="w-3 shrink-0" aria-hidden="true" />
      <span class="min-w-0 flex-1 truncate">{node.label}</span>
    </a>
  ) : (
    <span
      class:list={[
        '-ml-px flex items-center gap-1.5 border-l-2 border-dashed border-line py-1.5 pl-1 pr-2 text-ink-low',
        node.generated ? 'font-mono text-mono-body' : 'text-body',
      ]}
      aria-label={`${node.label}, planned`}
    >
      <span class="w-3 shrink-0" aria-hidden="true" />
      <span class="min-w-0 flex-1 truncate">{node.label}</span>
      <span class="tree-soon" aria-hidden="true">
        soon
      </span>
    </span>
  )
}

<style>
  /* Two signals, so the difference survives a reader who cannot see the colour:
     the label steps back, and the rule it hangs off becomes dashed. The word is
     the third, for anyone scanning rather than reading. */
  .tree-soon {
    flex-shrink: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-ink-low);
  }

  /* A whole section can be unwritten, and 75 of these appear at once when it
     is. The word carries the meaning; a ring around each one turns an honest
     signal into visual noise at that density. No opacity on top of the token
     either: it drops 10px text under AA, and the size already does the work. */

  /* Direct-child only: a nested node must not inherit its ancestor's state. */
  .tree-chev {
    display: inline-block;
    transition: transform var(--dur-2) var(--ease-out);
  }

  details.tree-node[open] > summary > .tree-chev {
    transform: rotate(90deg);
  }
</style>
