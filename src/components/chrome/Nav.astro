---
// Public nav for the current product lock: docs, architecture, changelog, and
// the live browser playground. The primary action stays in-product.
import Button from '../foundation/Button.astro';

const navItems: { label: string; href: string }[] = [
  { label: 'Docs', href: '/docs' },
  { label: 'Architecture', href: '/architecture' },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Playground', href: '/playground' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-void/85 backdrop-blur-xl">
  <nav
    class="mx-auto flex h-16 w-full max-w-[70rem] items-center justify-between px-6 max-[480px]:px-4"
  >
    <a href="/" class="flex items-center gap-2.5">
      <svg
        class="h-5 w-5 text-terracotta-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
        <path d="M2 12l10 5 10-5"></path>
        <path d="M2 17l10 5 10-5"></path>
      </svg>
      <span class="font-semibold text-ink-hi">StrataDB</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-(--radius-control) px-3.5 py-2 text-small transition-colors duration-200',
              currentPath.startsWith(item.href)
                ? 'text-ink-hi underline decoration-terracotta-500 decoration-2 underline-offset-8'
                : 'text-ink-mid hover:text-ink-hi',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <Button href="/playground" class="max-sm:hidden">Try in browser</Button>
      <button
        id="nav-toggle"
        class="rounded-(--radius-control) p-2 text-ink-mid hover:text-ink-hi md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-sheet" class="hidden border-t border-line px-6 pb-4 md:hidden">
    {
      navItems.map((item) => (
        <a href={item.href} class="block py-3 text-small text-ink-mid hover:text-ink-hi">
          {item.label}
        </a>
      ))
    }
    <a href="/docs/getting-started" class="block py-3 text-small text-terracotta-500">Get Started</a
    >
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const sheet = document.getElementById('nav-sheet');
  toggle?.addEventListener('click', () => {
    const open = sheet?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
