---
// A figure in a prose page: an animation with a caption that carries the same
// information in words.
//
// The caption is not decoration and not a label. It is the figure's fallback:
// the markdown twin substitutes it for the animation, so an agent reading
// /docs/<page>.md gets the point the animation makes rather than a hole where
// it was. Write it as a sentence that stands alone.
//
// The animation is the only component allowed in this collection, which is what
// lets the twin generator be a substitution rather than a parser.
import EmbeddedShape from './figures/EmbeddedShape.astro';
import ModelsShape from './figures/ModelsShape.astro';
import BranchShape from './figures/BranchShape.astro';
import VersionShape from './figures/VersionShape.astro';
import SpaceShape from './figures/SpaceShape.astro';

interface Props {
  kind: 'embedded' | 'models' | 'branch' | 'versions' | 'spaces';
  caption: string;
}
const { kind, caption } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="overflow-hidden rounded-(--radius-frame) border border-line bg-raised">
    {kind === 'embedded' && <EmbeddedShape />}
    {kind === 'models' && <ModelsShape />}
    {kind === 'branch' && <BranchShape />}
    {kind === 'versions' && <VersionShape />}
    {kind === 'spaces' && <SpaceShape />}
  </div>
  <figcaption class="mt-3 text-body text-ink-mid">{caption}</figcaption>
</figure>
