---
// Docs hero artifact: a toy you can actually play with.
//
// The premise is the product's own claim. A Strata branch is O(metadata), so
// forking costs nothing. Rather than assert that, the artifact lets you fork
// as many times as you like and watch the copied-bytes counter refuse to move.
// It is a joke with a true punchline, which is the only kind worth shipping.
//
// Built from the landing page's vocabulary so the docs open in the same world:
// tinted window frames, cool for main and ember for forks, the branch
// surface/well token pair, the river connector's glow-under-core stroke, a
// masked grid mesh, and the segmented composition bar the Hub page uses.
//
// One hue per branch. The five models are told apart by shade, never by a
// palette the landing page does not already use.
const models = [
  { label: 'kv', shade: 1, fill: 62 },
  { label: 'json', shade: 0.84, fill: 88 },
  { label: 'events', shade: 0.68, fill: 45 },
  { label: 'vectors', shade: 0.54, fill: 74 },
  { label: 'graph', shade: 0.42, fill: 36 },
];
---

<figure class="art" data-art>
  <div class="art-ambient" aria-hidden="true"></div>
  <div class="art-mesh" aria-hidden="true"></div>

  <div class="art-stage">
    <!-- main: the database, holding all five models -->
    <div class="art-window art-main">
      <div class="art-bar">
        <span class="art-dot"></span>
        <span class="art-path">main</span>
        <span class="art-chip art-chip-ok">untouched</span>
      </div>
      <ul class="art-body">
        {
          models.map((model) => (
            <li class="art-row" data-model={model.label}>
              <span class="art-swatch" style={`--shade: ${model.shade}`} />
              <span class="art-label">{model.label}</span>
              <span class="art-meter">
                <span
                  class="art-meter-fill"
                  style={`--w: ${model.fill}%; --shade: ${model.shade}`}
                />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- the river: every fork leaves from here -->
    <svg class="art-river" viewBox="0 0 64 180" fill="none" aria-hidden="true">
      <path class="art-river-glow" d="M0 74 C 30 74, 34 100, 64 100"></path>
      <path class="art-river-core" d="M0 74 C 30 74, 34 100, 64 100"></path>
      <circle class="art-river-node" cx="1.5" cy="74" r="3.5"></circle>
    </svg>

    <!-- the forks, newest on top -->
    <ol class="art-forks" data-art-forks aria-label="Branches you have forked"></ol>
  </div>

  <div class="art-footer">
    <button type="button" class="art-fork-btn" data-art-fork>
      <span class="art-fork-glyph" aria-hidden="true">⑂</span> Fork it
    </button>
    <p class="art-readout" aria-live="polite">
      <span data-art-count>0 branches</span>
      <span class="art-sep" aria-hidden="true">·</span>
      <span class="art-zero">0 bytes copied</span>
      <span class="art-quip" data-art-quip></span>
    </p>
    <button type="button" class="art-reset" data-art-reset hidden>Reset</button>
  </div>
</figure>

<style>
  .art {
    position: relative;
    margin: 0 auto;
    width: 100%;
    max-width: 38rem;
    isolation: isolate;
  }

  .art-ambient {
    position: absolute;
    inset: -18% 0;
    z-index: -2;
    background:
      radial-gradient(38% 52% at 24% 34%, rgb(var(--rgb-strata-kv) / 0.16), transparent 70%),
      radial-gradient(40% 54% at 82% 68%, rgb(var(--rgb-terracotta-500) / 0.16), transparent 70%);
  }

  .art-mesh {
    position: absolute;
    inset: -10% 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(var(--rgb-white) / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--rgb-white) / 0.035) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at 50% 50%, black, transparent 74%);
  }

  .art-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 0.78fr);
    align-items: center;
  }

  .art-window {
    overflow: hidden;
    border-radius: var(--radius-frame);
  }

  .art-main {
    border: 1px solid rgb(var(--rgb-strata-kv) / 0.28);
    background: var(--color-branch-main-surface);
    box-shadow:
      0 1px 0 rgb(var(--rgb-white) / 0.04) inset,
      0 24px 60px -34px rgb(var(--rgb-black) / 0.9);
  }

  .art-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid rgb(var(--rgb-strata-kv) / 0.18);
  }

  .art-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-strata-kv);
  }

  .art-path {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-ink-mid);
  }

  .art-chip {
    margin-left: auto;
    border: 1px solid rgb(var(--rgb-white) / 0.1);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: 1.5;
  }

  .art-chip-ok {
    color: var(--color-ok);
  }

  .art-body {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0.85rem 0.75rem;
    background: var(--color-branch-main-well);
    list-style: none;
  }

  .art-row {
    display: grid;
    grid-template-columns: auto 4.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .art-swatch {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 0.15rem;
    background: var(--color-strata-kv);
    opacity: var(--shade, 1);
  }

  .art-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-ink-mid);
  }

  .art-meter {
    height: 0.3rem;
    border-radius: 999px;
    background: rgb(var(--rgb-white) / 0.06);
  }

  .art-meter-fill {
    display: block;
    width: var(--w, 100%);
    height: 100%;
    border-radius: 999px;
    background: var(--color-strata-kv);
    opacity: var(--shade, 1);
  }

  /* Hover a model to isolate it. */
  .art[data-focus] .art-row {
    opacity: 0.32;
  }

  .art[data-focus] .art-row.is-focus {
    opacity: 1;
  }

  .art-row.is-focus .art-label {
    color: var(--color-ink-hi);
  }

  /* The river, dim until the first fork exists. */
  .art-river {
    width: 100%;
    height: 100%;
    max-height: 11rem;
    overflow: visible;
    opacity: 0.25;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  .art[data-forked] .art-river {
    opacity: 1;
  }

  .art-river-glow {
    stroke: var(--color-terracotta-600);
    stroke-width: 7;
    stroke-linecap: round;
    opacity: 0.25;
  }

  .art-river-core {
    stroke: var(--color-terracotta-400);
    stroke-width: 1.75;
    stroke-linecap: round;
    opacity: 0.9;
  }

  .art-river-node {
    fill: var(--color-terracotta-400);
  }

  /* ---- The forks -------------------------------------------------------- */

  .art-forks {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    min-height: 11rem;
    align-content: center;
    list-style: none;
  }

  .art-forks :global(.art-fork-card) {
    overflow: hidden;
    border: 1px solid rgb(var(--rgb-terracotta-500) / 0.32);
    border-radius: var(--radius-control);
    padding: 0.4rem 0.55rem;
    background: var(--color-branch-risky-surface);
    box-shadow: 0 14px 34px -26px rgb(var(--rgb-terracotta-500) / 0.7);
    animation: art-fork-in var(--dur-4) var(--ease-out) both;
  }

  .art-forks :global(.art-fork-card.is-leaving) {
    animation: art-fork-out var(--dur-3) var(--ease-out) both;
  }

  .art-forks :global(.art-fork-name) {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-terracotta-300);
  }

  /* The segmented composition bar: five models, one strip. */
  .art-forks :global(.art-seg) {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    margin-top: 0.35rem;
    height: 0.25rem;
  }

  .art-forks :global(.art-seg span) {
    border-radius: 999px;
    background: var(--color-terracotta-500);
    opacity: var(--shade, 1);
  }

  @keyframes :global(art-fork-in) {
    from {
      opacity: 0;
      transform: translateX(-0.6rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes :global(art-fork-out) {
    to {
      opacity: 0;
      transform: translateY(-0.4rem) scale(0.96);
    }
  }

  /* ---- Controls --------------------------------------------------------- */

  .art-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .art-fork-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgb(var(--rgb-terracotta-500) / 0.5);
    border-radius: var(--radius-control);
    padding: 0.3rem 0.8rem;
    background: rgb(var(--rgb-terracotta-500) / 0.1);
    color: var(--color-terracotta-300);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    transition:
      background var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .art-fork-btn:hover,
  .art-fork-btn:focus-visible {
    border-color: var(--color-terracotta-400);
    background: rgb(var(--rgb-terracotta-500) / 0.18);
    color: var(--color-terracotta-200);
  }

  .art-fork-btn:active {
    transform: translateY(1px);
  }

  .art-fork-glyph {
    font-size: 0.95em;
  }

  .art-readout {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-ink-low);
  }

  .art-zero {
    color: var(--color-ok);
  }

  .art-sep {
    padding: 0 0.35rem;
  }

  .art-quip {
    padding-left: 0.55rem;
    color: var(--color-terracotta-400);
  }

  .art-reset {
    border: none;
    background: none;
    padding: 0;
    color: var(--color-ink-low);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .art-reset:hover,
  .art-reset:focus-visible {
    color: var(--color-ink-hi);
  }

  @media (prefers-reduced-motion: reduce) {
    .art-forks :global(.art-fork-card),
    .art-forks :global(.art-fork-card.is-leaving) {
      animation: none;
    }

    .art-row,
    .art-river {
      transition: none;
    }
  }

  @media (max-width: 30rem) {
    .art-stage {
      grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 0.7fr);
    }

    .art-row {
      grid-template-columns: auto 3.5rem minmax(0, 1fr);
    }
  }
</style>

<script>
  // A branch in Strata is metadata, so forking is free. The toy is simply
  // letting people prove that to themselves: the branch count climbs, the
  // copied-bytes number does not.
  const art = document.querySelector<HTMLElement>('[data-art]');

  if (art) {
    const root = art;
    const list = art.querySelector<HTMLElement>('[data-art-forks]');
    const countEl = art.querySelector<HTMLElement>('[data-art-count]');
    const quipEl = art.querySelector<HTMLElement>('[data-art-quip]');
    const forkBtn = art.querySelector<HTMLButtonElement>('[data-art-fork]');
    const resetBtn = art.querySelector<HTMLButtonElement>('[data-art-reset]');
    const shades = [1, 0.84, 0.68, 0.54, 0.42];
    const VISIBLE = 4;

    // Ordered by threshold, highest last.
    const quips: [number, string][] = [
      [1, ''],
      [3, 'still O(1)'],
      [7, 'nothing has been copied'],
      [12, 'genuinely, nothing'],
      [20, 'you may keep going'],
      [35, 'this is free. your scroll wheel is not.'],
      [60, 'ok, you win'],
    ];

    let count = 0;

    const hex = () =>
      Math.floor(Math.random() * 0xfff)
        .toString(16)
        .padStart(3, '0');

    function quipFor(n: number) {
      let text = '';
      for (const [at, words] of quips) if (n >= at) text = words;
      return text;
    }

    function fork() {
      if (!list || !countEl) return;
      count += 1;

      const card = document.createElement('li');
      card.className = 'art-fork-card';

      const name = document.createElement('span');
      name.className = 'art-fork-name';
      name.textContent = `run-${hex()}`;
      card.appendChild(name);

      const seg = document.createElement('span');
      seg.className = 'art-seg';
      for (const shade of shades) {
        const cell = document.createElement('span');
        cell.style.setProperty('--shade', String(shade));
        seg.appendChild(cell);
      }
      card.appendChild(seg);

      list.prepend(card);
      root.setAttribute('data-forked', '');

      // Keep the footprint fixed: retire the oldest once the stack is full.
      const cards = [...list.children] as HTMLElement[];
      for (const old of cards.slice(VISIBLE)) {
        old.classList.add('is-leaving');
        window.setTimeout(() => old.remove(), 240);
      }

      countEl.textContent = `${count} ${count === 1 ? 'branch' : 'branches'}`;
      if (quipEl) quipEl.textContent = quipFor(count);
      if (resetBtn) resetBtn.hidden = false;
    }

    function reset() {
      if (!list || !countEl) return;
      count = 0;
      list.textContent = '';
      root.removeAttribute('data-forked');
      countEl.textContent = '0 branches';
      if (quipEl) quipEl.textContent = '';
      if (resetBtn) resetBtn.hidden = true;
    }

    forkBtn?.addEventListener('click', fork);
    resetBtn?.addEventListener('click', reset);

    // Fork once when it first scrolls into view, so the control explains itself.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            fork();
            observer.disconnect();
          }
        }
      },
      { threshold: 0.4 },
    );
    observer.observe(art);

    // Hover a model to isolate it.
    const rows = art.querySelectorAll<HTMLElement>('.art-row[data-model]');
    const focus = (model: string | null) => {
      if (model) art.setAttribute('data-focus', model);
      else art.removeAttribute('data-focus');
      rows.forEach((row) => row.classList.toggle('is-focus', row.dataset.model === model));
    };
    rows.forEach((row) =>
      row.addEventListener('pointerenter', () => focus(row.dataset.model ?? null)),
    );
    art.addEventListener('pointerleave', () => focus(null));
  }
</script>
