---
// One command on a family page, carrying the same anatomy as its own page.
//
// This is the shape the Databricks utilities reference uses, and it uses it in
// exactly this position: on the consolidated page, every command gets the full
// treatment rather than a stub. Heading, signature, description, the call that
// prints complete help, then a labelled example behind a language switcher.
//
// So a reader who lands here never has to leave to understand a command. The
// per-command page is not a fuller version of this block, it is the same block
// plus the exhaustive parts: the parameter table, the return shape and the
// error codes. That is what "View details" goes and gets.
//
// The switcher covers the signature, the help pointer and the example, since
// all three differ per interface. Unlike dbutils, our interfaces do not share
// a signature: the CLI spells it `strata kv batch-delete` and Python spells it
// `db.kv.delete_many`.
import { cliExampleText, pythonExampleText } from '../../lib/exampleText';

interface Props {
  /** Anchor id, also the rail target. */
  id: string;
  /** Heading text: the engine op, as the sidebar spells it. */
  name: string;
  /** Heading level, since grouped commands sit under a group heading. */
  level?: 2 | 3;
  summary: string;
  /** First paragraph of the generated description. */
  description?: string;
  /** Full command page. */
  href: string;
  cli: string;
  cliExample?: string;
  python?: { call: string; signature: string; example?: string[] };
}

const { id, name, level = 2, summary, description, href, cli, cliExample, python } = Astro.props;

const Heading = level === 2 ? 'h2' : 'h3';
const SubHeading = level === 2 ? 'h3' : 'h4';
const ifaces = ['cli', ...(python ? ['python'] : [])];
const IFACE_LABEL: Record<string, string> = { cli: 'CLI', python: 'Python' };

const signature: Record<string, string> = {
  cli,
  python: python ? `${python.call}${python.signature}` : '',
};
const helpFor: Record<string, string> = {
  cli: `${cli} --help`,
  python: python ? `help(${python.call})` : '',
};
const sample: Record<string, string> = {
  cli: cliExampleText(cliExample),
  python: pythonExampleText(python?.example),
};

// A <pre> keeps every character, including whitespace a formatter adds around
// an expression, so set the text directly.
const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<section id={id} data-command-entry class="not-prose mt-12 scroll-mt-24 border-b border-line pb-12">
  <Heading class:list={['font-mono text-ink-hi', level === 2 ? 'text-heading' : 'text-body-lg']}
    >{name}</Heading
  >
  <p class="mt-2 text-body text-ink-mid">{summary}</p>

  <div class="mt-5 overflow-hidden rounded-(--radius-frame) border border-line bg-raised">
    <div
      class:list={['gap-1 border-b border-line px-3 py-2', ifaces.length > 1 ? 'flex' : 'hidden']}
      role="tablist"
      aria-label={`Interface for ${name}`}
    >
      {
        ifaces.map((iface, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-iface-tab={iface}
            class="rounded-(--radius-control) px-3 py-1.5 font-mono text-mono-sm text-ink-mid transition-colors duration-200 hover:text-ink-hi aria-selected:bg-elevated aria-selected:text-ink-hi"
          >
            {IFACE_LABEL[iface]}
          </button>
        ))
      }
    </div>

    {
      ifaces.map((iface) => (
        <p
          class="px-5 py-3.5 font-mono text-mono-body text-ink-hi"
          data-iface-panel={iface}
          hidden={iface !== 'cli'}
        >
          {signature[iface]}
        </p>
      ))
    }
  </div>

  {description && <p class="mt-5 text-body text-ink-mid">{description}</p>}

  <p class="mt-5 text-body text-ink-mid">To see the complete help for this command, run:</p>
  <p class="mt-1.5 font-mono text-mono-sm">
    {
      ifaces.map((iface) => (
        <code class="text-ink-hi" data-iface-panel={iface} hidden={iface !== 'cli'}>
          {helpFor[iface]}
        </code>
      ))
    }
  </p>

  <SubHeading class="mt-6 text-body-lg font-medium text-ink-hi">Example</SubHeading>
  <div class="mt-2 overflow-hidden rounded-(--radius-frame) border border-line bg-inset">
    {
      ifaces.map((iface) => (
        <pre
          class="overflow-x-auto px-5 py-4 font-mono text-mono-sm text-term-fg"
          data-iface-panel={iface}
          hidden={iface !== 'cli'}
          set:html={escapeHtml(sample[iface])}
        />
      ))
    }
  </div>

  <a
    href={href}
    class="mt-5 inline-block font-mono text-mono-sm text-terracotta-500 transition-colors duration-200 hover:text-terracotta-400"
  >
    View details &rarr;
  </a>
</section>
