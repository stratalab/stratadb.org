---
// Install: the one action worth privileging on a documentation front page.
//
// A switcher rather than a stack. Three ways in are three alternatives, not a
// checklist, so the reader picks theirs and copies one line. Showing all of
// them at once implied you needed all of them.
//
// Commands come from the installer itself and the published package, and no
// version is written down, so nothing here can go stale against a release.
const modes = [
  { id: 'script', label: 'Script', cmd: 'curl -fsSL https://stratadb.org/install.sh | sh' },
  { id: 'homebrew', label: 'Homebrew', cmd: 'brew install stratalab/tap/strata' },
  { id: 'python', label: 'Python', cmd: 'pip install stratadb' },
];
---

<section class="mt-14" aria-label="Install">
  <h2 class="text-small font-medium uppercase text-ink-mid">Install</h2>
  <p class="mt-2 text-body-lg text-ink-hi">
    One binary and a directory. No server to run, and nothing to configure first.
  </p>

  <div class="mt-4 overflow-hidden rounded-(--radius-frame) border border-line bg-raised">
    <div
      class="flex gap-1 border-b border-line px-3 py-2"
      role="tablist"
      aria-label="Install method"
    >
      {
        modes.map((mode, i) => (
          <button
            type="button"
            role="tab"
            id={`install-tab-${mode.id}`}
            aria-controls="install-panel"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-install-tab={mode.id}
            class="rounded-(--radius-control) px-3 py-1.5 font-mono text-mono-body text-ink-mid transition-colors duration-200 hover:text-ink-hi aria-selected:bg-elevated aria-selected:text-ink-hi"
          >
            {mode.label}
          </button>
        ))
      }
    </div>

    <div
      class="flex items-center gap-4 px-5 py-5"
      role="tabpanel"
      id="install-panel"
      aria-labelledby="install-tab-script"
    >
      <span class="select-none font-mono text-mono-body text-ink-low">$</span>
      <code
        class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-mono-body text-ink-hi"
        data-install-cmd>{modes[0].cmd}</code
      >
      <button
        type="button"
        class="shrink-0 rounded-(--radius-control) border border-line px-3 py-1 font-mono text-mono-body text-ink-mid transition-colors duration-200 hover:border-terracotta-500 hover:text-ink-hi"
        data-install-copy
        aria-label="Copy the install command"
      >
        copy
      </button>
    </div>
  </div>

  <p class="mt-3 font-mono text-mono-body text-ink-mid">
    then <span class="text-ink-hi">strata --cache ping</span>
    <span class="text-ink-low">prints pong and the version you installed</span>
  </p>
</section>

<script>
  // The switcher swaps one command in place; copy always takes what is shown.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-install-tab]')];
  const code = document.querySelector<HTMLElement>('[data-install-cmd]');
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-install-copy]');
  const panel = document.getElementById('install-panel');

  const COMMANDS: Record<string, string> = {
    script: 'curl -fsSL https://stratadb.org/install.sh | sh',
    homebrew: 'brew install stratalab/tap/strata',
    python: 'pip install stratadb',
  };

  function select(id: string) {
    if (!code) return;
    code.textContent = COMMANDS[id] ?? '';
    panel?.setAttribute('aria-labelledby', `install-tab-${id}`);
    tabs.forEach((tab) => {
      const on = tab.dataset.installTab === id;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab.dataset.installTab ?? 'script'));
    // Arrow keys move between tabs, as a tablist should.
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      event.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next.dataset.installTab ?? 'script');
    });
  });

  copyBtn?.addEventListener('click', async () => {
    if (!code?.textContent) return;
    try {
      await navigator.clipboard.writeText(code.textContent);
      copyBtn.textContent = 'copied';
      setTimeout(() => {
        copyBtn.textContent = 'copy';
      }, 1500);
    } catch {
      /* clipboard unavailable (permissions or an insecure context) */
    }
  });
</script>
