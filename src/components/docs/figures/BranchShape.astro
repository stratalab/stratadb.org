---
// A fork, a divergence, and a merge, drawn on two lanes of versions.
//
// The thing worth showing is that the branch point is a *version*, not a moment
// someone remembers: the fork leaves default at a specific dot, both lanes then
// advance on their own, and the merge lands as a new dot on default rather than
// rewriting the ones behind it. A static diagram says the same, but the order
// of events is the content here, so the dots arrive in the order they happen.
//
// One accent throughout. The fork lane is the same colour at lower strength,
// because it is the same database, not another one.
---

<div class="p-6 sm:p-8">
  <svg viewBox="0 0 520 150" class="branch-svg w-full" role="img" aria-hidden="true">
    <!-- default lane -->
    <line x1="30" y1="40" x2="490" y2="40" class="lane"></line>
    <!-- fork lane, drawn from the branch point -->
    <path d="M170 40 C 195 40, 195 110, 220 110 L 400 110" class="lane lane-fork"></path>
    <!-- merge back into default -->
    <path d="M400 110 C 425 110, 425 40, 450 40" class="lane lane-merge"></path>

    <circle cx="70" cy="40" r="5" class="dot" style="--d:0s"></circle>
    <circle cx="120" cy="40" r="5" class="dot" style="--d:0.25s"></circle>
    <circle cx="170" cy="40" r="6" class="dot dot-point" style="--d:0.5s"></circle>
    <circle cx="300" cy="40" r="5" class="dot" style="--d:1.4s"></circle>
    <circle cx="380" cy="40" r="5" class="dot" style="--d:1.7s"></circle>

    <circle cx="260" cy="110" r="5" class="dot dot-side" style="--d:1.1s"></circle>
    <circle cx="330" cy="110" r="5" class="dot dot-side" style="--d:1.35s"></circle>
    <circle cx="400" cy="110" r="5" class="dot dot-side" style="--d:1.6s"></circle>

    <circle cx="450" cy="40" r="6" class="dot dot-merge" style="--d:2.4s"></circle>

    <text x="30" y="26" class="label">default</text>
    <text x="220" y="136" class="label label-dim">cleaned</text>
    <text x="170" y="26" class="label label-dim" text-anchor="middle">branch point</text>
  </svg>
</div>

<style>
  .branch-svg {
    max-height: 190px;
  }
  .lane {
    fill: none;
    stroke: var(--color-line-hover);
    stroke-width: 1.5;
  }
  .lane-fork,
  .lane-merge {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: draw 5s var(--ease-out) infinite;
  }
  .lane-fork {
    animation-delay: 0.55s;
  }
  .lane-merge {
    animation-delay: 1.9s;
  }

  .dot {
    fill: var(--color-terracotta-500);
    opacity: 0;
    animation: pop 5s var(--ease-out) infinite;
    animation-delay: var(--d);
  }
  .dot-side {
    fill: var(--color-terracotta-700);
  }
  .dot-point,
  .dot-merge {
    fill: var(--color-terracotta-400);
  }

  .label {
    fill: var(--color-ink-mid);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .label-dim {
    fill: var(--color-ink-low);
  }

  @keyframes draw {
    0%,
    8% {
      stroke-dashoffset: 260;
    }
    26%,
    88% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 260;
    }
  }
  @keyframes pop {
    0% {
      opacity: 0;
    }
    6%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  html[data-motion='reduced'] .dot,
  html[data-motion='reduced'] .lane-fork,
  html[data-motion='reduced'] .lane-merge {
    animation: none;
    opacity: 1;
    stroke-dashoffset: 0;
  }
</style>
