---
// Section 4 (04 §5 v2): "Go back to any moment." - time travel as direct
// manipulation. The scroll-scrub is gone (Ani, 2026-06-12: "the user can
// scrub back and forth... not another parallax scroll"); the artifact is a
// draggable timeline the visitor owns. The head and instrument share a pinned
// chapter frame so normal scrolling gives the animation time to land.
import SectionRule from '../foundation/SectionRule.astro';
import Heading from '../foundation/Heading.astro';
import Eyebrow from '../foundation/Eyebrow.astro';
import TimeScrubber from './timetravel/TimeScrubber.tsx';
---

<section id="time-travel" class="relative min-h-[100svh] scroll-mt-16 lg:h-[180svh]">
  <SectionRule label="TIME TRAVEL" index="04" sticky />
  <div
    class="relative mx-auto grid min-h-[calc(100svh-1.625rem)] w-full max-w-[88rem] overflow-x-clip px-6 py-20 max-[480px]:px-4 lg:sticky lg:top-[calc(4rem+1.625rem)] lg:h-[calc(100svh-5.625rem)] lg:min-h-0 lg:grid-cols-[minmax(19rem,0.35fr)_minmax(0,1fr)] lg:items-center lg:gap-14 lg:py-0 xl:gap-16"
  >
    <div class="reveal max-w-[42rem] lg:max-w-none">
      <Eyebrow
        data-feature-eyebrow="time-travel"
        class="mb-4 font-mono !font-normal !text-terracotta-400"
      >
        Time travel
      </Eyebrow>
      <Heading size="title">Read any past version of your data.</Heading>
      <p class="mt-6 text-body-lg text-ink-mid">
        Every write records a version. Use <code class="whitespace-nowrap">--as-of</code> to see what
        the database returned before a later change, without restoring a backup or copying data aside.
      </p>
    </div>

    <div class="relative mt-14 min-w-0 lg:mt-0">
      <!-- one quiet stage light, the page's temperature -->
      <div
        class="pointer-events-none absolute -inset-x-16 -inset-y-10"
        style="background: radial-gradient(46% 60% at 50% 45%, rgb(var(--rgb-terracotta-500) / 0.09), transparent 70%);"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <TimeScrubber client:load />
      </div>
    </div>
  </div>
</section>
