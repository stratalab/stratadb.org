---
// Section 3 (04 §5 v2, 2026-06-12): tabs + content per the claude.com
// reference - each primitive is a tab; the content area plays its demo.
// The vertical tab rail preserves the motif's load-bearing appearance:
// it IS the strata column, five layers stacked. The section head now rides
// with the pinned viewport so the entry point does not scroll away before
// the demo takes over.
import SectionRule from '../foundation/SectionRule.astro';
import PrimitiveTabs from './primitives/PrimitiveTabs.tsx';

const primitiveAnchors = ['kv', 'event', 'json', 'vector', 'graph'];
---

<section id="primitives" class="relative min-h-[100svh] scroll-mt-16">
  <div aria-hidden="true">
    {primitiveAnchors.map((id) => <span id={`primitive-${id}`} class="block h-0 scroll-mt-16" />)}
  </div>

  <SectionRule label="PRIMITIVES" index="03" sticky />
  <!-- The tabs + content stage owns the section viewport. The section head is
       inside the island so it remains visible while the pinned demo advances. -->
  <!-- overflow-x-clip: the stage lights bleed past the container on purpose;
       clip them at the viewport without cutting vertical glow. -->
  <div
    class="relative mx-auto w-full max-w-[88rem] overflow-x-clip px-6 pb-32 pt-14 max-md:pb-20 max-[480px]:px-4 lg:py-0"
  >
    <PrimitiveTabs client:visible />
  </div>
</section>
