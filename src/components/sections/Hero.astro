---
// Section 1: badge → H1 → CTAs → data-model index → set-piece.
// (Stat strip removed 2026-06-12, Ani - the benchmark claims leave the hero;
// benchmarks.json remains for the specimen/docs.) Parallax site #1 of 2
// (03 §3.1): glow 0.85× · terminal 1.0×.
import Badge from '../foundation/Badge.astro';
import Heading from '../foundation/Heading.astro';
import Button from '../foundation/Button.astro';
import CopyChip from '../foundation/CopyChip.astro';
import HorizonGlow from '../foundation/HorizonGlow.astro';
import ForkingTerminal from './hero/ForkingTerminal.tsx';
import release from '../../data/release.json';

// The capability index: every tile opens the surface that proves it.
// White at rest; the hover fill matches the primary browser CTA.
const dataModel = [
  {
    label: 'KV',
    href: '#primitive-kv',
    primitive: 'kv',
    installMode: undefined,
    ariaLabel: 'Open the key-value primitive demo',
    icon: '<circle class="dm-icon-fill" cx="7" cy="12" r="4"/><path d="M10.7 12h9.8"/><path d="M15.8 12v4M19 12v3"/>',
  },
  {
    label: 'Event',
    href: '#primitive-event',
    primitive: 'event',
    installMode: undefined,
    ariaLabel: 'Open the event log primitive demo',
    icon: '<path class="dm-icon-fill" d="M4 17.5h16v2H4z"/><path d="M4 13h3.5l1.9-6.2 3.5 11.6 2.3-7.1 1.6 3.4H20"/>',
  },
  {
    label: 'JSON',
    href: '#primitive-json',
    primitive: 'json',
    installMode: undefined,
    ariaLabel: 'Open the JSON primitive demo',
    icon: '<path d="M8.7 4.2c-1.7 0-2.5.9-2.5 2.7v2.2c0 1.4-.7 2.3-2 2.9 1.3.6 2 1.5 2 2.9v2.2c0 1.8.8 2.7 2.5 2.7"/><path d="M15.3 4.2c1.7 0 2.5.9 2.5 2.7v2.2c0 1.4.7 2.3 2 2.9-1.3.6-2 1.5-2 2.9v2.2c0 1.8-.8 2.7-2.5 2.7"/><circle class="dm-icon-fill" cx="12" cy="12" r="2"/>',
  },
  {
    label: 'Vector',
    href: '#primitive-vector',
    primitive: 'vector',
    installMode: undefined,
    ariaLabel: 'Open the vector primitive demo',
    icon: '<circle class="dm-icon-fill" cx="5.5" cy="18.5" r="2.1"/><path d="M7.2 16.8 18 6"/><path d="M12.2 5.8H18v5.8"/><path d="M5 7.2h4M14.5 18.2h4.5"/>',
  },
  {
    label: 'Graph',
    href: '#primitive-graph',
    primitive: 'graph',
    installMode: undefined,
    ariaLabel: 'Open the graph primitive demo',
    icon: '<path d="M7.2 16.2 11.5 7.8M14.1 7.3l3.1 6.6M8.5 17.7l7.1-1.4"/><circle class="dm-icon-fill" cx="6" cy="17.5" r="2.7"/><circle class="dm-icon-fill" cx="12.5" cy="6" r="2.7"/><circle class="dm-icon-fill" cx="18" cy="15.5" r="2.7"/>',
  },
  {
    label: 'AI',
    href: '#inference',
    primitive: undefined,
    installMode: undefined,
    ariaLabel: 'Jump to the native inference demo',
    icon: '<path class="dm-icon-fill" d="M11 3.2l1.8 5.1 5.1 1.8-5.1 1.8L11 17l-1.8-5.1-5.1-1.8 5.1-1.8z"/><path d="M18.4 14.5l.8 2.3 2.3.8-2.3.8-.8 2.3-.8-2.3-2.3-.8 2.3-.8z"/>',
  },
  {
    label: 'Hub',
    href: '#hub',
    primitive: undefined,
    installMode: undefined,
    hub: true,
    sectionJump: 'hub',
    ariaLabel: 'Jump to the Strata Hub dataset section',
    icon: '<path class="dm-icon-fill" d="M6.2 9.4 12 6l5.8 3.4v6.8L12 19.6l-5.8-3.4z"/><path d="M6.7 9.7 12 12.8l5.3-3.1M12 12.8v6.1"/><path d="M4 6.5 12 2l8 4.5"/>',
  },
];
---

<section id="hero" class="relative overflow-hidden">
  <!-- The living backdrop (2026-06-12): three light fields breathing on the
       neutral stage. Transform-only, GPU-composited, 22–36s periods -
       sanctioned infinite animation #2 (03 §5 amendment). -->
  <div class="hero-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-light hero-light-ember"></div>
    <div class="hero-light hero-light-cool"></div>
    <div class="hero-light hero-light-deep"></div>
    <!-- The branching river (2026-06-12): the product thesis as artwork - a
         trunk forks, strands diverge, one merges back. Energy flows along the
         lines via dashoffset; each strand = wide glow stroke + bright core. -->
    <svg
      class="hero-river absolute inset-0 h-full w-full"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
    >
      {
        [
          {
            d: 'M -40 430 C 280 430 360 430 520 360 C 700 280 900 250 1480 230',
            cls: 'river-ember',
            dur: '7s',
          },
          {
            d: 'M -40 430 C 300 430 420 440 560 500 C 760 590 980 620 1480 600',
            cls: 'river-ember',
            dur: '9s',
          },
          {
            d: 'M -40 430 C 320 432 480 420 640 420 C 880 420 1100 430 1480 425',
            cls: 'river-cool',
            dur: '11s',
          },
          {
            d: 'M 520 360 C 640 320 760 360 880 420 C 1000 480 1100 430 1180 428',
            cls: 'river-ember-dim',
            dur: '8s',
          },
          {
            d: 'M -40 470 C 240 470 400 520 540 560 C 720 610 900 560 1480 660',
            cls: 'river-ember-dim',
            dur: '13s',
          },
        ].map((p) => (
          <>
            <path d={p.d} class={`river-glow ${p.cls}`} style={`--dur: ${p.dur}`} />
            <path d={p.d} class={`river-core ${p.cls}`} style={`--dur: ${p.dur}`} />
          </>
        ))
      }
    </svg>
  </div>
  <div data-parallax="0.85" class="absolute inset-0 will-change-transform">
    <HorizonGlow />
  </div>
  <!-- Content scrim (2026-06-12): quiets the river exactly where the words
       sit - the artwork stays, legibility wins. -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 58% 46% at 50% 36%, rgb(var(--rgb-black) / 0.78), rgb(var(--rgb-black) / 0.35) 55%, transparent 72%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[70rem] px-6 pb-24 pt-20 max-[480px]:px-4 md:pt-28">
    <div class="mb-14 text-center">
      <Badge href="/changelog" class="mb-8">Research preview · v{release.version}</Badge>
      <Heading level={1} size="display-xl" class="mx-auto max-w-[66rem]"
        >An embedded database you can fork</Heading
      >

      <!-- The acquisition control: install is the primary motion; the browser
           playground stays in navigation as a secondary try-before-install path. -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="#install" variant="primary">Install Strata</Button>
        <CopyChip
          value="curl -fsSL https://stratadb.org/install.sh | sh"
          class="!bg-raised [&_.copy-chip-label]:!text-ink-hi"
        />
      </div>
      <!-- The agent door as an ACTION (2026-06-12, pattern: mem0.ai): copies a
           ready-to-paste instruction for the visitor's agent, pointing at the
           agent quickstart's markdown mirror. The human is the courier. -->
      <p class="mt-4">
        <button
          type="button"
          class="copy-chip group inline-flex items-center gap-2.5 rounded-full border border-line bg-panel/90 px-4 py-1.5 font-mono text-mono-sm text-ink-mid transition-colors duration-200 hover:border-line-hover hover:text-ink-hi"
          data-copy="Set up StrataDB in this project by following the instructions at https://stratadb.org/docs/getting-started/quickstart-agents.md - report the verification output when done."
          aria-label="Copy setup instructions for your AI agent"
        >
          <span>Set up with your agent</span>
          <span
            class="copy-chip-icon text-ink-low transition-colors duration-200 group-hover:text-ink-mid"
            aria-hidden="true"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
            </svg>
          </span>
          <span class="copy-chip-done hidden text-ok" aria-hidden="true"
            >✓ copied - paste it to your agent</span
          >
        </button>
      </p>

      <nav
        class="mt-12 flex flex-wrap items-start justify-center gap-x-3 gap-y-4"
        aria-label="Core capabilities"
      >
        {
          dataModel.map((item) => (
            <a
              href={item.href}
              class="dm-tile group"
              data-primitive-link={item.primitive}
              data-install-mode={item.installMode}
              data-hub-link={item.hub}
              data-section-jump={item.sectionJump}
              aria-label={item.ariaLabel}
            >
              <span class="dm-chip">
                <span class="dm-shine" />
                <svg
                  class="dm-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={item.icon}
                />
              </span>
              <span class="dm-label">{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mx-auto max-w-[56rem]">
      <ForkingTerminal client:visible />
    </div>

    <div class="mx-auto mt-14 max-w-[48rem] border-t border-line pt-8 text-center">
      <a
        href="/docs/why-strata"
        class="group inline-flex items-center justify-center gap-3 text-body-lg font-medium text-ink-hi transition-colors duration-200 hover:text-terracotta-300"
      >
        <span>Why does AI application state need a different database?</span>
        <span
          class="translate-y-px text-terracotta-500 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </div>
  </div>
</section>

<style>
  /* Perceptibility fix (2026-06-12): the first cut moved ~0.5%/s - technically
     animated, perceptually static. Now: 11–18s periods, wider travel, and
     opacity breathing (the eye catches luminosity change fastest). Still
     transform/opacity only; still off under reduced motion. */
  .hero-light {
    position: absolute;
    border-radius: 50%;
    will-change: transform, opacity;
  }
  .hero-light-ember {
    width: 58%;
    height: 80%;
    left: 4%;
    top: 0%;
    background: radial-gradient(circle, var(--backdrop-ember), transparent 62%);
    animation: hero-drift-a 14s ease-in-out infinite alternate;
  }
  .hero-light-cool {
    width: 50%;
    height: 70%;
    right: -4%;
    top: 8%;
    background: radial-gradient(circle, var(--backdrop-cool), transparent 60%);
    animation: hero-drift-b 18s ease-in-out infinite alternate;
  }
  .hero-light-deep {
    width: 46%;
    height: 56%;
    left: 26%;
    bottom: -14%;
    background: radial-gradient(circle, var(--backdrop-ember-deep), transparent 65%);
    animation: hero-drift-c 11s ease-in-out infinite alternate;
  }
  @keyframes hero-drift-a {
    from {
      transform: translate3d(-10%, -7%, 0) scale(0.94);
      opacity: 0.55;
    }
    to {
      transform: translate3d(14%, 10%, 0) scale(1.28);
      opacity: 1;
    }
  }
  @keyframes hero-drift-b {
    from {
      transform: translate3d(10%, 8%, 0) scale(1.18);
      opacity: 1;
    }
    to {
      transform: translate3d(-13%, -9%, 0) scale(0.88);
      opacity: 0.5;
    }
  }
  @keyframes hero-drift-c {
    from {
      transform: translate3d(-8%, 5%, 0) scale(0.9);
      opacity: 0.6;
    }
    to {
      transform: translate3d(10%, -8%, 0) scale(1.22);
      opacity: 1;
    }
  }
  html[data-motion='reduced'] .hero-light {
    animation: none;
  }

  /* ---- the data-model index (crafted tiles) ----
     The marks stay white at rest; hover/focus borrows the primary CTA color. */
  .dm-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 5.85rem;
  }
  .dm-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgb(var(--rgb-white) / 0.14);
    background: linear-gradient(
      180deg,
      rgb(var(--rgb-white) / 0.085),
      rgb(var(--rgb-white) / 0.025) 58%,
      rgb(var(--rgb-white) / 0.018)
    );
    box-shadow:
      inset 0 1px 0 rgb(var(--rgb-white) / 0.12),
      inset 0 -12px 24px rgb(var(--rgb-black) / 0.28),
      0 18px 44px -30px rgb(var(--rgb-white) / 0.36);
    color: var(--color-ink-hi);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      color 0.22s ease;
  }
  .dm-shine {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 24%, rgb(var(--rgb-white) / 0.16), transparent 32%),
      linear-gradient(180deg, rgb(var(--rgb-white) / 0.08), transparent 42%);
    opacity: 0.9;
  }
  .dm-icon {
    position: relative;
    z-index: 1;
    width: 34px;
    height: 34px;
    filter: drop-shadow(0 6px 14px rgb(var(--rgb-white) / 0.18));
  }
  .dm-icon-fill {
    fill: currentColor;
    stroke: currentColor;
    opacity: 0.8;
  }
  .dm-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0;
    color: var(--color-ink-hi);
    transition: color 0.22s ease;
  }
  .dm-tile:hover .dm-chip {
    transform: translateY(-4px) scale(1.03);
    border-color: var(--color-terracotta-400);
    background: linear-gradient(
      180deg,
      var(--color-terracotta-400),
      var(--color-terracotta-500) 46%,
      var(--color-terracotta-600)
    );
    box-shadow:
      inset 0 1px 0 rgb(var(--rgb-white) / 0.28),
      inset 0 -14px 24px rgb(var(--rgb-black) / 0.12),
      0 22px 54px -24px rgb(var(--rgb-terracotta-500) / 0.86);
    color: var(--color-void);
  }
  .dm-tile:hover .dm-label {
    color: var(--color-terracotta-500);
  }
  .dm-tile:focus-visible {
    outline: none;
  }
  .dm-tile:focus-visible .dm-chip {
    border-color: var(--color-terracotta-400);
    background: var(--color-terracotta-500);
    color: var(--color-void);
    box-shadow: 0 0 0 2px rgb(var(--rgb-terracotta-500) / 0.45);
  }
  html[data-motion='reduced'] .dm-chip {
    transition:
      border-color 0.22s ease,
      background 0.22s ease,
      color 0.22s ease;
  }
  html[data-motion='reduced'] .dm-tile:hover .dm-chip {
    transform: none;
  }
  @media (max-width: 480px) {
    .dm-tile {
      width: 4.8rem;
    }
    .dm-chip {
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 16px;
    }
    .dm-icon {
      width: 30px;
      height: 30px;
    }
  }

  /* ---- the branching river ---- */
  .hero-river {
    opacity: 0.85;
  }
  .river-glow,
  .river-core {
    stroke-linecap: round;
    fill: none;
  }
  .river-glow {
    stroke-width: 7;
    opacity: 0.25;
  }
  .river-core {
    stroke-width: 1.75;
    opacity: 0.9;
    stroke-dasharray: 90 160;
    animation: river-flow var(--dur, 9s) linear infinite;
  }
  .river-core.river-ember {
    stroke: var(--color-terracotta-400);
  }
  .river-glow.river-ember {
    stroke: var(--color-terracotta-600);
  }
  .river-core.river-ember-dim {
    stroke: var(--color-terracotta-600);
    opacity: 0.6;
  }
  .river-glow.river-ember-dim {
    stroke: var(--color-terracotta-800);
    opacity: 0.18;
  }
  .river-core.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.55;
  }
  .river-glow.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.12;
  }
  @keyframes river-flow {
    to {
      stroke-dashoffset: -250;
    }
  }
  html[data-motion='reduced'] .river-core {
    animation: none;
    stroke-dasharray: none;
    opacity: 0.5;
  }
</style>

<script>
  // Hero parallax: one rAF sampler, transform-only, off for touch + reduced motion,
  // drift clamped to 48px (03 §3.1, §3.3).
  const reduced = document.documentElement.dataset.motion === 'reduced';
  const coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!reduced && !coarse) {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]')).map((el) => ({
      el,
      factor: parseFloat(el.dataset.parallax || '1'),
    }));
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = window.scrollY;
      for (const { el, factor } of els) {
        const drift = Math.max(-48, Math.min(48, y * (1 - factor)));
        el.style.transform = `translate3d(0, ${drift}px, 0)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }

  const primitiveLinks = document.querySelectorAll<HTMLAnchorElement>('[data-primitive-link]');
  for (const link of primitiveLinks) {
    link.addEventListener('click', () => {
      const primitive = link.dataset.primitiveLink;
      if (!primitive) return;

      window.setTimeout(() => {
        window.dispatchEvent(
          new CustomEvent('strata:primitive-request', { detail: { primitive } }),
        );
      }, 0);
    });
  }

  const jumpToSection = (id: string) => {
    const section = document.getElementById(id);
    if (!section) return;

    const html = document.documentElement;
    const previousScrollBehavior = html.style.scrollBehavior;
    const header = document.querySelector('header');
    const offset = header?.getBoundingClientRect().height ?? 0;
    html.style.scrollBehavior = 'auto';
    history.pushState(null, '', `#${id}`);
    window.scrollTo({
      top: Math.round(window.scrollY + section.getBoundingClientRect().top - offset),
      behavior: 'auto',
    });
    window.setTimeout(() => {
      html.style.scrollBehavior = previousScrollBehavior;
    }, 0);
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const sectionLink = target.closest<HTMLAnchorElement>('[data-section-jump]');
    if (sectionLink) {
      const id = sectionLink.dataset.sectionJump;
      if (id) {
        event.preventDefault();
        jumpToSection(id);
        return;
      }
    }

    const link = target.closest<HTMLAnchorElement>('[data-install-mode]');
    if (link) {
      const mode = link.dataset.installMode;
      if (!mode) return;
      event.preventDefault();
      sessionStorage.setItem('install-mode', mode);

      jumpToSection('install');

      window.setTimeout(() => {
        window.dispatchEvent(new CustomEvent('strata:install-mode-request', { detail: { mode } }));
      }, 0);
    }
  });
</script>
