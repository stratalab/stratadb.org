---
// Section 1: badge -> H1 -> CTAs -> the four doors (Playground, Game of Life,
// Orbital Rocketry, Hub - see HeroDoors.astro).
// (Stat strip removed 2026-06-12, Ani - the benchmark claims leave the hero;
// benchmarks.json remains for the specimen/docs.)
// (03 §3.1): the backdrop glow drifts at 0.85x; nothing else parallaxes here.
import Badge from '../foundation/Badge.astro';
import HeroDoors from './HeroDoors.astro';
import Heading from '../foundation/Heading.astro';
import Button from '../foundation/Button.astro';
import CopyChip from '../foundation/CopyChip.astro';
import HorizonGlow from '../foundation/HorizonGlow.astro';
import release from '../../data/release.json';
---

<!-- Fills the first screen, the way every section below it fills one.
     The hero was the only one without a height floor, so its box was
     whatever its content happened to measure - 1057px at every
     viewport - and on any display taller than that it stopped short
     while the sections after it ran the full height.

     100svh minus the nav rather than a bare 100svh: the header is
     sticky and in flow, so it sits above the hero rather than over it
     the way it does for the others. 4rem is the offset the rest of the
     page already uses for it (scroll-mt-16). -->
<section
  id="hero"
  class="relative flex min-h-[calc(100svh-4rem)] flex-col justify-center overflow-hidden"
>
  <!-- The living backdrop (2026-06-12): three light fields breathing on the
       neutral stage. Transform-only, GPU-composited, 22–36s periods -
       sanctioned infinite animation #2 (03 §5 amendment). -->
  <div class="hero-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-light hero-light-ember"></div>
    <div class="hero-light hero-light-cool"></div>
    <div class="hero-light hero-light-deep"></div>
    <!-- The branching river (2026-06-12): the product thesis as artwork - a
         trunk forks, strands diverge, one merges back. Energy flows along the
         lines via dashoffset; each strand = wide glow stroke + bright core. -->
    <svg
      class="hero-river absolute inset-0 h-full w-full"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
    >
      {
        [
          {
            d: 'M -40 430 C 280 430 360 430 520 360 C 700 280 900 250 1480 230',
            cls: 'river-ember',
            dur: '7s',
          },
          {
            d: 'M -40 430 C 300 430 420 440 560 500 C 760 590 980 620 1480 600',
            cls: 'river-ember',
            dur: '9s',
          },
          {
            d: 'M -40 430 C 320 432 480 420 640 420 C 880 420 1100 430 1480 425',
            cls: 'river-cool',
            dur: '11s',
          },
          {
            d: 'M 520 360 C 640 320 760 360 880 420 C 1000 480 1100 430 1180 428',
            cls: 'river-ember-dim',
            dur: '8s',
          },
          {
            d: 'M -40 470 C 240 470 400 520 540 560 C 720 610 900 560 1480 660',
            cls: 'river-ember-dim',
            dur: '13s',
          },
        ].map((p) => (
          <>
            <path d={p.d} class={`river-glow ${p.cls}`} style={`--dur: ${p.dur}`} />
            <path d={p.d} class={`river-core ${p.cls}`} style={`--dur: ${p.dur}`} />
          </>
        ))
      }
    </svg>
  </div>
  <div data-parallax="0.85" class="absolute inset-0 will-change-transform">
    <HorizonGlow />
  </div>
  <!-- Content scrim (2026-06-12): quiets the river exactly where the words
       sit - the artwork stays, legibility wins. -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 58% 46% at 50% 36%, rgb(var(--rgb-black) / 0.78), rgb(var(--rgb-black) / 0.35) 55%, transparent 72%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[70rem] px-6 pb-12 pt-20 max-[480px]:px-4 md:pt-12">
    <div class="mb-5 text-center">
      <Badge href="/changelog" class="mb-6">Research preview · v{release.version}</Badge>
      <Heading level={1} size="display-xl" class="mx-auto max-w-[66rem]"
        >The database for vibecoders</Heading
      >
      <p class="mx-auto mt-6 max-w-[40rem] text-body-lg text-ink-mid">
        Zero setup. Zero infrastructure. Just build.
      </p>

      <!-- The acquisition control: install is the primary motion; the browser
           playground stays in navigation as a secondary try-before-install path. -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="#install" variant="primary">Install Strata</Button>
        <CopyChip
          value="curl -fsSL https://stratadb.org/install.sh | sh"
          class="!bg-raised [&_.copy-chip-label]:!text-ink-hi"
        />
      </div>
      <!-- The agent door as an ACTION (2026-06-12, pattern: mem0.ai): copies a
           ready-to-paste instruction for the visitor's agent, pointing at the
           agent quickstart's markdown mirror. The human is the courier. -->
      <p class="mt-4">
        <button
          type="button"
          class="copy-chip group inline-flex items-center gap-2.5 rounded-full border border-line bg-panel/90 px-4 py-1.5 font-mono text-mono-sm text-ink-mid transition-colors duration-200 hover:border-line-hover hover:text-ink-hi"
          data-copy="Set up StrataDB in this project by following the instructions at https://stratadb.org/docs/get-started/agents - report the verification output when done."
          aria-label="Copy setup instructions for your AI agent"
        >
          <span>Set up with your agent</span>
          <span
            class="copy-chip-icon text-ink-low transition-colors duration-200 group-hover:text-ink-mid"
            aria-hidden="true"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
            </svg>
          </span>
          <span class="copy-chip-done hidden text-ok" aria-hidden="true"
            >✓ copied - paste it to your agent</span
          >
        </button>
      </p>
    </div>

    <HeroDoors />
  </div>
</section>

<style>
  /* Perceptibility fix (2026-06-12): the first cut moved ~0.5%/s - technically
     animated, perceptually static. Now: 11–18s periods, wider travel, and
     opacity breathing (the eye catches luminosity change fastest). Still
     transform/opacity only; still off under reduced motion. */
  .hero-light {
    position: absolute;
    border-radius: 50%;
    will-change: transform, opacity;
  }
  .hero-light-ember {
    width: 58%;
    height: 80%;
    left: 4%;
    top: 0%;
    background: radial-gradient(circle, var(--backdrop-ember), transparent 62%);
    animation: hero-drift-a 14s ease-in-out infinite alternate;
  }
  .hero-light-cool {
    width: 50%;
    height: 70%;
    right: -4%;
    top: 8%;
    background: radial-gradient(circle, var(--backdrop-cool), transparent 60%);
    animation: hero-drift-b 18s ease-in-out infinite alternate;
  }
  .hero-light-deep {
    width: 46%;
    height: 56%;
    left: 26%;
    bottom: -14%;
    background: radial-gradient(circle, var(--backdrop-ember-deep), transparent 65%);
    animation: hero-drift-c 11s ease-in-out infinite alternate;
  }
  @keyframes hero-drift-a {
    from {
      transform: translate3d(-10%, -7%, 0) scale(0.94);
      opacity: 0.55;
    }
    to {
      transform: translate3d(14%, 10%, 0) scale(1.28);
      opacity: 1;
    }
  }
  @keyframes hero-drift-b {
    from {
      transform: translate3d(10%, 8%, 0) scale(1.18);
      opacity: 1;
    }
    to {
      transform: translate3d(-13%, -9%, 0) scale(0.88);
      opacity: 0.5;
    }
  }
  @keyframes hero-drift-c {
    from {
      transform: translate3d(-8%, 5%, 0) scale(0.9);
      opacity: 0.6;
    }
    to {
      transform: translate3d(10%, -8%, 0) scale(1.22);
      opacity: 1;
    }
  }
  html[data-motion='reduced'] .hero-light {
    animation: none;
  }

  /* ---- the branching river ---- */
  .hero-river {
    opacity: 0.85;
  }
  .river-glow,
  .river-core {
    stroke-linecap: round;
    fill: none;
  }
  .river-glow {
    stroke-width: 7;
    opacity: 0.25;
  }
  .river-core {
    stroke-width: 1.75;
    opacity: 0.9;
    stroke-dasharray: 90 160;
    animation: river-flow var(--dur, 9s) linear infinite;
  }
  .river-core.river-ember {
    stroke: var(--color-terracotta-400);
  }
  .river-glow.river-ember {
    stroke: var(--color-terracotta-600);
  }
  .river-core.river-ember-dim {
    stroke: var(--color-terracotta-600);
    opacity: 0.6;
  }
  .river-glow.river-ember-dim {
    stroke: var(--color-terracotta-800);
    opacity: 0.18;
  }
  .river-core.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.55;
  }
  .river-glow.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.12;
  }
  @keyframes river-flow {
    to {
      stroke-dashoffset: -250;
    }
  }
  html[data-motion='reduced'] .river-core {
    animation: none;
    stroke-dasharray: none;
    opacity: 0.5;
  }
</style>

<script>
  // Hero parallax: one rAF sampler, transform-only, off for touch + reduced motion,
  // drift clamped to 48px (03 §3.1, §3.3).
  const reduced = document.documentElement.dataset.motion === 'reduced';
  const coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!reduced && !coarse) {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]')).map((el) => ({
      el,
      factor: parseFloat(el.dataset.parallax || '1'),
    }));
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = window.scrollY;
      for (const { el, factor } of els) {
        const drift = Math.max(-48, Math.min(48, y * (1 - factor)));
        el.style.transform = `translate3d(0, ${drift}px, 0)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }

  const jumpToSection = (id: string) => {
    const section = document.getElementById(id);
    if (!section) return;

    const html = document.documentElement;
    const previousScrollBehavior = html.style.scrollBehavior;
    const header = document.querySelector('header');
    const offset = header?.getBoundingClientRect().height ?? 0;
    html.style.scrollBehavior = 'auto';
    history.pushState(null, '', `#${id}`);
    window.scrollTo({
      top: Math.round(window.scrollY + section.getBoundingClientRect().top - offset),
      behavior: 'auto',
    });
    window.setTimeout(() => {
      html.style.scrollBehavior = previousScrollBehavior;
    }, 0);
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const sectionLink = target.closest<HTMLAnchorElement>('[data-section-jump]');
    if (sectionLink) {
      const id = sectionLink.dataset.sectionJump;
      if (id) {
        event.preventDefault();
        jumpToSection(id);
        return;
      }
    }

    const link = target.closest<HTMLAnchorElement>('[data-install-mode]');
    if (link) {
      const mode = link.dataset.installMode;
      if (!mode) return;
      event.preventDefault();
      sessionStorage.setItem('install-mode', mode);

      jumpToSection('install');

      window.setTimeout(() => {
        window.dispatchEvent(new CustomEvent('strata:install-mode-request', { detail: { mode } }));
      }, 0);
    }
  });
</script>
