---
// Section 1: badge → H1 → CTAs → data-model index → set-piece.
// (Stat strip removed 2026-06-12, Ani - the benchmark claims leave the hero;
// benchmarks.json remains for the specimen/docs.) Parallax site #1 of 2
// (03 §3.1): glow 0.85× · terminal 1.0×.
import Badge from '../foundation/Badge.astro';
import Heading from '../foundation/Heading.astro';
import Button from '../foundation/Button.astro';
import CopyChip from '../foundation/CopyChip.astro';
import HorizonGlow from '../foundation/HorizonGlow.astro';
import release from '../../data/release.json';

// The five data models, each one a script the visitor can run. The tiles used
// to be links: five scrolled to a mock IDE further down the page and two jumped
// to other sections, which is a table of contents wearing the clothes of a
// demo. They now drive the panel underneath, against the real engine compiled
// to wasm, in the visitor's own browser.
//
// Every script is verified to run in that wasm build at 1.2.1, and every one
// ends on the same beat: fork the database, change the fork, read both sides.
// That is the product's actual claim, told five times in five vocabularies.
//
// AI and Hub used to sit in this row. Neither is compiled into the wasm build:
// `hub` answers "needs a host environment and is not available in an embedded
// session" and `inference` is not a command there at all. They keep their own
// sections further down the page rather than being the two tiles that cannot
// do what the other five now do.
//
// Note the single quotes around JSON literals. The embedded arg splitter eats
// double quotes, so `{"id":7}` arrives as `{id:7}` and fails to parse.
const dataModel = [
  {
    label: 'KV',
    key: 'kv',
    ariaLabel: 'Run the key-value demo',
    icon: '<circle class="dm-icon-fill" cx="7" cy="12" r="4"/><path d="M10.7 12h9.8"/><path d="M15.8 12v4M19 12v3"/>',
    script: [
      'kv put portfolio.cash 10',
      'branch fork default risky',
      '--branch risky kv put portfolio.cash 5',
      'kv get portfolio.cash',
      '--branch risky kv get portfolio.cash',
    ],
  },
  {
    label: 'Event',
    key: 'event',
    ariaLabel: 'Run the event log demo',
    icon: '<path class="dm-icon-fill" d="M4 17.5h16v2H4z"/><path d="M4 13h3.5l1.9-6.2 3.5 11.6 2.3-7.1 1.6 3.4H20"/>',
    script: [
      'event append order.placed \'{"id":7}\'',
      'event append order.shipped \'{"id":7}\'',
      'event verify-chain',
    ],
  },
  {
    label: 'JSON',
    key: 'json',
    ariaLabel: 'Run the JSON document demo',
    icon: '<path d="M8.7 4.2c-1.7 0-2.5.9-2.5 2.7v2.2c0 1.4-.7 2.3-2 2.9 1.3.6 2 1.5 2 2.9v2.2c0 1.8.8 2.7 2.5 2.7"/><path d="M15.3 4.2c1.7 0 2.5.9 2.5 2.7v2.2c0 1.4.7 2.3 2 2.9-1.3.6-2 1.5-2 2.9v2.2c0 1.8-.8 2.7-2.5 2.7"/><circle class="dm-icon-fill" cx="12" cy="12" r="2"/>',
    script: [
      'json set user:ada $ \'{"name":"Ada","role":"engineer"}\'',
      'branch fork default promo',
      '--branch promo json set user:ada $.role \'"director"\'',
      '--branch promo json get user:ada $.role',
      'json get user:ada $.role',
    ],
  },
  {
    label: 'Vector',
    key: 'vector',
    ariaLabel: 'Run the vector search demo',
    icon: '<circle class="dm-icon-fill" cx="5.5" cy="18.5" r="2.1"/><path d="M7.2 16.8 18 6"/><path d="M12.2 5.8H18v5.8"/><path d="M5 7.2h4M14.5 18.2h4.5"/>',
    script: [
      'vector collection create docs 3',
      'vector upsert docs d1 [1,0,0]',
      'vector upsert docs d2 [0,1,0]',
      'vector query docs [1,0,0]',
    ],
  },
  {
    label: 'Graph',
    key: 'graph',
    ariaLabel: 'Run the graph traversal demo',
    icon: '<path d="M7.2 16.2 11.5 7.8M14.1 7.3l3.1 6.6M8.5 17.7l7.1-1.4"/><circle class="dm-icon-fill" cx="6" cy="17.5" r="2.7"/><circle class="dm-icon-fill" cx="12.5" cy="6" r="2.7"/><circle class="dm-icon-fill" cx="18" cy="15.5" r="2.7"/>',
    script: [
      'graph create social',
      'graph add-node social alice',
      'graph add-node social bob',
      'graph add-edge social alice knows bob',
      'branch fork default expand',
      '--branch expand graph add-node social carol',
      '--branch expand graph add-edge social bob knows carol',
      '--branch expand graph bfs social alice',
      'graph bfs social alice',
    ],
  },
];
---

<section id="hero" class="relative overflow-hidden">
  <!-- The living backdrop (2026-06-12): three light fields breathing on the
       neutral stage. Transform-only, GPU-composited, 22–36s periods -
       sanctioned infinite animation #2 (03 §5 amendment). -->
  <div class="hero-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-light hero-light-ember"></div>
    <div class="hero-light hero-light-cool"></div>
    <div class="hero-light hero-light-deep"></div>
    <!-- The branching river (2026-06-12): the product thesis as artwork - a
         trunk forks, strands diverge, one merges back. Energy flows along the
         lines via dashoffset; each strand = wide glow stroke + bright core. -->
    <svg
      class="hero-river absolute inset-0 h-full w-full"
      viewBox="0 0 1440 900"
      fill="none"
      preserveAspectRatio="xMidYMid slice"
    >
      {
        [
          {
            d: 'M -40 430 C 280 430 360 430 520 360 C 700 280 900 250 1480 230',
            cls: 'river-ember',
            dur: '7s',
          },
          {
            d: 'M -40 430 C 300 430 420 440 560 500 C 760 590 980 620 1480 600',
            cls: 'river-ember',
            dur: '9s',
          },
          {
            d: 'M -40 430 C 320 432 480 420 640 420 C 880 420 1100 430 1480 425',
            cls: 'river-cool',
            dur: '11s',
          },
          {
            d: 'M 520 360 C 640 320 760 360 880 420 C 1000 480 1100 430 1180 428',
            cls: 'river-ember-dim',
            dur: '8s',
          },
          {
            d: 'M -40 470 C 240 470 400 520 540 560 C 720 610 900 560 1480 660',
            cls: 'river-ember-dim',
            dur: '13s',
          },
        ].map((p) => (
          <>
            <path d={p.d} class={`river-glow ${p.cls}`} style={`--dur: ${p.dur}`} />
            <path d={p.d} class={`river-core ${p.cls}`} style={`--dur: ${p.dur}`} />
          </>
        ))
      }
    </svg>
  </div>
  <div data-parallax="0.85" class="absolute inset-0 will-change-transform">
    <HorizonGlow />
  </div>
  <!-- Content scrim (2026-06-12): quiets the river exactly where the words
       sit - the artwork stays, legibility wins. -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 58% 46% at 50% 36%, rgb(var(--rgb-black) / 0.78), rgb(var(--rgb-black) / 0.35) 55%, transparent 72%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[70rem] px-6 pb-20 pt-10 max-[480px]:px-4 md:pt-12">
    <div class="mb-5 text-center">
      <Badge href="/changelog" class="mb-6">Research preview · v{release.version}</Badge>
      <Heading level={1} size="display-xl" class="mx-auto max-w-[66rem]"
        >The database for vibecoders</Heading
      >
      <p class="mx-auto mt-6 max-w-[40rem] text-body-lg text-ink-mid">
        Zero setup. Zero infrastructure. Just build.
      </p>

      <!-- The acquisition control: install is the primary motion; the browser
           playground stays in navigation as a secondary try-before-install path. -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="#install" variant="primary">Install Strata</Button>
        <CopyChip
          value="curl -fsSL https://stratadb.org/install.sh | sh"
          class="!bg-raised [&_.copy-chip-label]:!text-ink-hi"
        />
      </div>
      <!-- The agent door as an ACTION (2026-06-12, pattern: mem0.ai): copies a
           ready-to-paste instruction for the visitor's agent, pointing at the
           agent quickstart's markdown mirror. The human is the courier. -->
      <p class="mt-4">
        <button
          type="button"
          class="copy-chip group inline-flex items-center gap-2.5 rounded-full border border-line bg-panel/90 px-4 py-1.5 font-mono text-mono-sm text-ink-mid transition-colors duration-200 hover:border-line-hover hover:text-ink-hi"
          data-copy="Set up StrataDB in this project by following the instructions at https://stratadb.org/docs/get-started/agents - report the verification output when done."
          aria-label="Copy setup instructions for your AI agent"
        >
          <span>Set up with your agent</span>
          <span
            class="copy-chip-icon text-ink-low transition-colors duration-200 group-hover:text-ink-mid"
            aria-hidden="true"
          >
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
            </svg>
          </span>
          <span class="copy-chip-done hidden text-ok" aria-hidden="true"
            >✓ copied - paste it to your agent</span
          >
        </button>
      </p>

      <div
        class="mt-6 flex flex-wrap items-start justify-center gap-x-3 gap-y-4"
        role="tablist"
        aria-label="Run a data model"
      >
        {
          dataModel.map((item, i) => (
            <button
              type="button"
              class="dm-tile group"
              role="tab"
              id={`dm-tab-${item.key}`}
              aria-controls="hero-demo-out"
              aria-selected="false"
              tabindex={i === 0 ? 0 : -1}
              data-demo={item.key}
              data-script={JSON.stringify(item.script)}
              aria-label={item.ariaLabel}
            >
              <span class="dm-chip">
                <span class="dm-shine" />
                <svg
                  class="dm-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={item.icon}
                />
              </span>
              <span class="dm-label">{item.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="mx-auto max-w-[56rem]">
      <div class="hero-demo">
        <div class="hero-demo-bar">
          <span class="hero-demo-dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <span class="hero-demo-title">strata</span>
          <span class="hero-demo-badge" data-demo-status> in your browser </span>
          <a
            class="hero-demo-open"
            href="/playground"
            aria-label="Open this session in the full playground"
            title="Open the full playground"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 4h6v6"></path>
              <path d="M20 4 11 13"></path>
              <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
            </svg>
          </a>
        </div>
        <pre
          id="hero-demo-out"
          class="hero-demo-out"
          role="tabpanel"
          tabindex="0"
          aria-live="polite"
          aria-label="Demo output"><span class="hero-demo-rest">Pick a data model above, or type a command. It runs here, on the real engine, in this tab.</span></pre>
        <form class="hero-demo-form" data-demo-form>
          <label class="sr-only" for="hero-demo-input">Strata command</label>
          <span class="hero-demo-prompt" data-demo-prompt aria-hidden="true"
            >strata:default &rsaquo;</span
          >
          <input
            id="hero-demo-input"
            class="hero-demo-input"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="kv get portfolio.cash"
            data-demo-input
          />
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* The live demo panel. A terminal that is actually a terminal: the fork
     output really is sixteen lines of JSON, so the body scrolls and follows
     rather than being trimmed into something tidier than the truth. */
  .hero-demo {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    background: var(--color-panel);
    overflow: hidden;
  }
  .hero-demo-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-raised);
  }
  .hero-demo-dots {
    display: inline-flex;
    gap: 0.375rem;
  }
  .hero-demo-dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    background: var(--color-line-hover);
  }
  .hero-demo-title,
  .hero-demo-badge {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-mono-sm, 0.8125rem);
    color: var(--color-ink-low);
  }
  .hero-demo-badge {
    margin-left: auto;
    white-space: nowrap;
  }
  .hero-demo-out {
    margin: 0;
    padding: 1.25rem 1.25rem 1.5rem;
    height: 17rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-mid);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    text-align: left;
    scrollbar-width: thin;
  }
  .hero-demo-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.375rem;
    border-radius: var(--radius-control);
    color: var(--color-ink-low);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .hero-demo-open:hover {
    color: var(--color-ink-hi);
    background: var(--color-panel);
  }
  .hero-demo-open svg {
    width: 1rem;
    height: 1rem;
  }
  .hero-demo-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    height: 3rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-raised);
  }
  .hero-demo-prompt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9375rem;
    color: var(--color-terracotta-400);
    white-space: nowrap;
  }
  .hero-demo-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    padding: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9375rem;
    color: var(--color-ink-hi);
  }
  .hero-demo-input::placeholder {
    color: var(--color-ink-low);
  }
  .hero-demo-form:focus-within {
    background: var(--color-panel);
  }
  .hero-demo-rest {
    color: var(--color-ink-low);
  }
  .hero-demo-cmd {
    color: var(--color-ink-hi);
    font-weight: 500;
  }
  .hero-demo-res {
    color: var(--color-ink-mid);
  }
  .hero-demo-err {
    color: var(--color-terracotta-300);
  }
  .dm-tile[aria-selected='true'] .dm-chip {
    border-color: var(--color-terracotta-500);
  }
  @media (max-width: 640px) {
    .hero-demo-out {
      height: 13rem;
      font-size: 0.875rem;
    }
  }

  /* Perceptibility fix (2026-06-12): the first cut moved ~0.5%/s - technically
     animated, perceptually static. Now: 11–18s periods, wider travel, and
     opacity breathing (the eye catches luminosity change fastest). Still
     transform/opacity only; still off under reduced motion. */
  .hero-light {
    position: absolute;
    border-radius: 50%;
    will-change: transform, opacity;
  }
  .hero-light-ember {
    width: 58%;
    height: 80%;
    left: 4%;
    top: 0%;
    background: radial-gradient(circle, var(--backdrop-ember), transparent 62%);
    animation: hero-drift-a 14s ease-in-out infinite alternate;
  }
  .hero-light-cool {
    width: 50%;
    height: 70%;
    right: -4%;
    top: 8%;
    background: radial-gradient(circle, var(--backdrop-cool), transparent 60%);
    animation: hero-drift-b 18s ease-in-out infinite alternate;
  }
  .hero-light-deep {
    width: 46%;
    height: 56%;
    left: 26%;
    bottom: -14%;
    background: radial-gradient(circle, var(--backdrop-ember-deep), transparent 65%);
    animation: hero-drift-c 11s ease-in-out infinite alternate;
  }
  @keyframes hero-drift-a {
    from {
      transform: translate3d(-10%, -7%, 0) scale(0.94);
      opacity: 0.55;
    }
    to {
      transform: translate3d(14%, 10%, 0) scale(1.28);
      opacity: 1;
    }
  }
  @keyframes hero-drift-b {
    from {
      transform: translate3d(10%, 8%, 0) scale(1.18);
      opacity: 1;
    }
    to {
      transform: translate3d(-13%, -9%, 0) scale(0.88);
      opacity: 0.5;
    }
  }
  @keyframes hero-drift-c {
    from {
      transform: translate3d(-8%, 5%, 0) scale(0.9);
      opacity: 0.6;
    }
    to {
      transform: translate3d(10%, -8%, 0) scale(1.22);
      opacity: 1;
    }
  }
  html[data-motion='reduced'] .hero-light {
    animation: none;
  }

  /* ---- the data-model index (crafted tiles) ----
     The marks stay white at rest; hover/focus borrows the primary CTA color. */
  .dm-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 5.85rem;
  }
  .dm-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgb(var(--rgb-white) / 0.14);
    background: linear-gradient(
      180deg,
      rgb(var(--rgb-white) / 0.085),
      rgb(var(--rgb-white) / 0.025) 58%,
      rgb(var(--rgb-white) / 0.018)
    );
    box-shadow:
      inset 0 1px 0 rgb(var(--rgb-white) / 0.12),
      inset 0 -12px 24px rgb(var(--rgb-black) / 0.28),
      0 18px 44px -30px rgb(var(--rgb-white) / 0.36);
    color: var(--color-ink-hi);
    transition:
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease,
      color 0.22s ease;
  }
  .dm-shine {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 24%, rgb(var(--rgb-white) / 0.16), transparent 32%),
      linear-gradient(180deg, rgb(var(--rgb-white) / 0.08), transparent 42%);
    opacity: 0.9;
  }
  .dm-icon {
    position: relative;
    z-index: 1;
    width: 34px;
    height: 34px;
    filter: drop-shadow(0 6px 14px rgb(var(--rgb-white) / 0.18));
  }
  .dm-icon-fill {
    fill: currentColor;
    stroke: currentColor;
    opacity: 0.8;
  }
  .dm-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0;
    color: var(--color-ink-hi);
    transition: color 0.22s ease;
  }
  .dm-tile:hover .dm-chip {
    transform: translateY(-4px) scale(1.03);
    border-color: var(--color-terracotta-400);
    background: linear-gradient(
      180deg,
      var(--color-terracotta-400),
      var(--color-terracotta-500) 46%,
      var(--color-terracotta-600)
    );
    box-shadow:
      inset 0 1px 0 rgb(var(--rgb-white) / 0.28),
      inset 0 -14px 24px rgb(var(--rgb-black) / 0.12),
      0 22px 54px -24px rgb(var(--rgb-terracotta-500) / 0.86);
    color: var(--color-void);
  }
  .dm-tile:hover .dm-label {
    color: var(--color-terracotta-500);
  }
  .dm-tile:focus-visible {
    outline: none;
  }
  .dm-tile:focus-visible .dm-chip {
    border-color: var(--color-terracotta-400);
    background: var(--color-terracotta-500);
    color: var(--color-void);
    box-shadow: 0 0 0 2px rgb(var(--rgb-terracotta-500) / 0.45);
  }
  html[data-motion='reduced'] .dm-chip {
    transition:
      border-color 0.22s ease,
      background 0.22s ease,
      color 0.22s ease;
  }
  html[data-motion='reduced'] .dm-tile:hover .dm-chip {
    transform: none;
  }
  @media (max-width: 480px) {
    .dm-tile {
      width: 4.8rem;
    }
    .dm-chip {
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 16px;
    }
    .dm-icon {
      width: 30px;
      height: 30px;
    }
  }

  /* ---- the branching river ---- */
  .hero-river {
    opacity: 0.85;
  }
  .river-glow,
  .river-core {
    stroke-linecap: round;
    fill: none;
  }
  .river-glow {
    stroke-width: 7;
    opacity: 0.25;
  }
  .river-core {
    stroke-width: 1.75;
    opacity: 0.9;
    stroke-dasharray: 90 160;
    animation: river-flow var(--dur, 9s) linear infinite;
  }
  .river-core.river-ember {
    stroke: var(--color-terracotta-400);
  }
  .river-glow.river-ember {
    stroke: var(--color-terracotta-600);
  }
  .river-core.river-ember-dim {
    stroke: var(--color-terracotta-600);
    opacity: 0.6;
  }
  .river-glow.river-ember-dim {
    stroke: var(--color-terracotta-800);
    opacity: 0.18;
  }
  .river-core.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.55;
  }
  .river-glow.river-cool {
    stroke: var(--color-river-cool);
    opacity: 0.12;
  }
  @keyframes river-flow {
    to {
      stroke-dashoffset: -250;
    }
  }
  html[data-motion='reduced'] .river-core {
    animation: none;
    stroke-dasharray: none;
    opacity: 0.5;
  }
</style>

<script>
  // Hero parallax: one rAF sampler, transform-only, off for touch + reduced motion,
  // drift clamped to 48px (03 §3.1, §3.3).
  const reduced = document.documentElement.dataset.motion === 'reduced';
  const coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!reduced && !coarse) {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]')).map((el) => ({
      el,
      factor: parseFloat(el.dataset.parallax || '1'),
    }));
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = window.scrollY;
      for (const { el, factor } of els) {
        const drift = Math.max(-48, Math.min(48, y * (1 - factor)));
        el.style.transform = `translate3d(0, ${drift}px, 0)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }

  // The live demo. The tiles run their script against the real engine compiled
  // to wasm, in this tab, in a database that exists only here.
  //
  // The 8MB module is not fetched until the first tile is pressed: it is the
  // payoff for an interaction, never a tax on arriving. Everything is real, so
  // when the engine cannot load we say so rather than falling back to a canned
  // transcript pretending to be a session.
  const demoOut = document.getElementById('hero-demo-out');
  const demoTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo]'));

  if (demoOut && demoTabs.length) {
    const status = document.querySelector<HTMLElement>('[data-demo-status]');
    const reduced = document.documentElement.dataset.motion === 'reduced';
    // The wasm module is loaded at runtime from public/, so there are no types
    // to import for it. Name the two members we touch instead of reaching for
    // `any`.
    type Engine = {
      StrataSession: new () => {
        executeCli: (line: string) => string;
        readonly branch: string;
        setBranch: (branch: string) => void;
        close?: () => void;
      };
      engineVersion: () => string;
    };
    let enginePromise: Promise<Engine> | null = null;
    let runToken = 0;
    // The session outlives the script. A tile leaves a database behind with
    // real state in it, and the prompt below carries on in that same session,
    // which is the whole reason to run the engine rather than replay a
    // transcript: `kv get portfolio.cash` still answers 10 afterwards.
    type Session = InstanceType<Engine['StrataSession']>;
    let session: Session | null = null;

    const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
    const input = document.querySelector<HTMLInputElement>('[data-demo-input]');
    const prompt = document.querySelector<HTMLElement>('[data-demo-prompt]');
    const past: string[] = [];
    let pastAt = 0;

    // The prompt shows the branch the session is actually on, so the reader
    // can see `--branch risky` land somewhere real.
    const syncPrompt = () => {
      if (!prompt) return;
      const branch = session?.branch ?? 'default';
      prompt.textContent = `strata:${branch} \u203a`;
    };

    const write = (text: string, cls?: string) => {
      const span = document.createElement('span');
      if (cls) span.className = cls;
      span.textContent = text;
      demoOut.appendChild(span);
      demoOut.scrollTop = demoOut.scrollHeight;
    };

    const pause = (ms: number) =>
      reduced ? Promise.resolve() : new Promise((r) => window.setTimeout(r, ms));

    const loadEngine = () => {
      if (!enginePromise) {
        enginePromise = (async () => {
          // Through a variable: the bundle lives in public/, so a literal
          // specifier here is a module the compiler cannot resolve.
          const pkg = '/playground/pkg/strata_wasm.js';
          const mod = (await import(/* @vite-ignore */ pkg)) as unknown as Engine & {
            default: () => Promise<unknown>;
          };
          await mod.default();
          return mod;
        })().catch((error) => {
          enginePromise = null;
          throw error;
        });
      }
      return enginePromise;
    };

    const run = async (tab: HTMLButtonElement) => {
      const token = ++runToken;
      const script: string[] = JSON.parse(tab.dataset.script || '[]');

      for (const other of demoTabs) {
        const on = other === tab;
        other.setAttribute('aria-selected', on ? 'true' : 'false');
        other.tabIndex = on ? 0 : -1;
      }

      demoOut.textContent = '';
      if (status) status.textContent = 'starting the engine';

      const panel = demoOut.parentElement;
      if (panel) {
        const box = panel.getBoundingClientRect();
        if (box.bottom > window.innerHeight) {
          panel.scrollIntoView({
            behavior: reduced ? 'auto' : 'smooth',
            block: 'end',
          });
        }
      }

      let mod;
      try {
        mod = await loadEngine();
      } catch (error) {
        if (token !== runToken) return;
        if (status) status.textContent = 'engine unavailable';
        write(
          'Could not load the Strata engine: ' +
            ((error as Error)?.message ?? String(error)) +
            '\n',
          'hero-demo-err',
        );
        return;
      }
      if (token !== runToken) return;

      session?.close?.();
      session = new mod.StrataSession();
      if (status) status.textContent = 'strata ' + mod.engineVersion();
      syncPrompt();

      for (const line of script) {
        if (token !== runToken) break;
        write('$ ' + line + '\n', 'hero-demo-cmd');
        await pause(220);
        if (token !== runToken) break;
        let output: string;
        try {
          output = session.executeCli(line);
        } catch (error) {
          output = String((error as Error)?.message ?? error);
        }
        const body = (output ?? '').toString().replace(/\s+$/, '');
        if (body) write(body + '\n', 'hero-demo-res');
        await pause(300);
      }

      if (token === runToken) {
        syncPrompt();
        if (input) input.disabled = false;
      }
    };

    const submit = async (line: string) => {
      runToken++; // a typed command outranks a script still streaming
      const rest = demoOut.querySelector('.hero-demo-rest');
      if (rest) demoOut.textContent = '';

      write('$ ' + line + '\n', 'hero-demo-cmd');
      if (!session) {
        if (status) status.textContent = 'starting the engine';
        try {
          const mod = await loadEngine();
          session = new mod.StrataSession();
          if (status) status.textContent = 'strata ' + mod.engineVersion();
        } catch (error) {
          if (status) status.textContent = 'engine unavailable';
          write(
            'Could not load the Strata engine: ' +
              ((error as Error)?.message ?? String(error)) +
              '\n',
            'hero-demo-err',
          );
          return;
        }
      }

      const useBranch = /^use\s+(\S+)\s*$/.exec(line);
      if (useBranch) {
        try {
          session.setBranch(useBranch[1]);
          write('now on ' + useBranch[1] + '\n', 'hero-demo-res');
        } catch (error) {
          write(String((error as Error)?.message ?? error) + '\n', 'hero-demo-err');
        }
        syncPrompt();
        return;
      }

      let output: string;
      try {
        output = session.executeCli(line);
      } catch (error) {
        output = String((error as Error)?.message ?? error);
      }
      const body = (output ?? '').toString().replace(/\s+$/, '');
      if (body) write(body + '\n', 'hero-demo-res');
      syncPrompt();
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const line = input?.value.trim();
      if (!line || !input) return;
      past.push(line);
      pastAt = past.length;
      input.value = '';
      void submit(line);
    });

    // Up and down walk what you have already run, as a shell would.
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' && pastAt > 0) {
        pastAt--;
        input.value = past[pastAt];
        event.preventDefault();
      } else if (event.key === 'ArrowDown') {
        if (pastAt < past.length - 1) {
          pastAt++;
          input.value = past[pastAt];
        } else {
          pastAt = past.length;
          input.value = '';
        }
        event.preventDefault();
      }
    });

    syncPrompt();

    for (const tab of demoTabs) {
      tab.addEventListener('click', () => void run(tab));
    }

    // Roving focus, so the row behaves like the tablist it now is.
    for (const [i, tab] of demoTabs.entries()) {
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = demoTabs[(i + step + demoTabs.length) % demoTabs.length];
        next.focus();
        void run(next);
      });
    }
  }

  const jumpToSection = (id: string) => {
    const section = document.getElementById(id);
    if (!section) return;

    const html = document.documentElement;
    const previousScrollBehavior = html.style.scrollBehavior;
    const header = document.querySelector('header');
    const offset = header?.getBoundingClientRect().height ?? 0;
    html.style.scrollBehavior = 'auto';
    history.pushState(null, '', `#${id}`);
    window.scrollTo({
      top: Math.round(window.scrollY + section.getBoundingClientRect().top - offset),
      behavior: 'auto',
    });
    window.setTimeout(() => {
      html.style.scrollBehavior = previousScrollBehavior;
    }, 0);
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const sectionLink = target.closest<HTMLAnchorElement>('[data-section-jump]');
    if (sectionLink) {
      const id = sectionLink.dataset.sectionJump;
      if (id) {
        event.preventDefault();
        jumpToSection(id);
        return;
      }
    }

    const link = target.closest<HTMLAnchorElement>('[data-install-mode]');
    if (link) {
      const mode = link.dataset.installMode;
      if (!mode) return;
      event.preventDefault();
      sessionStorage.setItem('install-mode', mode);

      jumpToSection('install');

      window.setTimeout(() => {
        window.dispatchEvent(new CustomEvent('strata:install-mode-request', { detail: { mode } }));
      }, 0);
    }
  });
</script>
