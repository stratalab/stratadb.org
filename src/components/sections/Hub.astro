---
// Section 6: Strata Hub as the dataset distribution story, not an install
// afterthought. Hub answers the cold-start question: where does useful data
// come from before an experiment starts?
import SectionRule from '../foundation/SectionRule.astro';
import Heading from '../foundation/Heading.astro';
import Eyebrow from '../foundation/Eyebrow.astro';
import CopyChip from '../foundation/CopyChip.astro';

const datasets = [
  {
    name: 'movielens-100k',
    use: 'recommendation',
    includes: 'ratings · metadata · vectors',
    selected: true,
  },
  {
    name: 'agent-memory-with-experiments',
    use: 'agent memory',
    includes: 'episodes · events · branches',
  },
  {
    name: 'stackoverflow',
    use: 'Q&A retrieval',
    includes: 'posts · tags · users',
  },
  {
    name: 'github-events',
    use: 'event stream',
    includes: 'issues · PRs · rollups',
  },
];

const categories = ['rag', 'agents', 'benchmarks', 'events', 'reference'];

const cloneFacts = ['schema', 'examples', 'branches', 'history'];
---

<section id="hub" class="relative min-h-[100svh] scroll-mt-16 overflow-hidden" data-hub-section>
  <SectionRule label="STRATA HUB" index="06" />
  <div class="hub-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hub-light hub-light-ember"></div>
    <div class="hub-light hub-light-cool"></div>
    <div class="hub-grid-lines"></div>
  </div>

  <div
    class="relative mx-auto grid min-h-[calc(100svh-1.625rem)] w-full max-w-[88rem] overflow-x-clip px-6 py-20 max-[480px]:px-4 lg:grid-cols-[minmax(20rem,0.36fr)_minmax(0,1fr)] lg:items-start lg:gap-14 xl:gap-16"
  >
    <div class="reveal max-w-[43rem] lg:max-w-none">
      <Eyebrow
        data-feature-eyebrow="strata-hub"
        class="mb-4 font-mono !font-normal !text-terracotta-400"
      >
        Strata Hub
      </Eyebrow>
      <Heading size="title">Clone the dataset your experiment needs.</Heading>
      <p class="mt-6 text-body-lg text-ink-mid">
        Hub lists cloneable Strata databases for RAG, agents, benchmarks, events, and reference
        data. Clone one, open it locally, and keep using the same Strata commands.
      </p>
      <a href="/hub" class="hub-primary-link mt-8 inline-flex items-center gap-2">
        Browse Strata Hub
      </a>
    </div>

    <div class="reveal hub-artifact mt-14 min-w-0 lg:mt-0" data-hub-artifact>
      <div class="hub-window-bar">
        <div class="flex min-w-0 items-center gap-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-terracotta-500/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-low/35"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-low/35"></span>
          <span class="min-w-0 truncate font-mono text-mono-sm text-ink-mid">
            stratahub/catalog
          </span>
        </div>
        <span class="shrink-0 font-mono text-mono-sm text-terracotta-400"> clone-ready </span>
      </div>

      <div class="hub-window-body">
        <div class="hub-search-row">
          <div class="hub-search">
            <span class="text-ink-low">search</span>
            <span class="text-ink-hi">retrieval experiment</span>
          </div>
          <div class="hub-category-strip" aria-label="Example dataset categories">
            {categories.map((category) => <span>{category}</span>)}
          </div>
        </div>

        <div class="hub-stage">
          <div class="hub-results" aria-label="Example prepared datasets">
            {
              datasets.map((dataset) => (
                <article class:list={['hub-row', dataset.selected && 'is-selected']}>
                  <div class="flex min-w-0 items-baseline justify-between gap-4">
                    <h3 class="min-w-0 truncate font-mono text-mono-body text-ink-hi">
                      {dataset.name}
                    </h3>
                    <span class="hub-use">{dataset.use}</span>
                  </div>
                  <p class="hub-includes">{dataset.includes}</p>
                </article>
              ))
            }
          </div>

          <div class="hub-clone-bar" aria-label="Clone workflow">
            <div class="hub-selected">
              <p class="font-mono text-mono-sm uppercase text-ink-low">selected dataset</p>
              <h3 class="mt-2 font-mono text-mono-body text-ink-hi">movielens-100k</h3>
            </div>

            <CopyChip
              value="strata clone movielens-100k ./ml"
              class="w-full justify-between !gap-2 !bg-inset !px-3 [&_.copy-chip-label]:!text-ink-hi"
            />

            <div class="hub-ready">
              <p class="font-mono text-mono-sm text-ok">resolved · verified · local file ready</p>
              <p class="hub-facts" aria-label="Included database assets">
                {cloneFacts.map((fact) => <span>{fact}</span>)}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hub-backdrop {
    background:
      radial-gradient(46% 58% at 76% 50%, rgb(var(--rgb-terracotta-500) / 0.12), transparent 70%),
      radial-gradient(38% 52% at 30% 24%, rgb(var(--rgb-strata-kv) / 0.1), transparent 70%);
  }
  .hub-light {
    position: absolute;
    border-radius: 999px;
    filter: blur(4px);
  }
  .hub-light-ember {
    right: -10%;
    top: 18%;
    width: 44rem;
    height: 28rem;
    background: radial-gradient(circle, rgb(var(--rgb-terracotta-500) / 0.1), transparent 64%);
  }
  .hub-light-cool {
    left: -14%;
    bottom: 4%;
    width: 36rem;
    height: 24rem;
    background: radial-gradient(circle, rgb(var(--rgb-strata-kv) / 0.1), transparent 65%);
  }
  .hub-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(var(--rgb-white) / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--rgb-white) / 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at 70% 50%, black, transparent 72%);
  }
  .hub-artifact {
    overflow: hidden;
    border: 1px solid rgb(var(--rgb-terracotta-500) / 0.22);
    border-radius: var(--radius-frame);
    background: var(--color-panel);
    box-shadow:
      var(--shadow-float),
      0 0 110px -34px rgb(var(--rgb-terracotta-500) / 0.42);
  }
  .hub-primary-link {
    border: 1px solid rgb(var(--rgb-terracotta-500) / 0.5);
    border-radius: var(--radius-control);
    background: var(--color-terracotta-500);
    box-shadow: 0 14px 34px -20px rgb(var(--rgb-terracotta-500) / 0.7);
    padding: 0.78rem 1rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-terracotta-950);
    transition:
      transform var(--dur-1) ease,
      background var(--dur-1) ease,
      border-color var(--dur-1) ease,
      box-shadow var(--dur-1) ease;
  }
  .hub-primary-link:hover,
  .hub-primary-link:focus-visible {
    border-color: rgb(var(--rgb-terracotta-400) / 0.72);
    background: var(--color-terracotta-400);
    box-shadow: 0 18px 42px -22px rgb(var(--rgb-terracotta-500) / 0.85);
    transform: translateY(-1px);
  }
  .hub-primary-link:focus-visible {
    outline: 2px solid var(--color-terracotta-300);
    outline-offset: 3px;
  }
  .hub-window-bar {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(var(--rgb-terracotta-500) / 0.14);
    background: rgb(var(--rgb-terracotta-500) / 0.04);
    padding: 0.75rem 1rem;
  }
  .hub-window-body {
    background:
      radial-gradient(circle at 1px 1px, rgb(var(--rgb-white) / 0.04) 1px, transparent 1.6px),
      linear-gradient(180deg, rgb(var(--rgb-terracotta-500) / 0.03), transparent 38%),
      var(--color-inset);
    background-size:
      22px 22px,
      100% 100%,
      100% 100%;
    padding: 1rem;
  }
  .hub-search-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }
  .hub-search {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--color-vscode-border);
    border-radius: var(--radius-control);
    background: var(--color-vscode-input);
    padding: 0.65rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm--line-height);
  }
  .hub-category-strip {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.125rem;
  }
  .hub-category-strip span {
    flex: none;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgb(var(--rgb-white) / 0.035);
    padding: 0.325rem 0.575rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm--line-height);
    color: var(--color-ink-mid);
  }
  .hub-stage {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .hub-results {
    min-width: 0;
    overflow: hidden;
    align-self: start;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: rgb(var(--rgb-black) / 0.18);
  }
  .hub-row {
    display: grid;
    gap: 0.4rem;
    min-height: 4.15rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.875rem;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .hub-row:last-child {
    border-bottom: 0;
  }
  .hub-row.is-selected {
    background: rgb(var(--rgb-terracotta-500) / 0.07);
    box-shadow: inset 2px 0 0 var(--color-terracotta-500);
  }
  .hub-row:hover {
    background: rgb(var(--rgb-terracotta-500) / 0.055);
    transform: translateX(2px);
  }
  .hub-use,
  .hub-includes {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm--line-height);
  }
  .hub-use {
    flex: none;
    color: var(--color-terracotta-400);
  }
  .hub-includes {
    color: var(--color-ink-low);
  }
  .hub-clone-bar {
    display: grid;
    min-width: 0;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-panel) 76%, transparent);
    padding: 1rem;
  }
  .hub-selected,
  .hub-ready {
    min-width: 0;
  }
  .hub-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin-top: 0.45rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm--line-height);
    color: var(--color-ink-low);
  }
  .hub-facts span:not(:last-child)::after {
    content: '·';
    margin-left: 0.6rem;
    color: var(--color-ink-low);
  }
  @media (min-width: 1180px) {
    .hub-clone-bar {
      grid-template-columns: minmax(11rem, 0.42fr) minmax(19rem, 0.58fr) minmax(16rem, 0.52fr);
    }
  }
  @media (max-width: 640px) {
    .hub-search-row {
      grid-template-columns: 1fr;
    }
    .hub-window-body {
      padding: 0.75rem;
    }
    .hub-row {
      padding: 0.875rem;
    }
    .hub-clone-bar {
      gap: 0.875rem;
    }
  }
  html[data-motion='reduced'] .hub-row {
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  html[data-motion='reduced'] .hub-row:hover {
    transform: none;
  }
</style>
