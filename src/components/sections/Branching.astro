---
// Section 2 (04 §3 v5): the head rides the pin — H2/intro render inside the
// pinned screen so they stay at the top while the scrub plays. The whole
// section lives in the island; this wrapper provides the anchor and the
// section rule.
import SectionRule from '../foundation/SectionRule.astro';
import BranchScrub from './branch/BranchScrub.tsx';
---

<section id="branch" class="relative min-h-[100svh] scroll-mt-16">
  <SectionRule label="BRANCHES" index="02" sticky />
  <BranchScrub client:visible />
</section>
