---
// Section 5 (04 §6 v3): "AI is built-in" The section now shows
// native inference as database work: inspect a model, gather records, embed,
// rank, and generate without adding a separate AI service layer. The copy and
// demo share one centered scroll-owned chapter frame.
import SectionRule from '../foundation/SectionRule.astro';
import Heading from '../foundation/Heading.astro';
import Eyebrow from '../foundation/Eyebrow.astro';
import InferenceDemo from './inference/InferenceDemo.tsx';

const capabilities = ['embed', 'rank', 'generate', 'tokenize', 'model checks'];
---

<section id="inference" class="relative min-h-[100svh] scroll-mt-16 lg:h-[180svh]">
  <SectionRule label="NATIVE INFERENCE" index="05" sticky />
  <div
    class="relative mx-auto grid min-h-[calc(100svh-1.625rem)] w-full max-w-[88rem] overflow-x-clip px-6 py-20 max-[480px]:px-4 lg:sticky lg:top-[calc(4rem+1.625rem)] lg:h-[calc(100svh-5.625rem)] lg:min-h-0 lg:grid-cols-[minmax(17rem,0.28fr)_minmax(0,1fr)] lg:items-center lg:gap-10 lg:py-0 xl:grid-cols-[minmax(19rem,0.35fr)_minmax(0,1fr)] xl:gap-16"
  >
    <div class="reveal max-w-[44rem] lg:max-w-none">
      <Eyebrow
        data-feature-eyebrow="inference"
        class="mb-4 font-mono !font-normal !text-terracotta-400"
      >
        Inference
      </Eyebrow>
      <Heading size="title">AI is built-in</Heading>
      <p class="mt-6 text-body-lg text-ink-mid">
        Run model work where the data already lives. Strata can embed text from records, rank
        context, generate answers, tokenize text, and inspect model capability through one layer
        that works with local models or hosted providers.
      </p>
      <div class="mt-8 flex flex-wrap gap-2.5">
        {
          capabilities.map((p) => (
            <span class="rounded-full border border-line bg-panel px-3.5 py-1.5 font-mono text-mono-sm text-ink-mid">
              {p}
            </span>
          ))
        }
      </div>
    </div>

    <div class="relative mt-14 min-w-0 lg:mt-0">
      <!-- one quiet stage light, the page's temperature -->
      <div
        class="pointer-events-none absolute -inset-x-16 -inset-y-10"
        style="background: radial-gradient(46% 60% at 50% 45%, rgb(var(--rgb-terracotta-500) / 0.09), transparent 70%);"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <InferenceDemo client:visible />
      </div>
    </div>
  </div>
</section>
