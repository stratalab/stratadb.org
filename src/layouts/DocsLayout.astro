---
// The reading shell for a documentation page: sidebar, article, and the
// on-this-page rail. Restored ahead of the content so the page shape can be
// judged before any page is ported back.
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/chrome/DocsSidebar.astro';
import DocsSearch from '../components/chrome/DocsSearch.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  /** Sidebar section to open for this page. */
  section?: string;
  /** The same page as CommonMark. Advertised to crawlers and shown at the foot. */
  mdHref?: string;
  /** Skip the prose wrapper and reading measure, for pages that lay themselves out. */
  bare?: boolean;
  /** A wider measure, for pages that are mostly tables and code rather than prose. */
  wide?: boolean;
  headings?: Heading[];
  /** Explicit rail entries, for pages that build their own headings. */
  toc?: Heading[];
}
const {
  title,
  description,
  section,
  mdHref,
  bare = false,
  wide = false,
  headings = [],
  toc: explicitToc,
} = Astro.props;

const toc = explicitToc ?? headings.filter((h) => h.depth === 2 || h.depth === 3);
// The centred group is exactly as wide as what it holds: the reading column,
// the rail when there is one, and the 2rem gutters either side.
const showToc = toc.length >= 2;
const groupWidth = bare
  ? 'max-w-[76rem]'
  : wide
    ? showToc
      ? 'max-w-[88rem]'
      : 'max-w-[72rem]'
    : showToc
      ? 'max-w-[66rem]'
      : 'max-w-[50rem]';
---

<BaseLayout title={`${title} | StrataDB Docs`} description={description}>
  {
    mdHref && (
      <link
        slot="head"
        rel="alternate"
        type="text/markdown"
        href={mdHref}
        title={`${title} as markdown`}
      />
    )
  }
  {
    /*
    Two different alignments, which is what the reference sites do. Measured on
    docs.databricks.com at 2560px: the sidebar sits flush at x=0 against the
    left edge, and the article plus its rail are centred in the space left over
    beside it, with empty margin on both sides of that group.

    So the sidebar pins left and carries its own inset, and the group centres
    inside the remaining column. Its width is the reading measure plus the rail,
    never the viewport, so the empty space grows and the content does not.
  */
  }
  <div class="w-full py-12">
    <div class="flex">
      <DocsSidebar open={section} />

      <div class="min-w-0 flex-1">
        <div class:list={['mx-auto flex w-full gap-12 px-8 max-[480px]:px-4', groupWidth]}>
          <div class="min-w-0 flex-1">
            <button
              type="button"
              class="docs-search-trigger mb-8 flex w-full items-center gap-2 rounded-(--radius-control) border border-line-hover bg-raised px-3 py-2.5 text-small text-ink-mid lg:hidden"
              aria-label="Search the documentation"
            >
              <span>Search docs</span>
            </button>

            <article class="min-w-0" data-pagefind-body data-pagefind-meta={`title:${title}`}>
              {
                bare ? (
                  <slot />
                ) : (
                  <div
                    class:list={['prose-docs', wide ? 'prose-wide max-w-[68rem]' : 'max-w-[46rem]']}
                  >
                    <slot />
                  </div>
                )
              }
            </article>

            {
              mdHref && (
                <p class="mt-12 max-w-[46rem] border-t border-line pt-6 font-mono text-mono-sm text-ink-low">
                  agents: this page as markdown &rarr;{' '}
                  <a
                    href={mdHref}
                    class="text-ink-mid transition-colors duration-200 hover:text-ink-hi"
                  >
                    {mdHref}
                  </a>
                </p>
              )
            }
          </div>

          {
            showToc && (
              <nav class="hidden w-52 shrink-0 xl:block" aria-label="On this page">
                <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
                  <h2 class="mb-2.5 text-small font-medium uppercase text-ink-mid">On this page</h2>
                  <ul class="space-y-px border-l border-line">
                    {toc.map((h) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class:list={[
                            '-ml-px block border-l-2 border-transparent py-1 text-small text-ink-mid transition-colors duration-200 hover:text-ink-hi',
                            h.depth === 3 ? 'pl-7' : 'pl-4',
                          ]}
                        >
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </div>
  <DocsSearch />
</BaseLayout>

<script>
  // A copy button on every code block in the reading column, so a reader or an
  // agent can lift a line without selecting it. Prompts are stripped: copying
  // `$ strata ...` or `>>> db.json.set(...)` should give the runnable command,
  // not the shell decoration around it.
  const RUNNABLE = /^\s*(?:\$ |>>> |\.\.\. )/;

  function runnableText(pre: HTMLElement): string {
    const raw = pre.innerText.replace(/\n$/, '');
    const lines = raw.split('\n');
    return lines.some((line) => RUNNABLE.test(line))
      ? lines
          .filter((line) => RUNNABLE.test(line))
          .map((line) => line.replace(RUNNABLE, ''))
          .join('\n')
      : raw;
  }

  document.querySelectorAll<HTMLPreElement>('article pre').forEach((pre) => {
    if (pre.dataset.copyReady) return;
    pre.dataset.copyReady = 'true';

    const wrapper = document.createElement('div');
    wrapper.className = 'group/code relative';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className =
      'absolute right-2.5 top-2.5 rounded-(--radius-control) border border-line bg-raised px-2.5 py-1 font-mono text-mono-sm text-ink-mid opacity-0 transition-opacity duration-200 hover:border-terracotta-500 hover:text-ink-hi focus-visible:opacity-100 group-hover/code:opacity-100';
    button.textContent = 'copy';
    button.setAttribute('aria-label', 'Copy this code');

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(runnableText(pre));
        button.textContent = 'copied';
        setTimeout(() => {
          button.textContent = 'copy';
        }, 1500);
      } catch {
        /* clipboard unavailable (permissions or an insecure context) */
      }
    });

    wrapper.appendChild(button);
  });
</script>
