{
  "name": "stratadb.org",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run typecheck && npm run verify:source && astro build && npm run verify:links && npm run verify:transcripts",
    "check": "npm run format:check && npm run lint && npm run build && npm run visual:smoke && npm run audit:runtime",
    "typecheck": "astro check",
    "format": "prettier --write \"*.{js,json,md,mjs}\" \".github/**/*.yml\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,ts,tsx,json}\"",
    "format:check": "prettier --check \"*.{js,json,md,mjs}\" \".github/**/*.yml\" \"scripts/**/*.mjs\" \"src/**/*.{astro,css,ts,tsx,json}\"",
    "lint": "eslint . && npm run verify:source-hygiene",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "setup:browsers": "playwright install chromium",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "verify:source": "npm run verify:versions && npm run verify:commands && npm run verify:errors && npm run verify:demos && npm run verify:docs-copy && npm run verify:reference-ia && npm run verify:source-hygiene",
    "verify:source-hygiene": "node scripts/verify-source-hygiene.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:commands": "node scripts/verify-commands.mjs",
    "verify:errors": "node scripts/verify-errors.mjs",
    "verify:demos": "node scripts/verify-demos.mjs",
    "verify:docs-copy": "node scripts/verify-docs-copy.mjs",
    "verify:reference-ia": "node scripts/verify-reference-ia.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:transcripts": "node scripts/verify-transcripts.mjs",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node scripts/fetch-release.mjs && node scripts/fetch-docs.mjs && node scripts/fetch-wasm.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.68.0",
    "astro": "^7.2.9",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "motion": "^13.1.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
